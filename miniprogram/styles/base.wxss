/* 基础层：页面底色、字号阶梯、标题与排版工具类
   只放"所有页面都成立"的规则，不放任何具体组件 */

/* ============================================================
   兔兔小窝 · 设计基座
   纸感奶油底 + 樱花粉主色 + 手账圆角；字号、间距、触控尺寸统一在这里定
   ============================================================ */

page {
  background: #fff9f0;
  color: #6b5b73;
  font-family: "YouYuan", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.65;
}

/* 4% 纸纹：整页一层，不参与布局 */
page::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -1;
  opacity: .12;
  background-image: radial-gradient(#a9928c 1rpx, transparent 1rpx);
  background-size: 13rpx 15rpx;
}

view, scroll-view, button, input, textarea, image { box-sizing: border-box; }

/* ---------- 按钮复位 ---------- */
button {
  margin: 0;
  padding: 0;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.6;
  color: #6b5b73;
  background: transparent;
  border-radius: 30rpx;
}
button::after { border: 0; }
button[disabled] { opacity: .42; }

image { display: block; }
input, textarea { color: #6b5b73; font-family: inherit; }

/* ---------- 页面骨架 ---------- */
.page {
  padding: 10rpx 30rpx calc(186rpx + env(safe-area-inset-bottom));
  animation: page-in .34s cubic-bezier(.22,.9,.3,1) both;
}

/* ---------- 标题 ---------- */
.title {
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.45;
  transform: rotate(-2deg);
}
.title-line {
  width: 268rpx;
  height: 12rpx;
  margin: -10rpx 0 22rpx;
  background: #c9e7d3;
  border-radius: 50%;
  transform: rotate(-3deg);
}
.subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #806c7b;
}
.section-title {
  margin: 14rpx 0;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 3rpx;
  line-height: 1.5;
}
.tiny { font-size: 22rpx; line-height: 1.7; color: #806c7b; }
.muted { font-size: 24rpx; line-height: 1.75; color: #806c7b; }
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
