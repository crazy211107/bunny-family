.diary-page{padding-bottom:180rpx}.page-heading{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-bottom:28rpx}.page-heading .title{font-size:45rpx}.page-heading>.button{white-space:nowrap;flex-shrink:0}.room-switch{gap:14rpx;margin-bottom:24rpx}.room-button,.pet-pill,.picker-pill{border:1rpx dashed #ccb7c3;background:#fffaf2;color:#705d71;border-radius:18rpx;padding:15rpx 22rpx;font-size:24rpx;line-height:1.5;margin:0}.room-button.active,.pet-pill.active{background:#c9e7d3;border-color:#9bbba5}.filters{padding:24rpx}.filter-row{display:flex;align-items:center;gap:12rpx;flex-wrap:wrap;margin-top:18rpx}.picker-pill{background:#fff5e4}.small-clear{display:inline-flex;color:#a56885;background:transparent;font-size:22rpx;padding:5rpx 10rpx;line-height:1.6;margin:0}.result-line{font-size:23rpx;color:#9b8494;margin:26rpx 0}.story-card{position:relative;padding:30rpx;margin-bottom:30rpx;border-radius:13rpx;transform:rotate(-.3deg)}.story-card:nth-child(even){transform:rotate(.3deg)}.story-meta{display:flex;justify-content:space-between;gap:12rpx;color:#a38b99;font-size:22rpx}.story-mood{color:#ac718d}.story-title{font-size:33rpx;font-weight:600;color:#6b5b73;margin:20rpx 0 12rpx}.story-body{font-size:26rpx;line-height:1.9;color:#8a7586;white-space:pre-wrap;word-break:break-all}.story-photo-row{display:flex;gap:12rpx;margin:22rpx 0}.story-thumb{width:120rpx;height:130rpx;border:7rpx solid #fff;box-shadow:0 5rpx 14rpx #6b5b7312}.story-tags{display:flex;gap:10rpx;flex-wrap:wrap;margin-top:20rpx}.story-tags .tag{font-size:21rpx}.story-actions{display:flex;justify-content:flex-end;gap:12rpx;border-top:1rpx dashed #e5d9dd;margin-top:22rpx;padding-top:14rpx}.text-action{font-size:22rpx;line-height:1.5;padding:9rpx 2rpx;background:transparent;color:#a15f80;margin:0}.story-actions>.text-action:first-child{margin-right:auto}.diary-sheet{max-height:88vh;display:flex;flex-direction:column}.sheet-scroll{height:70vh;box-sizing:border-box}.detail-date{font-size:24rpx;color:#a78498;margin:16rpx 0}.detail-title{font-size:42rpx;line-height:1.55;font-weight:600;margin-bottom:22rpx}.detail-body{font-size:28rpx;line-height:1.95;white-space:pre-wrap;word-break:break-all}.detail-photo-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx;margin-top:28rpx}.detail-photo-grid image{width:100%;height:280rpx;border-radius:8rpx}.editor-quote{font-size:27rpx;line-height:1.9;color:#ad7d95;background:#fff2e5;border-radius:8rpx;padding:26rpx;margin:18rpx 0 28rpx}.diary-textarea{height:240rpx}.photo-choice-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;margin-top:18rpx}.photo-choice{position:relative;border:3rpx solid transparent;border-radius:8rpx;overflow:hidden;height:132rpx}.photo-choice.selected{border-color:#b87898}.photo-choice image{width:100%;height:100%}.choice-mark{position:absolute;right:6rpx;top:6rpx;width:32rpx;height:32rpx;line-height:32rpx;text-align:center;background:#fff9f0d9;color:#9a5f7d;border-radius:50%;font-size:23rpx}.hidden-photo-note{font-size:23rpx;line-height:1.8;margin-top:15rpx}.diary-sheet .save-btn{margin-top:30rpx;margin-bottom:40rpx}.field .filter-row{margin-top:0}

.diary-sheet,.album-sheet{height:100%;max-height:100%}.diary-sheet .drawer-head,.album-sheet .drawer-head{flex-shrink:0}.diary-sheet .drawer-head .section-title,.album-sheet .drawer-head .section-title{margin:0;font-size:33rpx}.sheet-scroll{height:calc(100vh - 170rpx);min-height:0;padding:24rpx 38rpx 90rpx;box-sizing:border-box}


.filter-row{display:flex;flex-wrap:wrap;align-items:center;gap:12rpx;margin-top:16rpx}
.pet-pill{flex:0 0 auto;min-height:64rpx;display:flex;align-items:center;justify-content:center;padding:0 24rpx;font-size:24rpx;color:#8d7386;background:#fffaf2;border:1rpx solid #dcc7d2;border-radius:30rpx 36rpx 28rpx 34rpx}
.pet-pill.active{color:#6b5b73;background:#ffd9e8;border-color:#c18aa5}
.picker-pill{flex:0 0 auto;min-height:64rpx;display:flex;align-items:center;padding:0 22rpx;font-size:24rpx;background:#fffaf2;border:1rpx dashed #d6c1cd;border-radius:30rpx}
.small-clear{flex:0 0 auto;min-height:64rpx;display:flex;align-items:center;padding:0 18rpx;font-size:22rpx;color:#b87184}
.filters .input{margin-bottom:6rpx}
.result-line{margin:8rpx 0 20rpx}

.page-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:26rpx}
.page-heading>view:first-child{flex:1;min-width:0}
.page-heading .title{font-size:48rpx;line-height:1.4}
.page-heading .subtitle{margin-top:8rpx}
.page-heading .button{flex:0 0 auto;min-height:76rpx;padding:0 26rpx;font-size:24rpx;box-shadow:0 4rpx 0 #6b5b7310}

/* 故事卡：统一到档案册的纸质语言 */
.story-card{padding:28rpx 28rpx 20rpx;border-radius:32rpx 46rpx 28rpx 40rpx}
.story-meta{display:flex;align-items:center;justify-content:space-between;gap:12rpx;font-size:20rpx;color:#b39daa;letter-spacing:1rpx}
.story-mood{display:inline-flex;align-items:center;gap:6rpx;padding:5rpx 16rpx;font-size:21rpx;color:#6b5b73;background:#ffe9a8;border-radius:14rpx 19rpx 13rpx 17rpx;transform:rotate(-2deg)}
.story-title{margin:16rpx 0 8rpx;font-size:32rpx;letter-spacing:1rpx;color:#6b5b73;line-height:1.45}
.story-body{font-size:25rpx;line-height:1.9;color:#8d7386;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.story-photo-row{display:flex;gap:12rpx;margin-top:16rpx}
.story-thumb{width:148rpx;height:148rpx;border-radius:14rpx 20rpx 12rpx 18rpx;border:1rpx solid #eadde4}
.story-tags{margin-top:14rpx}
.story-actions{display:flex;align-items:center;gap:8rpx;margin-top:16rpx;padding-top:12rpx;border-top:1rpx dashed #eddfe6}
.story-actions .text-action{min-height:58rpx;display:flex;align-items:center;padding:0 12rpx;font-size:22rpx;color:#a8607f}
.story-actions .text-action.muted{color:#b39daa}

.mood-panel{padding:22rpx 24rpx 16rpx;margin:6rpx 0 18rpx;background:#fffcf5;border:1rpx solid #e2d1da;border-radius:26rpx 38rpx 22rpx 34rpx}
.mood-panel-title{display:block;margin-bottom:14rpx;font-size:24rpx;letter-spacing:2rpx;color:#8d7386}
.mood-row{display:flex;align-items:center;gap:14rpx;margin-bottom:12rpx}
.mood-label{width:150rpx;font-size:22rpx;color:#7d6478;flex:0 0 auto}
.mood-track{flex:1;height:14rpx;background:#f3e6ec;border-radius:7rpx;overflow:hidden}
.mood-fill{height:100%;background:linear-gradient(90deg,#ffd9e8,#c9e7d3);border-radius:7rpx}
.mood-count{width:48rpx;text-align:right;font-size:21rpx;color:#b39daa}

/* 草稿信封与书签：每个装饰都对应可操作的整理功能。 */
.draft-envelope{display:flex;align-items:center;gap:18rpx;padding:22rpx 24rpx;margin-bottom:26rpx;background:#fff0e1;border:1rpx dashed #d8bca9;border-radius:16rpx 28rpx 20rpx 24rpx;box-shadow:0 6rpx 0 #e9d8c844}
.draft-envelope-mark{flex-shrink:0;font-size:48rpx;color:#a98187;transform:rotate(-8deg)}
.draft-envelope-copy{flex:1;min-width:0}
.draft-envelope-label{font-size:20rpx;color:#a4828d;letter-spacing:2rpx}
.draft-envelope-title{font-size:27rpx;color:#6b5b73;margin-top:4rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.draft-envelope-copy>text{display:block;font-size:19rpx;color:#ab929d;line-height:1.6;margin-top:5rpx}
.draft-envelope-actions{display:flex;flex-direction:column;flex-shrink:0}
.draft-envelope-actions .text-action{min-height:60rpx;display:flex;align-items:center;padding:0 8rpx}
.draft-envelope-actions .muted{color:#aa919d}
.tag-index{margin:24rpx 0 22rpx;padding-bottom:8rpx}
.tag-index-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx;font-size:23rpx;color:#987c90;min-height:52rpx;margin-bottom:14rpx}
.tag-cloud{width:100%;white-space:nowrap}
.tag-chip{display:inline-flex;align-items:center;min-height:60rpx;box-sizing:border-box;padding:8rpx 22rpx;margin-right:12rpx;font-size:24rpx;background:#fff2f6;border:1rpx solid #e7cad6;border-radius:20rpx 28rpx 18rpx 26rpx;color:#8b687e;vertical-align:middle}
.tag-chip>text{font-size:18rpx;color:#b291a6;margin-left:12rpx}
.tag-chip.active{background:#c9e7d3;border-color:#a7c5b0;color:#6b5b73}
.story-pinned{border-color:#c8a26f;background:#fffcf3}
.story-pinned .story-meta{padding-right:100rpx}
.pin-bookmark{position:absolute;right:26rpx;top:0;padding:12rpx 15rpx 18rpx;background:#ffe9a8;border-radius:0 0 12rpx 12rpx;color:#a37d4d;font-size:19rpx;letter-spacing:1rpx}
.story-tags .tag-tappable{min-height:52rpx;display:inline-flex;align-items:center;padding:4rpx 16rpx;box-sizing:border-box}
.story-actions{flex-wrap:wrap;justify-content:flex-end}
.story-actions>.text-action:first-child{margin-right:0}
.story-actions .pin-action{color:#a37d4d;background:#fff4d6;border-radius:16rpx;padding:0 14rpx}
.draft-status{display:flex;align-items:center;justify-content:space-between;gap:14rpx;min-height:64rpx;margin-bottom:12rpx;font-size:21rpx;color:#9c7f91}
.draft-status>text{flex:1;line-height:1.7}
.draft-status>.text-action{flex-shrink:0;min-height:64rpx;display:flex;align-items:center;padding:0 4rpx}

.page-heading{margin-bottom:18rpx;gap:16rpx}
.page-heading .title{font-size:44rpx}
.page-heading .button,.empty-actions .button{min-height:88rpx}
.room-switch{margin-bottom:18rpx}
.room-button,.pet-pill,.picker-pill,.small-clear,.tag-chip{min-height:72rpx}
.filters{padding:18rpx}
.filter-row{margin-top:12rpx;gap:10rpx}
.draft-envelope{padding:16rpx 20rpx;margin-bottom:20rpx}
.draft-envelope-actions .text-action,.tag-index-head .small-clear,.draft-status>.text-action{min-height:72rpx}
.tag-index{margin:14rpx 0 16rpx}
.tag-index-head{margin-bottom:8rpx}
.story-card{padding:24rpx 24rpx 14rpx;margin-bottom:22rpx}
.story-title{margin-top:12rpx;font-size:31rpx}
.story-body{color:#806b7c}
.story-photo-row{margin:14rpx 0}
.story-thumb{width:130rpx;height:130rpx}
.story-actions{gap:8rpx;flex-wrap:nowrap;margin-top:12rpx;padding-top:8rpx}
.story-actions .text-action{min-height:72rpx;flex:1;justify-content:center;padding:0 4rpx;white-space:nowrap}
.story-actions .text-action.muted{color:#897184}
.story-tags .tag-tappable{min-height:72rpx}
.story-meta,.draft-envelope-copy>text,.result-line,.tag-index-head,.draft-status{color:#897184}
.tag-chip>text{color:#806b7c}
.empty-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:16rpx;margin:12rpx 0 24rpx}
.empty-actions .button{margin:0;font-size:24rpx;padding:0 24rpx}
.control-pressed{opacity:.7;transform:scale(.98)}
@media (max-width:350px){.page-heading .title{font-size:40rpx}.story-actions .text-action{font-size:21rpx}.draft-envelope-mark{display:none}.story-thumb{width:120rpx;height:120rpx}}
@media (min-width:600px){.story-photo-row{gap:16rpx}.story-thumb{width:150rpx;height:150rpx}.story-card{padding:26rpx 30rpx 16rpx}}
@media (prefers-reduced-motion:reduce){.story-card,.pin-bookmark{transform:none}}

.story-meta,.mood-count,.draft-envelope-label,.draft-envelope-copy>text,.draft-envelope-actions .muted,.tag-index-head,.tag-chip>text,.draft-status{color:#806c7b;font-size:22rpx}.story-actions .text-action,.story-actions .text-action.muted{color:#875873}.diary-sheet .close{width:88rpx;height:88rpx;flex-shrink:0}.tag-tappable{min-height:72rpx;display:inline-flex;align-items:center}.diary-sheet .input{min-height:88rpx}.draft-envelope-actions button{min-height:88rpx}.diary-sheet .field{line-height:1.7}
