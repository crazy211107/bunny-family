<page-top />
<view class="page diary-page">
  <view class="page-heading"><view><view class="title">{{recycle ? '故事回收站' : '一页小手账'}}</view><view class="subtitle">把小日子，写成软乎乎的故事。</view></view><button hover-class="control-pressed" class="button pink" bindtap="openEditor">＋ 记一笔</button></view>
  <view class="draft-envelope" wx:if="{{pendingDraft && !recycle}}"><view class="draft-envelope-mark" aria-hidden="true">✉</view><view class="draft-envelope-copy"><view class="draft-envelope-label">还有一页没写完</view><view class="draft-envelope-title">{{pendingDraft.title}}</view><text>{{pendingDraft.date}} · 自动草稿留在本机</text></view><view class="draft-envelope-actions"><button hover-class="control-pressed" class="text-action" bindtap="restoreDraft">继续写 ↗</button><button hover-class="control-pressed" class="text-action muted" bindtap="discardDraft">丢弃</button></view></view>
  <view class="room-switch row"><button hover-class="control-pressed" class="room-button {{recycle ? '' : 'active'}}" data-room="active" bindtap="switchRoom">手账本</button><button hover-class="control-pressed" class="room-button {{recycle ? 'active' : ''}}" data-room="trash" bindtap="switchRoom">回收站 {{trashCount}}</button></view>
  <view class="paper-card filters">
    <search-bar value="{{query}}" label="搜索手账标题、旁白或标签" placeholder="找找标题、旁白或标签…" bind:change="search" />
    <view class="filter-row"><picker mode="selector" range="{{moodOptions}}" value="{{moodIndex}}" bindchange="changeMood"><view class="picker-pill">{{moodOptions[moodIndex]}} ▾</view></picker><picker mode="date" value="{{dateFilter}}" end="{{today}}" bindchange="changeDate"><view class="picker-pill">{{dateFilter || '选择故事日期'}} ▾</view></picker><button hover-class="control-pressed" wx:if="{{dateFilter}}" class="small-clear" bindtap="clearDate">清除日期</button></view>
    <view class="filter-row"><button hover-class="control-pressed" wx:for="{{petFilters}}" wx:key="id" class="pet-pill {{item.active ? 'active' : ''}}" data-id="{{item.id}}" bindtap="filterPet">{{item.name}}</button></view>
  </view>
  <view class="tag-index" wx:if="{{tagCloud.length}}"><view class="tag-index-head"><text>沿着标签，找一页故事</text><button hover-class="control-pressed" wx:if="{{tagFilter}}" class="small-clear" bindtap="clearTag">查看全部</button></view><scroll-view scroll-x class="tag-cloud" enhanced show-scrollbar="{{false}}"><view wx:for="{{tagCloud}}" wx:key="text" class="tag-chip {{item.active ? 'active' : ''}}" data-tag="{{item.text}}" bindtap="filterTag" aria-role="button" hover-class="control-pressed"># {{item.text}} <text>{{item.count}}</text></view></scroll-view></view>
  <view class="mood-panel" wx:if="{{moodStats.length > 1}}">
    <text class="mood-panel-title">这段时间的心情</text>
    <view class="mood-row" wx:for="{{moodStats}}" wx:key="name">
      <text class="mood-label">{{item.mark}} {{item.name}}</text>
      <view class="mood-track"><view class="mood-fill" style="width:{{item.percent}}%"></view></view>
      <text class="mood-count">{{item.count}}</text>
    </view>
  </view>
  <view class="result-line">翻到了 {{notes.length}} 页小故事<text wx:if="{{tagFilter}}"> · #{{tagFilter}}</text></view>
  <view class="story-card paper-card {{item.pinned ? 'story-pinned' : ''}}" wx:for="{{notes}}" wx:key="id"><view wx:if="{{item.pinned && !recycle}}" class="pin-bookmark">书签 ♡</view>
    <view class="story-meta"><text class="story-mood">{{item.mark}} {{item.mood}}</text><text>{{item.date}}</text></view>
    <view data-id="{{item.id}}" bindtap="showDetail" aria-role="button" hover-class="control-pressed"><view class="story-title">{{item.title}}</view><view class="story-body">{{item.bodyPreview || '这一刻，已经被好好记住。'}}</view><view class="story-photo-row" wx:if="{{item.photos.length}}"><image lazy-load wx:for="{{item.photos}}" wx:key="id" wx:for-item="photo" class="story-thumb" src="{{photo.src}}" mode="aspectFill" /></view></view>
    <view class="story-tags"><text wx:if="{{item.petText}}" class="tag mint">{{item.petText}}</text><text wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag" class="tag tag-tappable" data-tag="{{tag}}" bindtap="filterTag"># {{tag}}</text></view>
    <view class="story-actions"><button hover-class="control-pressed" class="text-action" data-id="{{item.id}}" bindtap="showDetail">展开 ↗</button><block wx:if="{{recycle}}"><button hover-class="control-pressed" class="text-action" data-id="{{item.id}}" data-restore="{{true}}" bindtap="moveNote">找回来 ♡</button></block><block wx:else><button hover-class="control-pressed" class="text-action pin-action" data-id="{{item.id}}" bindtap="togglePin">{{item.pinned ? '取下书签' : '置顶'}}</button><button hover-class="control-pressed" class="text-action" data-id="{{item.id}}" bindtap="openEditor">改旁白</button><button hover-class="control-pressed" class="text-action muted" data-id="{{item.id}}" bindtap="moveNote">收起</button></block></view>
  </view>
    <view class="page-error" wx:if="{{pageError}}">
    <text class="page-error-text">这次没能读到信笺：{{pageError}}。数据还在本机，重试一下。</text>
    <view class="page-error-retry" bindtap="reload" hover-class="page-error-hover" aria-role="button" aria-label="重新读取日记">重试</view>
  </view>
<empty-state wx:if="{{!notes.length && !pageError}}" text="{{recycle ? '回收站空空的，每一页都好好留着。' : '还没有找到这一页，换个筛选或记一个新故事吧。'}}" /><view wx:if="{{!notes.length && !pageError}}" class="empty-actions"><button hover-class="control-pressed" class="button mint" bindtap="resetFilters">{{recycle ? '回手账本' : '清除筛选'}}</button><button hover-class="control-pressed" class="button pink" bindtap="openEditor">＋ 写一页故事</button></view>
</view>
<view class="drawer-mask" style="padding-top:{{safeTop}}px" wx:if="{{detail}}" bindtap="closeDetail"><view class="drawer diary-sheet" style="padding-top:{{safeTop}}px" catchtap="noop"><view class="drawer-head"><view class="section-title">这一页的小故事 ♡</view><button hover-class="control-pressed" aria-label="关闭当前面板" class="close" bindtap="closeDetail">×</button></view><scroll-view class="sheet-scroll" scroll-y><view class="detail-date">{{detail.date}} · {{detail.mark}} {{detail.mood}}</view><view class="detail-title">{{detail.title}}</view><view class="detail-body">{{detail.body || '没有旁白的瞬间，也很珍贵。'}}</view><view class="detail-photo-grid"><image wx:for="{{detail.photos}}" wx:key="id" src="{{item.src}}" mode="aspectFill" data-src="{{item.src}}" bindtap="previewPhoto" /></view><view class="muted hidden-photo-note" wx:if="{{detail.missingPhotoCount}}">有 {{detail.missingPhotoCount}} 张关联照片暂存在相册回收站。</view><view class="story-tags"><text class="tag mint" wx:if="{{detail.petText}}">{{detail.petText}}</text><text wx:for="{{detail.tags}}" wx:key="*this" class="tag tag-tappable" data-tag="{{item}}" bindtap="filterTag"># {{item}}</text></view><button hover-class="control-pressed" wx:if="{{detail.trashedAt}}" class="button mint save-btn" data-id="{{detail.id}}" data-restore="{{true}}" bindtap="moveNote">把这一页找回来 ♡</button><button hover-class="control-pressed" wx:else class="button pink save-btn" data-id="{{detail.id}}" bindtap="openEditor">编辑这一页</button></scroll-view></view></view>
<view class="drawer-mask" style="padding-top:{{safeTop}}px" wx:if="{{editing}}" bindtap="closeEditor"><view class="drawer diary-sheet" style="padding-top:{{safeTop}}px" catchtap="noop"><view class="drawer-head"><view class="section-title">{{draft.id ? '给故事续一点旁白' : '记下今天的小美好'}}</view><button hover-class="control-pressed" aria-label="关闭当前面板" class="close" bindtap="closeEditor">×</button></view><scroll-view class="sheet-scroll" scroll-y><form bindsubmit="save"><view class="feedback" wx:if="{{formError}}">{{formError}}</view><view class="draft-status"><text>{{draftStatus}}</text><button hover-class="control-pressed" wx:if="{{pendingDraft}}" class="text-action" bindtap="discardDraft">丢弃草稿</button></view><view class="editor-quote"><view>小事也值得被记住，</view><view>比如，今天又多喜欢你们一点。</view></view><view class="field">给这一刻起个名字<input class="input" maxlength="60" value="{{draft.title}}" data-field="title" aria-label="手账标题" bindinput="draftInput" placeholder="今天发生了什么可爱的事？" /></view><view class="field">故事发生的日子<picker mode="date" value="{{draft.date}}" end="{{today}}" bindchange="draftDate"><view class="input">{{draft.date}} ▾</view></picker></view><view class="field">今天的心情<picker mode="selector" range="{{editorMoods}}" value="{{draft.moodIndex}}" bindchange="draftMood"><view class="input">{{draft.mood}} ▾</view></picker></view><view class="field">镜头里的小主角<view class="filter-row"><button hover-class="control-pressed" wx:for="{{editorPets}}" wx:key="id" class="pet-pill {{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="togglePet">{{item.selected ? '✓ ' : ''}}{{item.name}}</button></view></view><view class="field">慢慢写下心情旁白<textarea class="textarea diary-textarea" maxlength="1200" value="{{draft.body}}" data-field="body" aria-label="手账正文" bindinput="draftInput" placeholder="兔兔在旁边陪着你。" /></view><view class="field">故事标签<input class="input" maxlength="120" value="{{draft.tagsText}}" data-field="tagsText" aria-label="手账标签" bindinput="draftInput" placeholder="午后，贴贴，胡萝卜 · 最多 6 个" /></view><view class="field">挑几帧配图 · {{draft.photoIds.length}} / 4<view class="photo-choice-grid"><view wx:for="{{photoChoices}}" wx:key="id" class="photo-choice {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="togglePhoto" aria-role="button" hover-class="control-pressed"><image src="{{item.src}}" mode="aspectFill" /><text class="choice-mark">{{item.selected ? '✓' : '＋'}}</text></view></view><view class="muted" wx:if="{{!photoChoices.length}}">先去相册添几张照片，就可以把故事配上画面。</view><view class="hidden-photo-note muted" wx:if="{{missingPhotoCount}}">{{missingPhotoCount}} 张配图暂存在回收站。<button hover-class="control-pressed" class="small-clear" bindtap="clearMissingPhotos">移除这些关联</button></view></view><button hover-class="control-pressed" class="button pink save-btn" form-type="submit">把这一刻收好 ♡</button></form></scroll-view></view></view>
<bunny-menu />

