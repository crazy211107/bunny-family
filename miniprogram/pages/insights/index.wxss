er:1rpx solid #dccbd4;border-radius:22rpx 38rpx 22rpx 32rpx;margin:22rpx 0}.week-identity{display:flex;align-items:center;gap:16rpx;min-width:0;flex:1}.week-identity image{width:82rpx;height:88rpx;border-radius:18rpx;flex:0 0 auto;transform:rotate(-3deg);border:4rpx solid #fff9f0}.pet-name{font-size:28rpx;font-weight:600}.week-identity .muted{font-size:21rpx}.week-count{font-size:28rpx;color:#876d82}.week-marks{display:flex;gap:8rpx;margin:22rpx 0 18rpx}.week-mark{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;gap:8rpx;font-size:20rpx;color:#806b7b}.mark-count{width:100%;height:62rpx;border-radius:12rpx;background:#f2e8df;display:flex;align-items:center;justify-content:center;font-size:22rpx}.mark-1{background:#ffe9e8}.mark-2{background:#ffe9a8}.mark-3{background:#e2eedc}.mark-4{background:#c9e7d3}.future .mark-count{background:transparent;border:1rpx dashed #dac8d1}.weight-note{padding:14rpx 0 0;border-top:1rpx dashed #e5d3dd;font-size:23rpx}.week-memory{margin:30rpx 0}.week-memory .card-head{align-items:flex-start;flex-direction:column;gap:6rpx}.report-frames{display:flex;gap:12rpx;margin-top:20rpx}.report-frames image{width:calc(25% - 9rpx);height:152rpx;border:6rpx solid #fffcf6;box-shadow:0 4rpx 12rpx #6b5b7317;border-radius:5rpx;transform:rotate(-2deg)}.report-frames image:nth-child(even){transform:rotate(3deg)}.report-empty{padding:28rpx 20rpx;display:flex;align-items:center;flex-direction:column;gap:14rpx}.report-empty>text{font-size:23rpx}.handover-intro{position:relative;background:#fff1d4;border:1rpx solid #e8d3a6;padding:26rpx 24rpx 12rpx;border-radius:8rpx 30rpx 16rpx 28rpx;margin:20rpx 0 26rpx;overflow:hidden}.handover-intro .card-title{margin:10rpx 0;line-height:1.6}.envelope-corner{position:absolute;right:-20rpx;top:-20rpx;width:65rpx;height:65rpx;transform:rotate(45deg);background:#e9d5b3}.handover-pet{display:flex;gap:18rpx;margin:20rpx 0 24rpx;align-items:flex-start}.handover-pet>image{width:132rpx;height:166rpx;border:7r