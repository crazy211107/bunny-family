/* Vant Steps / Empty 的流程与行动入口，WeUI 表单的信息层级。 */
.video-page{padding-bottom:calc(190rpx + env(safe-area-inset-bottom))}.page-heading{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-bottom:18rpx}.page-heading>view{min-width:0;flex:1}.page-eyebrow{font-size:20rpx;letter-spacing:2rpx;color:#826e80;margin-bottom:6rpx}.page-heading .title{font-size:43rpx;line-height:1.4;letter-spacing:1rpx;transform:rotate(-1deg)}.page-heading .subtitle{font-size:23rpx;color:#806d7d;margin-top:6rpx}.page-heading>.text-btn{flex-shrink:0;min-height:88rpx;padding:8rpx 12rpx;font-size:23rpx;color:#854d69}.video-workflow{display:flex;align-items:center;justify-content:space-between;gap:8rpx;margin-bottom:18rpx;padding:10rpx 16rpx;background:#fffdf6;border:1rpx solid #ddcbd4;border-radius:22rpx 30rpx 18rpx 26rpx}.workflow-item{display:flex;align-items:center;gap:9rpx;min-width:0;font-size:22rpx;color:#826e80}.workflow-number{display:flex;align-items:center;justify-content:center;width:38rpx;height:38rpx;border-radius:50%;background:#f0e5e9;font-size:21rpx;line-height:1;flex-shrink:0}.workflow-item.current{color:#854d69;font-weight:600}.workflow-item.current .workflow-number{background:#ffd9e8}.workflow-item.complete .workflow-number{background:#c9e7d3;color:#46664c}.workflow-line{color:#8da58a;font-size:24rpx}
.video-preview{padding:20rpx 22rpx;border-radius:28rpx 38rpx 24rpx 34rpx}.video-preview>.tape{display:none}.preview-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:16rpx}.preview-eyebrow{font-size:18rpx;letter-spacing:2rpx;color:#826e80}.preview-badge{font-size:21rpx;color:#854d69;padding:4rpx 12rpx;background:#ffd9e8;border-radius:12rpx 18rpx 10rpx 16rpx;flex-shrink:0}.video-stage{position:relative;background:#f0e6db;border:1rpx solid #d8c4cf;border-radius:10rpx;overflow:hidden}.preview-video{display:block;width:100%;height:370rpx}.video-caption{position:absolute;left:0;right:0;bottom:65rpx;padding:12rpx 20rpx;background:#fff9f0e8;color:#6b5b73;text-align:center;font-size:25rpx;line-height:1.7;white-space:normal;word-break:break-all}.video-empty{padding:28rpx 18rpx;background:#f5ede3;border:1rpx dashed #cdb5c3;border-radius:16rpx}.video-empty .empty-symbol{display:flex;align-items:center;justify-content:center;width:80rpx;height:80rpx;margin:0 auto 12rpx;font-size:38rpx;color:#854d69;background:#ffd9e8;border-radius:26rpx 34rpx 22rpx 30rpx}.video-empty-title{font-size:28rpx;color:#6b5b73}.video-empty-hint{font-size:21rpx;color:#826e80;margin-top:6rpx}.video-empty .button{margin:18rpx auto 0;max-width:350rpx;font-size:25rpx}.preview-meta{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin:14rpx 0 4rpx;font-size:22rpx;color:#806d7d}.video-preview>.text-btn{min-height:88rpx;font-size:24rpx;color:#854d69}.preview-note{margin-top:12rpx;padding:14rpx 16rpx;background:#fff2df;border-left:4rpx solid #dcc583;border-radius:8rpx 16rpx 12rpx 8rpx;font-size:22rpx;line-height:1.75;color:#806d7d}
.video-controls{margin-top:18rpx;padding:22rpx 24rpx}.video-controls>.section-title{font-size:30rpx;font-weight:600;letter-spacing:1rpx;margin:0 0 12rpx}.video-controls .field{margin:18rpx 0}.video-controls .field-label{font-size:24rpx;color:#806d7d;margin-bottom:10rpx}.required-mark{font-size:20rpx;color:#9c4f70;margin-left:8rpx}.input-counter{margin-top:6rpx;font-size:21rpx;color:#826e80;text-align:right}.video-textarea{height:160rpx;font-size:26rpx;line-height:1.8}.filter-options{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12rpx;margin-top:12rpx}.filter-chip{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;min-height:144rpx;min-width:0;padding:12rpx 6rpx;font-size:24rpx;background:#fffaf2;border:1rpx solid #d6c1cd;border-radius:20rpx 27rpx 18rpx 24rpx;line-height:1.4}.filter-swatch{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;background:#fff0c3;border:4rpx solid #fff9f0;border-radius:18rpx 24rpx 16rpx 22rpx;font-size:27rpx;line-height:1;color:#906a51}.filter-1 .filter-swatch{background:#c9e7d3;color:#526f58}.filter-2 .filter-swatch{background:#ffd9e8;color:#925b76}.filter-3 .filter-swatch{background:#d7c3a7;color:#7e624e}.filter-chip.active{background:#fff0f6;border-color:#a46b86;box-shadow:0 3rpx 0 #d9acc033;font-weight:600}.filter-chip:active{transform:scale(.97)}.filter-note{margin-top:14rpx;font-size:24rpx;color:#854d69}.device-note{margin-top:6rpx;font-size:22rpx;line-height:1.8;color:#826e80}.video-controls .save-btn{margin:20rpx 0 12rpx;background:#ffd9e8;border-color:#c18aa5}.video-controls>.tiny{font-size:21rpx;color:#826e80;line-height:1.8}.video-page>.section-title{font-size:30rpx;letter-spacing:1rpx;margin:24rpx 0 16rpx}.draft-count{display:inline-block;font-size:23rpx;color:#854d69;margin-left:8rpx;padding:1rpx 12rpx;background:#ffd9e8;border-radius:14rpx}.draft-row{display:flex;align-items:center;gap:14rpx;padding:18rpx 20rpx;min-height:112rpx;margin-bottom:12rpx;border-radius:22rpx 30rpx 18rpx 26rpx}.draft-symbol{display:flex;align-items:center;justify-content:center;width:64rpx;height:72rpx;flex-shrink:0;background:#ffe9a8;border:1rpx dashed #c6aa6a;border-radius:14rpx;font-size:32rpx;color:#866c40}.draft-copy{flex:1;min-width:0}.draft-title{font-size:26rpx;line-height:1.6;word-break:break-all}.draft-copy .tiny{font-size:21rpx;color:#826e80}.draft-open{font-size:22rpx;color:#854d69;white-space:nowrap}.control-pressed{transform:scale(.98);background:#fff0f6}
@media screen and (max-width:340px){.page-heading{align-items:flex-start;gap:8rpx}.page-heading .title{font-size:39rpx}.page-heading>.text-btn{font-size:22rpx;padding:8rpx}.page-eyebrow{font-size:19rpx;letter-spacing:1rpx}.video-workflow{padding:10rpx 12rpx;gap:5rpx}.workflow-item{gap:5rpx;font-size:21rpx}.workflow-number{width:34rpx;height:34rpx;font-size:20rpx}.filter-options{gap:8rpx}.filter-chip{font-size:22rpx}.draft-row{flex-wrap:wrap}.draft-open{margin-left:auto}.preview-video{height:340rpx}}
