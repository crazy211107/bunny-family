<page-top />
<view class="page album-page">
  <view class="page-heading"><view><view class="title">{{recycle ? '回忆回收站' : '回忆放映室'}}</view><view class="subtitle">{{recycle ? '舍不得的片段，都可以重新找回来。' : '不用特别的日子，特别的是你们。'}}</view></view><button hover-class="control-pressed" class="button pink" loading="{{uploading}}" disabled="{{uploading}}" bindtap="upload">＋ 添照片</button></view>
  <view class="room-switch row"><button hover-class="control-pressed" class="room-button {{recycle ? '' : 'active'}}" data-room="active" bindtap="switchRoom">相册 {{activeCount}}</button><button hover-class="control-pressed" class="room-button {{recycle ? 'active' : ''}}" data-room="trash" bindtap="switchRoom">回收站 {{trashCount}}</button></view>
  <view class="collection-heading" wx:if="{{!recycle}}"><view><text class="collection-kicker">OUR LITTLE COLLECTIONS</text><view class="section-title">给回忆一个小抽屉</view></view><button hover-class="control-pressed" class="text-action" bindtap="openAlbumEditor">＋ 新建主题册</button></view>
  <scroll-view wx:if="{{!recycle}}" class="collection-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="collection-card collection-all {{!albumId ? 'active' : ''}}" data-id="" bindtap="selectAlbum" aria-role="button" hover-class="control-pressed"><view class="collection-cover collection-paper"><text>♡</text><text class="collection-paper-word">ALL OUR DAYS</text></view><view class="collection-name">全部小日子</view><view class="collection-count">{{activeCount}} 帧 · 完整底片</view></view>
    <view wx:for="{{albums}}" wx:key="id" class="collection-card {{item.active ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectAlbum" aria-role="button" hover-class="control-pressed"><view class="collection-cover"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" lazy-load /><view wx:else class="collection-placeholder">等第一帧 ♡</view><text class="collection-ribbon">{{item.count}} FRAMES</text></view><view class="collection-name">{{item.title}}</view><view class="collection-count">{{item.count}} 帧 · 主题收藏</view></view>
  </scroll-view>
  <view class="collection-current" wx:if="{{currentAlbum && !recycle}}"><view class="collection-current-title">正在翻阅 · {{currentAlbum.title}}</view><view class="collection-manage"><button hover-class="control-pressed" class="text-action" data-id="{{currentAlbum.id}}" bindtap="openAlbumEditor">改名字</button><button hover-class="control-pressed" class="text-action" bindtap="deleteAlbum">移除册子</button></view></view>
  <view class="album-filters"><button hover-class="control-pressed" wx:for="{{filters}}" wx:key="id" class="filter-pill {{item.active ? 'active' : ''}}" data-id="{{item.id}}" bindtap="filterPhotos">{{item.name}}</button></view>
  <view class="paper-card album-tools"><search-bar value="{{query}}" label="搜索照片、标签或兔兔名字" placeholder="搜索照片、标签或兔兔名字…" bind:change="search" /><view class="tools-row"><picker mode="selector" range="{{sortOptions}}" value="{{sortIndex}}" bindchange="sortPhotos"><view class="sort-pill">{{sortOptions[sortIndex]}} ▾</view></picker><button hover-class="control-pressed" class="button small" bindtap="toggleSelection">{{selecting ? '退出多选' : '整理相册'}}</button></view></view>
  <view class="result-line"><text>找到 {{photos.length}} 帧{{recycle ? '暂存的' : '小小的'}}回忆</text><view wx:if="{{photos.length && !recycle}}" class="theater-entry" bindtap="openTheater" aria-role="button">▶ 放映</view><button hover-class="control-pressed" wx:if="{{selecting}}" class="text-action" bindtap="selectAll">{{allSelected ? '取消全选' : '全选当前结果'}}</button></view>
  <view class="paper-card selection-panel" wx:if="{{selecting}}"><view class="section-title">已选 {{selectedCount}} 帧</view><view class="batch-actions"><block wx:if="{{recycle}}"><button hover-class="control-pressed" class="button mint small" disabled="{{!selectedCount}}" data-restore="{{true}}" bindtap="moveSelected">把回忆找回来</button></block><block wx:else><button hover-class="control-pressed" class="button pink small" disabled="{{!selectedCount}}" data-liked="{{true}}" bindtap="likeSelected">♡ 喜欢</button><button hover-class="control-pressed" class="button small" disabled="{{!selectedCount}}" data-liked="{{false}}" bindtap="likeSelected">取消喜欢</button><button hover-class="control-pressed" class="button mint small" disabled="{{!selectedCount}}" bindtap="openAlbumPicker">加入主题册</button><button hover-class="control-pressed" wx:if="{{albumId}}" class="button small" disabled="{{!selectedCount}}" bindtap="removeFromAlbum">从本册移出</button><button hover-class="control-pressed" class="button small" disabled="{{!selectedCount}}" bindtap="openBatch">批量分类</button><button hover-class="control-pressed" class="button small" disabled="{{!selectedCount}}" bindtap="moveSelected">放入回收站</button></block></view><view wx:if="{{batchOpen}}" class="batch-form"><view class="feedback" wx:if="{{formError}}">{{formError}}</view><view class="field">给照片贴标签<input class="input" maxlength="24" value="{{batchTag}}" placeholder="如：午后、一起、作品" bindinput="batchInput" /></view><view class="field">这一组照片里的兔兔<view class="pet-options"><button hover-class="control-pressed" wx:for="{{batchPets}}" wx:key="id" class="pet-pill {{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="batchPet">{{item.selected ? '✓ ' : ''}}{{item.name}}</button></view></view><view class="muted batch-help">留空的标签和兔兔归属会保留原设置，勾选兔兔时统一替换归属。</view><button hover-class="control-pressed" class="button mint small" bindtap="applyBatch">应用到所选照片</button></view></view>
  <block wx:for="{{groups}}" wx:key="key" wx:for-item="group">
    <view class="album-group-head"><text class="album-group-label">{{group.label}}</text><text class="album-group-count">{{group.items.length}} 帧</text></view>
    <view class="contact-sheet"><view class="photo-card" wx:for="{{group.items}}" wx:key="id"><view class="polaroid {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="photoTap" bindlongpress="longPressPhoto" aria-role="button" hover-class="control-pressed"><view class="tape"></view><view class="frame-no">FRAME {{item.frame}}</view><image class="photo-image" src="{{item.src}}" mode="aspectFill" lazy-load /><view class="selection-mark" wx:if="{{selecting}}">{{item.selected ? '✓' : ''}}</view><view class="photo-caption"><text>{{item.title}}</text><text class="heart">{{item.liked ? '♥' : '♡'}}</text></view><view class="photo-date">{{item.dateText}}</view></view><view class="photo-labels"><text wx:if="{{item.petText}}">{{item.petText}}</text><text wx:if="{{item.tag}}">#{{item.tag}}</text></view><view class="photo-actions"><block wx:if="{{recycle}}"><button hover-class="control-pressed" class="text-action" data-id="{{item.id}}" data-restore="{{true}}" bindtap="moveOne">↶ 找回</button></block><block wx:else><button hover-class="control-pressed" class="icon-action {{item.liked ? 'liked' : ''}}" aria-label="喜欢这张照片" data-id="{{item.id}}" bindtap="toggleLike">{{item.liked ? '♥' : '♡'}}</button><button hover-class="control-pressed" class="text-action" data-id="{{item.id}}" bindtap="openDetails">资料</button><button hover-class="control-pressed" class="text-action" data-id="{{item.id}}" bindtap="openStudio">编辑</button><button hover-class="control-pressed" class="icon-action" aria-label="放入回收站" data-id="{{item.id}}" bindtap="moveOne">×</button></block></view></view></view>
  </block>
    <view class="page-error" wx:if="{{pageError}}">
    <text class="page-error-text">这次没能读到相册：{{pageError}}。数据还在本机，重试一下。</text>
    <view class="page-error-retry" bindtap="reload" hover-class="page-error-hover" aria-role="button" aria-label="重新读取相册">重试</view>
  </view>
<empty-state wx:if="{{!photos.length && !pageError}}" text="{{emptyText}}" /><view wx:if="{{!photos.length && !pageError}}" class="empty-actions"><button hover-class="control-pressed" class="button mint" bindtap="resetFilters">查看全部回忆</button><button hover-class="control-pressed" class="button pink" bindtap="upload">＋ 添照片</button></view>
  <view class="muted storage-note" wx:if="{{recycle}}">照片只是暂时收起，点击“找回”就会重新出现在相册里。</view>
</view>
<view class="drawer-mask" style="padding-top:{{safeTop}}px" wx:if="{{editing}}" bindtap="closeDetails"><view class="drawer album-sheet" style="padding-top:{{safeTop}}px" catchtap="noop"><view class="drawer-head"><view class="section-title">给这一帧补点旁白 ♡</view><button hover-class="control-pressed" aria-label="关闭当前面板" class="close" bindtap="closeDetails">×</button></view><scroll-view scroll-y class="sheet-scroll"><form bindsubmit="saveDetails"><view class="feedback" wx:if="{{formError}}">{{formError}}</view><image class="detail-photo" src="{{draft.src}}" mode="aspectFill" /><view class="field">这一帧叫什么<input class="input" maxlength="60" value="{{draft.title}}" data-field="title" aria-label="照片标题" bindinput="draftInput" /></view><view class="field">拍下它的日子<picker mode="date" value="{{draft.date}}" end="{{today}}" bindchange="draftDate"><view class="input">{{draft.date || '点这里补上日期'}} ▾</view></picker><button hover-class="control-pressed" wx:if="{{draft.date}}" class="text-action" bindtap="clearDraftDate">清除日期</button></view><view class="field">镜头里的小主角<view class="pet-options"><button hover-class="control-pressed" wx:for="{{editorPets}}" wx:key="id" class="pet-pill {{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="draftPet">{{item.selected ? '✓ ' : ''}}{{item.name}}</button></view></view><view class="field">回忆标签<input class="input" maxlength="24" value="{{draft.tag}}" data-field="tag" aria-label="照片标签" bindinput="draftInput" placeholder="例如：一起、午后、作品" /></view><button hover-class="control-pressed" wx:if="{{albumId}}" class="button mint cover-button" bindtap="setAlbumCover">用这一帧作主题册封面</button><button hover-class="control-pressed" class="button pink save-btn" form-type="submit">把旁白收好 ♡</button></form></scroll-view></view></view>
<view wx:if="{{theater}}" class="theater" style="padding-top:{{safeTop}}px" catchtouchmove="noop" bindtouchstart="theaterTouchStart" bindtouchend="theaterTouchEnd">
  <view class="theater-bar">
    <view class="theater-meta"><text class="theater-count">{{theaterIndex + 1}} / {{theaterTotal}}</text><text class="theater-state">{{theaterPlaying ? '放映中' : '已暂停'}}</text></view>
    <view class="theater-close" bindtap="closeTheater" aria-role="button" aria-label="退出放映">×</view>
  </view>
  <view class="theater-track"><view class="theater-fill fill-{{theaterIndex % 2}}" wx:if="{{theaterPlaying}}"></view></view>
  <view class="theater-stage">
    <image class="theater-photo" src="{{theaterPhoto.src}}" mode="aspectFit" bindtap="toggleTheaterPlay" />
    <view class="theater-side left" bindtap="theaterPrev" aria-role="button" aria-label="上一帧">‹</view>
    <view class="theater-side right" bindtap="theaterNext" aria-role="button" aria-label="下一帧">›</view>
  </view>
  <view class="theater-caption">
    <text class="theater-title">{{theaterPhoto.title}}</text>
    <text class="theater-date">{{theaterPhoto.dateText}} · 左右滑动换一帧</text>
  </view>
</view>

<view class="drawer-mask" style="padding-top:{{safeTop}}px" wx:if="{{albumPicker}}" bindtap="closeAlbumPicker"><view class="drawer collection-sheet" style="padding-top:{{safeTop}}px" catchtap="noop"><view class="drawer-head"><view class="section-title">把 {{selectedCount}} 帧放进哪一册？</view><button hover-class="control-pressed" aria-label="关闭当前面板" class="close" bindtap="closeAlbumPicker">×</button></view><scroll-view scroll-y class="collection-picker-scroll"><view class="collection-explain">一张照片可以属于好多册，不会多占一份照片空间。</view><view wx:for="{{albums}}" wx:key="id" class="collection-picker-row" data-id="{{item.id}}" bindtap="addToAlbum" aria-role="button" hover-class="control-pressed"><image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" /><view wx:else class="collection-picker-empty">♡</view><view class="collection-picker-copy"><view>{{item.title}}</view><text>已有 {{item.count}} 帧</text></view><text>＋</text></view><view wx:if="{{!albums.length}}" class="collection-explain">还没有主题册，给这些照片起一个共同的名字吧。</view><button hover-class="control-pressed" class="button pink" bindtap="newAlbumWithSelected">＋ 新建主题册并加入</button></scroll-view></view></view>
<view class="drawer-mask" style="padding-top:{{safeTop}}px" wx:if="{{albumEditing}}" bindtap="closeAlbumEditor"><view class="drawer collection-sheet" style="padding-top:{{safeTop}}px" catchtap="noop"><view class="drawer-head"><view class="section-title">{{albumDraft.id ? '给回忆换个名字' : '新的一册小日子'}}</view><button hover-class="control-pressed" aria-label="关闭当前面板" class="close" bindtap="closeAlbumEditor">×</button></view><view class="collection-form"><view aria-hidden="true" class="collection-form-stamp">MEMORY CLUB · ♡</view><view class="field">这一册叫什么<view class="feedback" wx:if="{{formError}}">{{formError}}</view><input class="input" maxlength="24" value="{{albumDraft.title}}" bindinput="albumTitleInput" placeholder="比如：一起晒太阳、豆米的午后" /></view><view class="collection-explain">主题册只收藏照片的关联。移除册子时，原照片仍会留在相册里。</view><button hover-class="control-pressed" class="button pink" bindtap="saveAlbum">把这一册收好 ♡</button></view></view></view>
<bunny-menu />

