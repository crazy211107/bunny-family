.theater-entry{flex:0 0 auto;display:flex;align-items:center;justify-content:center;height:60rpx;padding:0 22rpx;font-size:23rpx;color:#8d7386;background:#fffaf2;border:1rpx solid #dcc7d2;border-radius:30rpx}
.theater{position:fixed;inset:0;z-index:120;display:flex;flex-direction:column;background:#3a3140;padding:calc(env(safe-area-inset-top) + 20rpx) 0 calc(env(safe-area-inset-bottom) + 30rpx)}
.theater-bar{display:flex;align-items:center;justify-content:space-between;padding:0 34rpx}
.theater-count{font-size:22rpx;color:#f6e6eecc;letter-spacing:2rpx}
.theater-close{width:88rpx;height:88rpx;display:flex;align-items:center;justify-content:center;font-size:36rpx;line-height:1;color:#f6e6ee;background:#ffffff1f;border-radius:50%}
.theater-stage{position:relative;flex:1;min-height:0;display:flex;align-items:center;justify-content:center;padding:20rpx 0}
.theater-photo{width:100%;height:100%}
.theater-side{position:absolute;top:50%;width:72rpx;height:120rpx;display:flex;align-items:center;justify-content:center;font-size:52rpx;color:#f6e6eeaa;transform:translateY(-50%)}
.theater-side.left{left:0}
.theater-side.right{right:0}
.theater-caption{display:flex;flex-direction:column;align-items:center;gap:8rpx;padding:0 40rpx}
.theater-title{font-size:28rpx;color:#fdf3f7;text-align:center;line-height:1.6}
.theater-date{font-size:21rpx;color:#f6e6ee99}

.contact-sheet{gap:34rpx 20rpx;padding:10rpx 4rpx}
.photo-caption{margin-top:16rpx;font-size:26rpx;align-items:flex-start}
.photo-caption>text:first-child{-webkit-line-clamp:2;min-height:70rpx;line-height:1.45}
.photo-caption .heart{font-size:26rpx;line-height:1.4;color:#c9899f}
.photo-date{margin-top:6rpx;font-size:20rpx;color:#b39daa}
.photo-labels{gap:10rpx;padding:14rpx 0 0;font-size:21rpx;color:#8d7386}
.photo-labels text{max-width:100%;padding:4rpx 14rpx;background:#fdf0f4;border-radius:11rpx 15rpx 10rpx 14rpx}
.photo-actions{justify-content:space-between;gap:6rpx;margin-top:14rpx;padding-top:12rpx;border-top:1rpx dashed #ecdde4}
.photo-actions .text-action{min-height:58rpx;padding:0 8rpx;font-size:22rpx;color:#96798b}
.photo-actions .icon-action{width:56rpx;height:56rpx;display:flex;align-items:center;justify-content:center;font-size:26rpx;line-height:1;color:#b08d9f;background:#fdf5f7;border-radius:50%}
.photo-actions .icon-action.liked{color:#c95f84;background:#ffe4ee}

.page-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:26rpx}
.page-heading>view:first-child{flex:1;min-width:0}
.page-heading .title{font-size:48rpx;line-height:1.4}
.page-heading .subtitle{margin-top:8rpx}
.page-heading .button{flex:0 0 auto;min-height:76rpx;padding:0 26rpx;font-size:24rpx;box-shadow:0 4rpx 0 #6b5b7310}

.album-tools .button{min-height:76rpx;padding:0 24rpx;font-size:24rpx}
.album-tools .input{min-height:84rpx}
.result-line{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:6rpx 0 22rpx;font-size:24rpx;color:#96798b}

.album-group-head{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx;margin:26rpx 4rpx 16rpx;padding-left:14rpx;border-left:6rpx solid #ffd9e8}
.album-group-label{font-size:26rpx;letter-spacing:2rpx;color:#7d6478}
.album-group-count{font-size:20rpx;color:#b39daa}
.album-group-head+.contact-sheet{margin-top:0}

.theater-meta{display:flex;align-items:center;gap:14rpx}
.theater-state{font-size:19rpx;color:#f6e6ee88}
.theater-track{height:4rpx;margin:14rpx 34rpx 0;background:#ffffff1f;border-radius:2rpx;overflow:hidden}
.theater-fill{height:100%;width:0;background:#ffd9e8;border-radius:2rpx;animation:theater-fill 3.5s linear forwards}
.fill-0{animation-name:theater-fill}
.fill-1{animation-name:theater-fill-alt}
@keyframes theater-fill{from{width:0}to{width:100%}}
@keyframes theater-fill-alt{from{width:0}to{width:100%}}

/* 主题册像一排可以翻看的口袋相簿，收藏关联而不复制原片。 */
.collection-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:30rpx 2rpx 20rpx}
.collection-heading .section-title{font-size:30rpx;margin:4rpx 0 0}
.collection-kicker{font-size:15rpx;letter-spacing:3rpx;color:#a98b9d}
.collection-heading .text-action{flex-shrink:0;min-height:72rpx;display:flex;align-items:center;padding:0 8rpx}
.collection-scroll{width:100%;white-space:nowrap;margin-bottom:24rpx}
.collection-card{display:inline-block;vertical-align:top;box-sizing:border-box;width:208rpx;padding:12rpx 12rpx 14rpx;margin:6rpx 16rpx 12rpx 0;background:#fffcf6;border:2rpx solid #e4d4da;border-radius:12rpx 20rpx 14rpx 10rpx;white-space:normal;transform:rotate(-1deg)}
.collection-card:nth-child(even){transform:rotate(1deg)}
.collection-card.active{border-color:#bb86a0;background:#fff0f5;box-shadow:0 5rpx 0 #dfc0ce55}
.collection-cover{position:relative;width:100%;height:174rpx;background:#f4eddf;border-radius:6rpx;overflow:hidden}
.collection-cover image{width:100%;height:100%}
.collection-ribbon{position:absolute;left:0;bottom:12rpx;font-size:14rpx;letter-spacing:2rpx;color:#6b5b73;background:#ffe9a8ed;padding:3rpx 10rpx}
.collection-paper{display:flex;flex-direction:column;align-items:center;justify-content:center;background:#c9e7d3;color:#6b5b73}
.collection-paper>text:first-child{font-size:66rpx;line-height:1.1}
.collection-paper-word{font-size:13rpx;letter-spacing:2rpx;margin-top:10rpx}
.collection-name{margin-top:12rpx;font-size:25rpx;color:#6b5b73;line-height:1.5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.collection-count{font-size:18rpx;color:#a78c9d;margin-top:4rpx}
.collection-placeholder{height:100%;display:flex;align-items:center;justify-content:center;color:#a88b9c;font-size:23rpx;border:1rpx dashed #d5bdc8;box-sizing:border-box}
.collection-current{display:flex;align-items:center;justify-content:space-between;gap:12rpx;border-left:6rpx solid #c9e7d3;padding:12rpx 0 12rpx 18rpx;margin-bottom:24rpx}
.collection-current-title{flex:1;min-width:0;font-size:25rpx;line-height:1.5;word-break:break-all}
.collection-manage{display:flex;gap:16rpx;flex-shrink:0}
.collection-manage .text-action{min-height:64rpx;display:flex;align-items:center;font-size:22rpx}
.cover-button{margin-top:24rpx}
.collection-sheet{height:100%;max-height:100%;display:flex;flex-direction:column}
.collection-picker-scroll{flex:1;min-height:0;padding:24rpx 34rpx 90rpx;box-sizing:border-box}
.collection-explain{font-size:24rpx;color:#9a8092;line-height:1.85;margin:12rpx 0 26rpx}
.collection-picker-row{display:flex;align-items:center;gap:22rpx;min-height:134rpx;padding:18rpx 0;border-bottom:1rpx dashed #e4d1db}
.collection-picker-row>image,.collection-picker-empty{width:112rpx;height:112rpx;border-radius:12rpx;flex-shrink:0;background:#c9e7d3}
.collection-picker-empty{display:flex;align-items:center;justify-content:center;font-size:42rpx}
.collection-picker-copy{flex:1;min-width:0;font-size:29rpx;word-break:break-all}
.collection-picker-copy>text{display:block;font-size:21rpx;color:#a58b9d;margin-top:5rpx}
.collection-picker-row>text{font-size:36rpx;padding:14rpx;color:#a56885}
.collection-picker-scroll>.button{margin-top:28rpx}
.collection-form{padding:34rpx}
.collection-form-stamp{display:inline-block;padding:12rpx 22rpx;background:#ffe9a8;border:2rpx dashed #c8ab80;transform:rotate(-4deg);font-size:19rpx;letter-spacing:3rpx;margin:10rpx 0 30rpx}

/* 紧凑的信息分层，触区保留；照片与功能分组优先于大块留白。 */
.page-heading{margin-bottom:18rpx;gap:16rpx}
