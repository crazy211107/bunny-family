.collection-cover{height:148rpx}
.collection-scroll{margin-bottom:18rpx}
.collection-current{margin-bottom:18rpx;padding-top:4rpx;padding-bottom:4rpx}
.album-tools{padding:18rpx}
.tools-row{margin-top:10rpx}
.sort-pill{min-height:72rpx;display:flex;align-items:center;color:#80667c}
.result-line{margin:18rpx 0 14rpx;color:#80667c;font-size:23rpx;flex-wrap:wrap}
.text-action,.collection-heading .text-action,.collection-manage .text-action{min-height:72rpx;display:flex;align-items:center;justify-content:center}
.photo-actions .text-action,.photo-actions .icon-action{min-height:72rpx;height:72rpx}
.photo-actions .icon-action{width:72rpx;flex-shrink:0}
.photo-actions{gap:0;margin-top:10rpx;padding-top:6rpx}
.photo-actions .text-action{flex:1;padding:0 4rpx}
.photo-date,.collection-count{color:#897184}
.photo-image{height:280rpx}
.photo-caption>text:first-child{min-height:0}
.album-group-head{margin-top:22rpx;margin-bottom:12rpx}
.contact-sheet{gap:26rpx 20rpx}
.collection-explain{color:#806c7b}
