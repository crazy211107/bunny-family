/* 首页是一张家庭电影的封面，照片与真实记录先于功能清单。 */
.home-page{padding-top:14rpx}
.home-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:4rpx 0 30rpx}
.home-heading-copy{flex:1;min-width:0}.home-eyebrow{display:block;font-size:10px;letter-spacing:1.2px;color:#806c7b;line-height:1.6}
.home-heading .title{font-size:52rpx;line-height:1.35;margin:9rpx 0 7rpx;letter-spacing:2rpx}.home-intro{font-size:13px;color:#806c7b;line-height:1.7}
.date-note{position:relative;display:flex;align-items:center;flex-direction:column;justify-content:center;flex-shrink:0;width:126rpx;min-width:62px;padding:11rpx 13rpx 13rpx;background:#ffe9a8;border:1rpx solid #d8c18b;border-radius:9rpx 15rpx 8rpx 13rpx;transform:rotate(3deg);box-shadow:3rpx 4rpx 0 #6b5b7308}
.date-note>text{font-size:10px;color:#795a2c;white-space:nowrap}.date-note>view{font-family:Georgia,serif;font-size:47rpx;line-height:1.15;margin:5rpx 0;color:#6b5b73}
.hero-stack{position:relative;isolation:isolate;margin:0 5rpx 28rpx}
.hero-underlay{position:absolute;inset:12rpx -10rpx -9rpx 9rpx;z-index:-1;border:1rpx solid #dbbecd;border-radius:15rpx;background:#f4dce4;transform:rotate(1.8deg)}
.hero-paper{position:relative;padding:17rpx 23rpx 8rpx;background:#fffdf8;border:1rpx solid #ddcbd4;border-radius:14rpx;box-shadow:0 14rpx 28rpx #6b5b730d}
.hero-paper>.tape{position:absolute;z-index:2;top:-13rpx;left:38%;width:158rpx;height:28rpx;transform:rotate(-4deg);background:#c9e7d3cc;border-left:3rpx dotted #a6bfa7;border-right:3rpx dotted #a6bfa7}
.film-holes{position:absolute;top:22rpx;bottom:100rpx;width:7rpx;background:repeating-linear-gradient(to bottom,#ddcbd4 0,#ddcbd4 10rpx,transparent 10rpx,transparent 24rpx);border-radius:2rpx;opacity:.7}.film-holes.left{left:7rpx}.film-holes.right{right:7rpx}
.hero-frame{position:relative;overflow:hidden;border-radius:6rpx;background:#ece4dd}.hero-photo{width:100%;height:438rpx;display:block;object-fit:cover}.hero-frame-line{position:absolute;inset:12rpx;border:1rpx solid #fff9f066;border-radius:4rpx;pointer-events:none}
.hero-reel-label{position:absolute;top:24rpx;left:24rpx;padding:6rpx 12rpx;border:1rpx solid #fff9f044;border-radius:6rpx;color:#fff9f0;background:#3b3140b8;font-size:10px;letter-spacing:.5px;pointer-events:none}
.hero-no{position:absolute;right:23rpx;bottom:19rpx;font-size:10px;color:#fff9f0;background:#3b3140b8;border-radius:6rpx;padding:4rpx 10rpx;letter-spacing:1px;pointer-events:none}
.hero-caption{display:flex;align-items:center;gap:12rpx;min-height:96rpx}.caption{flex:1;min-width:0;font-family:var(--font-display);font-size:26rpx;color:#6b5b73;line-height:1.55;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.film-btn{display:flex;align-items:center;justify-content:center;width:44px;height:44px;flex-shrink:0;border-radius:50%;background:#f4eee8;color:#875873}.film-btn-hover{background:#ffd9e8}.next-btn{background:transparent}.next-glyph{font-size:34px;line-height:1}.play-glyph{width:0;height:0;margin-left:4rpx;border-top:10rpx solid transparent;border-bottom:10rpx solid transparent;border-left:15rpx solid #875873}.pause-glyph{display:flex;gap:5rpx}.pause-glyph>view{width:5rpx;height:21rpx;background:#875873;border-radius:2rpx}
.counter{font-size:11px;color:#806c7b;white-space:nowrap}.counter-now{font-weight:600}.hero-stamp{display:none}.hero-empty{display:flex;align-items:center;justify-content:center;flex-direction:column;gap:16rpx;min-height:370rpx;font-size:14px;color:#806c7b}.hero-empty>text{font-size:12px}
.opening{display:flex;align-items:center;gap:16rpx;margin:31rpx 0 24rpx}.opening-copy{flex:1;min-width:0}.opening-line{display:block;font-family:var(--font-display);font-size:30rpx;font-weight:600;line-height:1.6}.opening-sub{display:block;font-size:12px;color:#806c7b;line-height:1.65;margin-top:5rpx}
.opening-action{display:flex;align-items:center;justify-content:center;gap:12rpx;flex-shrink:0;min-height:44px;margin:0;padding:0 23rpx;background:#ffd9e8;border:1rpx solid #cfa3b7;border-radius:16rpx 22rpx 16rpx 20rpx;color:#6b5b73;font-size:13px;line-height:1.5}.opening-action-hover{background:#f9cada;transform:translateY(1rpx)}.opening-action>text{font-size:17px;color:#875873}
.home-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin:0 0 22rpx;border-top:1rpx solid #e2d1da;border-bottom:1rpx solid #e2d1da;padding:21rpx 0}.home-summary>view{display:flex;flex-direction:column;align-items:center;gap:5rpx;border-left:1rpx solid #e2d1da}.home-summary>view:first-child{border:0}.home-summary>view>text:first-child{font-family:Georgia,serif;font-size:30rpx;line-height:1.4}.home-summary>view>text:first-child>text{font-family:var(--font-body);font-size:12px}.home-summary>view>text:last-child{font-size:11px;color:#806c7b}
.home-care-ticket{display:flex;align-items:center;gap:16rpx;min-height:44px;padding:21rpx 22rpx;margin:0 0 36rpx;background:#eaf2e8;border:1rpx solid #c3d5c0;border-radius:20rpx 28rpx 20rpx 24rpx}.home-care-ticket-mark{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:56rpx;height:56rpx;background:#c9e7d3;border-radius:50%;font-size:30rpx;color:#42654d}.home-care-ticket-copy{display:flex;flex-direction:column;flex:1;min-width:0;gap:5rpx}.home-care-ticket-copy>text:first-child{font-size:14px;font-weight:600}.home-care-ticket-copy>text:last-child{font-size:11px;color:#526d57;line-height:1.6}.home-care-ticket-open{display:flex;align-items:center;gap:10rpx;flex-shrink:0;font-size:12px;color:#42654d}.home-care-ticket-open>text:last-child{font-size:18px}.home-care-ticket-pressed{background:#dcebdc}
.section-row{display:flex;align-items:center;justify-content:space-between;margin:12rpx 0 18rpx}.section-row>view{display:flex;flex-direction:column;gap:5rpx}.section-kicker{display:block;font-size:10px;color:#806c7b;letter-spacing:1.2px;line-height:1.6}.home-section-title{font-family:var(--font-display);font-size:32rpx;font-weight:600}.section-flower{font-size:37rpx;color:#a96f8b}
.pet-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx;margin-bottom:23rpx}.pet-slip{position:relative;overflow:hidden;min-width:0;padding:8rpx 8rpx 19rpx;background:#fffdf8;border:1rpx solid #e2d1da;border-radius:16rpx 20rpx 14rpx 18rpx;box-shadow:0 6rpx 0 #6b5b7305}.slip-photo{width:100%;height:254rpx;object-fit:cover;border-radius:10rpx 14rpx 8rpx 12rpx}.slip-veil{display:none}.slip-number{position:absolute;top:18rpx;left:18rpx;color:#fffdf8;background:#3b314099;border:1rpx solid #fff9f044;border-radius:50%;width:36rpx;height:36rpx;display:flex;align-items:center;justify-content:center;font-family:Georgia,serif;font-size:11px}.slip-name{display:flex;justify-content:space-between;align-items:center;font-family:var(--font-display);font-size:30rpx;font-weight:600;padding:12rpx 12rpx 4rpx;color:#6b5b73}.slip-name>text{font-family:var(--font-body);font-size:12px;color:#875873;font-weight:400}.slip-dots{display:flex;gap:7rpx;margin:9rpx 12rpx}.slip-dot{height:7rpx;flex:1;background:#f0e4e9;border:1rpx solid #dfcbd6;border-radius:4rpx}.slip-dot.on{background:#a9cdb2;border-color:#91b59b}.slip-hint{display:block;font-size:11px;line-height:1.5;color:#806c7b;padding:0 12rpx}.pet-slip-hover{background:#fff3f7;transform:translateY(1rpx)}
.care-doors{display:grid;grid-template-columns:1.15fr 1fr;gap:16rpx;margin:20rpx 0}.care-door-main,.care-door-side{min-width:0;border:1rpx solid #d2c4b4;padding:23rpx 20rpx;border-radius:8rpx 24rpx 8rpx 22rpx;background:#f6eddb}.care-door-side{background:#f8e8ee;border-color:#e0c6d2;border-radius:24rpx 8rpx 22rpx 8rpx}.door-eyebrow{display:block;font-size:10px;color:#806c7b;letter-spacing:.5px}.care-door-main>view,.care-door-side>view{display:flex;align-items:center;justify-content:space-between;gap:4rpx;margin:10rpx 0;font-family:var(--font-display);font-size:29rpx;font-weight:600;line-height:1.6}.care-door-main>view>text,.care-door-side>view>text{font-size:13px}.care-door-main>text:last-child,.care-door-side>text:last-child{display:block;font-size:12px;line-height:1.75;color:#806c7b}.door-pressed{opacity:.8}.low-supply-note{display:flex;align-items:center;justify-content:space-between;gap:12rpx;min-height:44px;padding:14rpx 18rpx;margin:0 0 20rpx;background:#fff0cb;border-left:3rpx solid #c09b52;border-radius:8rpx;font-size:12px;color:#795a2c}
.todo-note{position:relative;padding:24rpx 23rpx 14rpx;margin:32rpx 0;background:#fffdf8;border:1rpx solid #e2d1da;border-top:6rpx solid #ffe9a8;border-radius:12rpx 12rpx 20rpx 20rpx}.todo-note>.tape{display:none}.todo-head .section-title{font-size:31rpx;font-weight:600;margin:4rpx 0 16rpx}.todo-count{font-size:11px;color:#806c7b}.care-line{display:flex;align-items:center;gap:16rpx;min-height:44px;padding:15rpx 0;border-bottom:1rpx solid #eee4e4}.line-mark{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:34rpx;height:34rpx;border:1rpx solid #c7adbe;border-radius:8rpx;color:#875873;background:#fff9f0;font-size:12px}.line-mark-care,.line-mark-plan{border-radius:50%;background:#eaf2e8;border-color:#afc5b3;color:#42654d}.line-mark-reminder{color:#963e61;background:#ffe8ef;border-color:#c98ca5}.line-mark.is-done{background:#c9e7d3;color:#42654d}.line-body{display:flex;flex-direction:column;gap:4rpx;flex:1;min-width:0}.line-title{font-size:13px;line-height:1.7;overflow-wrap:break-word}.line-title.is-done{text-decoration:line-through;color:#806c7b}.line-note{font-size:11px;color:#806c7b}.line-due{flex-shrink:0;font-size:11px;color:#963e61}.line-remove{display:flex;align-items:center;justify-content:center;flex-shrink:0;min-width:44px;min-height:44px;font-size:22px;color:#875873;margin-right:-12rpx}.todo-input{display:flex;align-items:center;gap:10rpx;margin-top:10rpx}.todo-input input{min-width:0;flex:1;height:44px;font-size:13px;color:#6b5b73}.todo-add{display:flex;align-items:center;justify-content:center;width:44px;height:44px;flex-shrink:0;background:#f1ece5;border-radius:14rpx;font-size:24px;color:#875873}.todo-add-hover{background:#ffd9e8}.todo-empty{font-size:12px;padding:12rpx 0}
.memory-heading{margin:34rpx 0 16rpx;align-items:flex-end}.memory-heading .section-title{font-size:31rpx;font-weight:600;margin:5rpx 0 0}.memory-heading .text-btn{font-size:12px;min-height:44px;padding-right:0}.film-roll{width:100%;white-space:nowrap;background:#f7e7eb;border:1rpx solid #ead7df;border-radius:18rpx;padding:20rpx 0 24rpx}.film-rail{display:inline-flex;gap:18rpx;padding:6rpx 22rpx}.film-frame{flex-shrink:0;width:244rpx;padding:9rpx 11rpx;background:#fffdf8;border:1rpx solid #ddc8d2;border-radius:5rpx;transform:rotate(-1deg);box-shadow:0 6rpx 10rpx #6b5b7307}.film-frame:nth-child(even){transform:rotate(1deg)}.sprocket{height:10rpx;background-image:radial-gradient(#d5c2cb 2.5rpx,transparent 2.5rpx);background-size:17rpx 10rpx;background-repeat:repeat-x}.sprocket.top{margin-bottom:7rpx}.sprocket.bottom{margin-top:7rpx}.film-window{position:relative}.film-window image{width:100%;height:205rpx;object-fit:cover;border-radius:3rpx}.film-index{position:absolute;left:8rpx;bottom:7rpx;padding:2rpx 8rpx;background:#3b3140ad;border-radius:3rpx;color:#fff9f0;font-size:10px}.film-title{display:block;font-size:12px;line-height:1.6;text-align:center;margin-top:9rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.memory-on-this-day{padding:21rpx;background:#fff2d7;border:1rpx solid #e1cc9b;border-radius:20rpx;margin:28rpx 0}.otd-head{display:flex;align-items:center;justify-content:space-between;gap:10rpx}.otd-title{display:flex;align-items:baseline;gap:5rpx}.otd-years{font-family:Georgia,serif;font-size:36rpx}.otd-unit,.otd-more{font-size:12px}.otd-more{color:#875873;min-height:44px;display:flex;align-items:center}.otd-thumbs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin:14rpx 0}.otd-thumb{position:relative;overflow:hidden;border:5rpx solid #fffdf8;border-radius:7rpx}.otd-thumb image{width:100%;height:170rpx;object-fit:cover}.otd-year{position:absolute;left:5rpx;bottom:5rpx;background:#fff9f0e6;padding:2rpx 7rpx;border-radius:4rpx;font-size:10px}.otd-note{font-size:11px;line-height:1.7;color:#806c7b}
.home-footer{display:flex;flex-direction:column;align-items:center;gap:14rpx;margin-top:38rpx;color:#806c7b;font-size:12px;line-height:1.8}.home-footer bunny-mark{opacity:.75}.journal-date{text-align:center;margin:12rpx 0 24rpx}.journal-pets{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}.journal-pets>view{display:flex;align-items:center;flex-direction:column;gap:10rpx;padding:20rpx;background:#eaf2e8;border-radius:20rpx;font-size:13px}.journal-pets>view>text:last-child{font-size:12px;color:#42654d}.note-title{font-size:18px;margin:12rpx 0;font-weight:600}.note-body{font-size:14px;line-height:1.85;white-space:pre-wrap}.save-btn-hover,.button-hover{opacity:.85}
@media(max-width:340px){.home-heading .title{font-size:48rpx}.hero-photo{height:408rpx}.hero-paper{padding-left:19rpx;padding-right:19rpx}.hero-caption{gap:6rpx}.caption{font-size:13px}.counter{display:none}.home-care-ticket{gap:10rpx;padding:18rpx 16rpx}.home-care-ticket-open>text:first-child{display:none}.opening{align-items:flex-start}.opening-sub{font-size:11px}.opening-action{padding:0 16rpx}.care-doors{gap:12rpx}.care-door-main,.care-door-side{padding:20rpx 15rpx}.care-door-main>view,.care-door-side>view{font-size:14px}}
@media(min-width:600px){.home-page{max-width:680px}.home-heading .title{font-size:32px}.date-note{width:76px;padding:10px}.date-note>view{font-size:30px}.hero-photo{height:340px}.hero-caption{min-height:64px}.caption{font-size:18px}.slip-photo{height:240px}.slip-name{font-size:20px}.home-section-title,.memory-heading .section-title,.todo-head .section-title{font-size:21px}.home-summary>view>text:first-child{font-size:23px}.film-frame{width:180px}.film-window image{height:170px}.home-eyebrow{font-size:11px}}
@media(prefers-reduced-motion:reduce){.opening-action-hover,.pet-slip-hover{transform:none}}
