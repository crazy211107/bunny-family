{font-size:22rpx;color:#80674e}.line-title{white-space:normal;line-height:1.6}.line-remove{width:76rpx;height:88rpx}.line-mark-plan{border-color:#8ba990;background:#e6f1e7;border-radius:50%;color:#4e6d55}.todo-input input{min-height:88rpx;font-size:25rpx}.todo-add{width:88rpx;height:88rpx}.memory-heading{margin:28rpx 0 14rpx}.memory-heading .section-title{font-size:32rpx}.film-frame{width:270rpx}.film-window image{height:220rpx}.film-title{font-size:23rpx;color:#806579}.otd-note,.otd-more{font-size:22rpx;color:#806579}.home-footer{margin-top:38rpx;color:#806c7b}.home-footer>view{font-size:23rpx}
