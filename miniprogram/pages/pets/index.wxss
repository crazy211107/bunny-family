/* Vant Cell / Field 分组思路，保留兔兔家庭的奶油纸张与手写气质。 */
.pet-page{padding-bottom:calc(190rpx + env(safe-area-inset-bottom))}
.pet-header{margin:0 0 20rpx}.page-eyebrow{display:block;font-size:20rpx;letter-spacing:2rpx;color:#826e80;margin-bottom:6rpx}.pet-title{display:block;font-size:46rpx;font-weight:600;letter-spacing:2rpx;line-height:1.45;transform:rotate(-1deg)}.pet-sub{display:block;margin-top:8rpx;font-size:24rpx;color:#806d7d}
.pet-switch{display:flex;gap:14rpx;margin:0 0 20rpx}.pet-chip{display:flex;align-items:center;justify-content:center;gap:12rpx;flex:1;min-width:0;min-height:92rpx;padding:12rpx 16rpx;background:#fffcf5;border:1rpx solid #ddc9d4;border-radius:30rpx 38rpx 26rpx 34rpx}.pet-chip image{width:58rpx;height:58rpx;border:4rpx solid #fff9f0;border-radius:50%;flex-shrink:0}.pet-chip-name{font-size:27rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.pet-chip.selected{background:#ffd9e8;border-color:#a46b86;box-shadow:0 4rpx 0 #c18aa522}.pet-chip-check{font-size:22rpx;color:#854d69}.pet-control-pressed{transform:scale(.97)}
.pet-cover{position:relative;height:400rpx;overflow:hidden;margin-bottom:18rpx;background:#f2e5da;border:6rpx solid #fffdf8;border-radius:28rpx 42rpx 24rpx 36rpx;box-shadow:0 6rpx 18rpx #6b5b7312}.cover-photo{position:absolute;inset:0;width:100%;height:100%}.cover-veil{position:absolute;inset:0;background:linear-gradient(180deg,#fff9f033 0%,#fff9f000 38%,#fff9f0e8 70%,#fff9f0 100%)}.cover-top{position:absolute;left:20rpx;right:20rpx;top:18rpx;display:flex;justify-content:space-between;gap:12rpx}.cover-tag{flex-shrink:0;font-size:18rpx;letter-spacing:2rpx;padding:3rpx 10rpx;background:#fff9f0ee;border-radius:9rpx}.cover-breed{font-size:22rpx;line-height:1.6;padding:3rpx 10rpx;background:#fff9f0ee;border-radius:9rpx;max-width:56%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.cover-bottom{position:absolute;left:24rpx;right:24rpx;bottom:16rpx}.cover-name{font-size:40rpx;line-height:1.25;font-weight:600;margin-bottom:10rpx}.cover-heart{margin-left:12rpx;font-size:32rpx;color:#a7607e}.cover-stats{display:flex;align-items:center;gap:20rpx}.cover-stat{flex:1;min-width:0;display:flex;flex-direction:column;gap:2rpx}.stat-num{font-size:34rpx;line-height:1.35;font-weight:600}.stat-unit{font-size:21rpx;font-weight:400;margin-left:4rpx}.stat-label{font-size:21rpx;color:#806d7d}.cover-line{width:1rpx;height:46rpx;background:#d8c6cf}
.pet-card{position:relative;padding:22rpx 24rpx;margin-bottom:18rpx;background:#fffcf5;border:1rpx solid #ddcbd4;border-radius:28rpx 38rpx 24rpx 34rpx;box-shadow:0 5rpx 0 #6b5b7308}.file-card{padding-bottom:0}.file-row{display:flex;gap:20rpx;padding:12rpx 0}.file-cell{flex:1;min-width:0;display:flex;flex-direction:column;gap:4rpx}.file-label{font-size:22rpx;color:#826e80}.file-value{font-size:26rpx;word-break:break-all}.file-edit{display:flex;align-items:center;justify-content:space-between;gap:10rpx;min-height:88rpx;margin-top:12rpx;border-top:1rpx dashed #ddcbd4;font-size:24rpx;color:#854d69}.file-edit text{font-size:22rpx}.file-edit-hover{background:#fff1f6}
.card-head{align-items:center}.card-title{font-size:30rpx;font-weight:600;letter-spacing:1rpx}.card-hint{font-size:22rpx;color:#826e80}.care-progress{height:8rpx;margin:14rpx 0 16rpx;border-radius:6rpx;background:#eee3e8;overflow:hidden}.care-progress>view{height:100%;border-radius:6rpx;background:#8eaf94;transition:width .2s ease}.care-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10rpx}.care-cell{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7rpx;min-height:150rpx;padding:14rpx 4rpx;background:#f6f0e7;border:1rpx solid #ddcbd4;border-radius:22rpx 28rpx 20rpx 26rpx}.care-0{background:#eef4e9}.care-1{background:#f6edf2}.care-2{background:#fff5d7}.care-3{background:#ffedf3}.care-cell.done{background:#c9e7d3;border-color:#8aaa91}.care-cell-hover{transform:scale(.96)}.care-icon{font-size:30rpx;line-height:1;color:#806d7d}.care-cell.done .care-icon{color:#46664c}.care-name{font-size:24rpx}.care-time{font-size:18rpx;color:#806d7d;white-space:nowrap}.care-streak{display:flex;flex-direction:column;gap:3rpx;margin-top:16rpx;padding-top:14rpx;border-top:1rpx dashed #e5d6de}.streak-badge{font-size:24rpx;color:#854d69}.streak-note{font-size:22rpx;color:#826e80}
.rhythm-summary{display:flex;gap:12rpx;margin-top:14rpx}.rhythm-cell{flex:1;min-width:0;padding:12rpx 16rpx;background:#f7f0f1;border-radius:18rpx 24rpx 16rpx 22rpx}.rhythm-cell .stat-label{display:block;margin-top:4rpx}.heat-row{display:flex;align-items:flex-end;gap:7rpx;min-height:80rpx;margin:18rpx 0 12rpx}.heat-cell{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;gap:8rpx}.heat-bar{width:100%;height:10rpx;background:#eee2e7;border-radius:6rpx}.heat-1{height:18rpx;background:#f5cadb}.heat-2{height:26rpx;background:#dfabc3}.heat-3{height:34rpx;background:#bf849f}.heat-4{height:42rpx;background:#93b49a}.heat-cell .is-today{outline:2rpx solid #9d6480;outline-offset:3rpx}.heat-day{font-size:18rpx;color:#806d7d;line-height:1.2}.card-note{font-size:22rpx;line-height:1.75;color:#826e80}
.pet-history-heading{margin:24rpx 0 16rpx}.pet-history-heading .section-title{display:block;margin:0;font-size:30rpx;font-weight:600;letter-spacing:1rpx}.pet-history-heading .subtitle{display:block;margin-top:4rpx;font-size:22rpx;color:#826e80}.pet-calendar{padding:16rpx 18rpx}.calendar-navigation{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.calendar-navigation>text{font-size:27rpx}.calendar-navigation>button{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;padding:0;font-size:40rpx;background:#fff0f6;border:1rpx solid #ddc9d4;border-radius:28rpx}.calendar-week,.calendar-days{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));text-align:center}.calendar-week>text{padding:12rpx 0;font-size:22rpx;color:#826e80}.calendar-days{gap:5rpx}.calendar-day{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;min-width:0;width:100%;min-height:88rpx;padding:6rpx 0;font-size:26rpx;border:1rpx solid transparent;border-radius:18rpx 23rpx 16rpx 21rpx;line-height:1.3}.calendar-day.is-complete{background:#e6f1e7}.calendar-day.is-selected{background:#ffd9e8;border-color:#a46b86}.calendar-day.is-today>text{border-bottom:3rpx solid #98607a}.calendar-day[disabled]{background:transparent;color:#aa98a4}.calendar-dots{display:flex;gap:4rpx}.calendar-dots>view{width:7rpx;height:7rpx;border-radius:50%;background:#ded1d8}.calendar-dots .filled{background:#64886b}.calendar-footer{display:flex;align-items:center;justify-content:space-between;gap:8rpx;margin-top:12rpx;padding-top:8rpx;border-top:1rpx dashed #ddcbd4}.calendar-footer>text{flex:1;font-size:21rpx;color:#826e80}.calendar-footer>button{display:flex;align-items:center;min-height:88rpx;padding:8rpx 14rpx;font-size:22rpx;color:#854d69;flex-shrink:0}
.pet-history-detail{margin-top:18rpx;background:#f0f5eb;padding:22rpx 24rpx}.detail-tape{position:absolute;right:36rpx;top:-11rpx;width:96rpx;height:25rpx;background:#ffe9a8b3;transform:rotate(4deg)}.detail-kicker{display:block;font-size:22rpx;color:#826e80;margin-bottom:8rpx}.pet-section-line{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.detail-date{font-size:28rpx}.pet-section-line .section-title{font-size:30rpx;letter-spacing:1rpx;margin:0}.detail-note{display:block;margin:8rpx 0 12rpx;font-size:22rpx;color:#826e80}.history-row{display:flex;align-items:center;gap:12rpx;min-height:76rpx;padding:10rpx 12rpx;margin-bottom:8rpx;font-size:24rpx;border-radius:16rpx;background:#fffcf5}.history-row.recorded{background:#e0efdf}.history-symbol{width:30rpx;text-align:center}.history-time{margin-left:auto;font-size:21rpx;color:#6a7a67}.history-empty{padding:16rpx 0;font-size:23rpx;color:#826e80;line-height:1.8}
.pet-weight,.pet-reminders{padding:22rpx 24rpx;margin-top:18rpx}.small-action,.pet-text-button{display:flex;align-items:center;justify-content:center;min-height:88rpx;padding:12rpx 18rpx;font-size:23rpx;flex-shrink:0}.pet-text-button{color:#854d69}.weight-help{display:block;font-size:22rpx;color:#826e80;margin:12rpx 0}.weight-row{margin-bottom:12rpx}.weight-row-top{display:flex;align-items:center;gap:10rpx}.weight-record{flex:1;min-width:0;min-height:88rpx;display:flex;align-items:center;justify-content:space-between;gap:10rpx;font-size:23rpx;padding:0 4rpx}.weight-value{font-size:27rpx;font-weight:600}.weight-delete,.reminder-del{flex-shrink:0;display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;font-size:30rpx;color:#975d78;border-radius:26rpx;background:#fff0f5}.weight-track{height:8rpx;margin-top:4rpx;background:#eee2e7;border-radius:6rpx;overflow:hidden}.weight-track>view{height:100%;background:#94b69b;border-radius:6rpx}.pet-reminders{position:relative;background:#fff4d7}.reminder-cell{padding-left:10rpx;border-left:4rpx solid transparent}.reminder-cell.is-urgent{border-left-color:#ab526f;background:#fff2f4;border-radius:0 14rpx 14rpx 0}.reminder-cell .cell-title{white-space:normal;font-size:25rpx}.reminder-cell .cell-label{font-size:22rpx;color:#806d7d}.reminder-empty{padding:16rpx 0;font-size:23rpx;line-height:1.8;color:#826e80}.reminder-empty .text-btn{justify-content:flex-start;min-height:88rpx;padding-left:0;color:#854d69}.health-note{display:block;margin-top:12rpx;font-size:21rpx;color:#826e80;line-height:1.8}
.pet-drawer-mask{z-index:1000}.pet-drawer{display:flex;flex-direction:column;top:0;bottom:0;height:100%;padding:0;border-radius:30rpx 0 0 0}.pet-drawer .drawer-head{flex-shrink:0;padding:18rpx 28rpx}.pet-drawer .drawer-head>view{display:flex;flex-direction:column;gap:3rpx;min-width:0}.drawer-kicker{font-size:21rpx;color:#826e80}.pet-drawer-title{font-size:32rpx;font-weight:600}.pet-drawer .close{flex-shrink:0;width:88rpx;height:88rpx}.pet-drawer-body{flex:1;height:0;min-height:0;padding:22rpx 28rpx 0}.pet-form-avatar{width:110rpx;height:110rpx;margin:0 auto 20rpx;border-radius:40rpx 48rpx 36rpx 44rpx}.pet-drawer .field{margin:20rpx 0}.pet-drawer .field>text{display:block;margin-bottom:10rpx;font-size:25rpx}.pet-picker{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.pet-picker>text{color:#826e80}.pet-clear{display:flex;align-items:center;min-height:88rpx;font-size:23rpx;color:#854d69}.pet-form-hint{display:block;font-size:24rpx;line-height:1.8;color:#826e80}.pet-save{margin:20rpx 0 0}.pet-drawer-space{height:calc(50rpx + env(safe-area-inset-bottom))}
@media screen and (max-width:340px){.pet-title{font-size:42rpx}.care-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.care-cell{min-height:132rpx}.care-time{font-size:21rpx}.pet-cover{height:390rpx}.calendar-footer{align-items:flex-start}.calendar-footer>text{padding-top:15rpx}.pet-section-line{flex-wrap:wrap}.pet-drawer-title{font-size:29rpx}}
@media screen and (min-width:600px){.pet-cover{height:340rpx}.care-cell{min-height:130rpx}.pet-card,.paper-card{max-width:100%}}
@media (prefers-reduced-motion:reduce){.care-progress>view{transition:none}}
.weight-empty{display:flex;flex-direction:column;align-items:center;gap:10rpx;padding:32rpx 16rpx;text-align:center;font-size:26rpx}.weight-empty-symbol{font-size:42rpx;color:#9c6480}.weight-empty-sub{font-size:22rpx;line-height:1.8;color:#826e80}.weight-empty .button{margin-top:10rpx;font-size:24rpx}

.cover-photo-change{position:absolute;right:20rpx;top:92rpx;z-index:2;min-height:88rpx;padding:0 22rpx;display:flex;align-items:center;justify-content:center;font-size:24rpx;background:#fff9f0ed;color:#6b5b73;border:1rpx solid #d5b7c8;border-radius:20rpx 26rpx 18rpx 24rpx}.pet-photo-editor{display:flex;flex-direction:column;align-items:center;padding:12rpx 0 20rpx}.pet-photo-preview{position:relative}.pet-photo-preview .pet-form-avatar{width:160rpx;height:170rpx;margin:0;border:7rpx solid #fff9f0;box-shadow:0 5rpx 12rpx #6b5b731a;transform:rotate(-3deg)}.pet-photo-preview>text{position:absolute;right:-8rpx;bottom:2rpx;display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;background:#ffd9e8;border:4rpx solid #fff9f0;border-radius:50%;font-size:27rpx}.pet-photo-button{min-height:88rpx;display:flex;align-items:center;justify-content:center;padding:0 22rpx;font-size:25rpx;color:#875873}.pet-photo-hint{font-size:22rpx;color:#806c7b;text-align:center}.pet-photo-rail{width:100%;white-space:nowrap;margin-top:18rpx}.pet-photo-choices{display:inline-flex;gap:14rpx;padding:8rpx 6rpx}.pet-photo-choice{position:relative;width:112rpx;height:120rpx;padding:4rpx;flex:0 0 auto;background:#fffcf6;border:2rpx solid transparent;border-radius:15rpx}.pet-photo-choice.selected{border-color:#99718c}.pet-photo-choice image{width:100%;height:100%;border-radius:10rpx}.pet-photo-choice>text{position:absolute;right:5rpx;bottom:5rpx;background:#c9e7d3;border-radius:50%;font-size:22rpx;line-height:34rpx;width:34rpx;text-align:center}
