/* WeUI 分组信息层级 + Vant Field 持续反馈，独立实现本机家庭手账。 */
.family-page{padding-bottom:calc(190rpx + env(safe-area-inset-bottom))}.family-heading .title,.family-heading .subtitle{display:block}.page-eyebrow{display:block;font-size:20rpx;letter-spacing:2rpx;color:#826e80;margin-bottom:6rpx}.family-heading .title{font-size:42rpx;letter-spacing:1rpx;line-height:1.45;transform:rotate(-1deg)}.family-heading .subtitle{margin-top:8rpx;font-size:24rpx;color:#806d7d}
.family-opening{position:relative;display:flex;align-items:center;gap:16rpx;margin:22rpx 0 18rpx;padding:20rpx 22rpx;background:#f8e9ef;border:1rpx solid #dcc2cf;border-radius:26rpx 36rpx 22rpx 32rpx;overflow:hidden}.family-opening-mark{font-size:50rpx;color:#9b5c7a;line-height:1;flex-shrink:0}.family-opening>view{min-width:0;display:flex;flex-direction:column;gap:5rpx;position:relative;z-index:1}.family-opening-title{font-size:26rpx;font-weight:600}.family-opening>view>text+text{font-size:22rpx;color:#806d7d}.family-opening-stamp{position:absolute;right:8rpx;top:7rpx;padding:3rpx 8rpx;font-size:18rpx;letter-spacing:2rpx;color:#be9bad;border:2rpx solid #dfbdcc;border-radius:8rpx;transform:rotate(12deg)}
.family-add{margin:0 0 24rpx;width:100%;font-size:26rpx;min-height:88rpx}.family-timeline{position:relative;padding-left:20rpx}.family-timeline::before{content:'';position:absolute;top:32rpx;bottom:45rpx;left:5rpx;border-left:2rpx dashed #d6bccb}.family-member-wrap{position:relative;padding:0 0 16rpx 12rpx}.family-timeline-dot{position:absolute;left:-22rpx;top:42rpx;width:16rpx;height:16rpx;border-radius:50%;background:#ffd9e8;border:2rpx solid #a36e89;box-shadow:0 0 0 5rpx #fff9f0}.family-member{position:relative;padding:20rpx 22rpx 10rpx;margin-bottom:12rpx;border-radius:28rpx 38rpx 24rpx 34rpx}.family-member.member-0{background:#fffdf8}.family-member.member-1{background:#f0f5eb}.family-member.member-2{background:#fff4d7}.family-member-tape{position:absolute;top:-8rpx;right:28rpx;width:90rpx;height:22rpx;background:#ffd9e8b3;border:1rpx dashed #ddb2c5;transform:rotate(4deg)}.family-number{display:block;font-size:19rpx;color:#826e80;letter-spacing:2rpx;margin-bottom:12rpx}.family-member-top{display:flex;align-items:center;gap:14rpx}.family-avatar{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:94rpx;height:94rpx;background:#ffd9e8;border:1rpx solid #cba7b9;border-radius:32rpx 42rpx 28rpx 38rpx;overflow:hidden}.family-avatar image{width:100%;height:100%}.family-avatar>text{font-size:36rpx}.family-name{flex:1;min-width:0;display:flex;flex-direction:column;gap:7rpx}.family-name>text:first-child{font-size:32rpx;font-weight:600;word-break:break-all;line-height:1.4}.family-role{align-self:flex-start;padding:4rpx 10rpx;border:1rpx dashed #d2bbc7;border-radius:12rpx 17rpx 10rpx 15rpx;background:#fff9f0;font-size:22rpx;line-height:1.5;word-break:break-all}.family-edit{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:88rpx;height:88rpx;padding:0;font-size:35rpx;color:#854d69;background:#fff9f0b3;border-radius:28rpx}.family-birthday{display:flex;flex-wrap:wrap;align-items:center;gap:6rpx 14rpx;font-size:24rpx;color:#806d7d;border-top:1rpx dashed #dac8d1;padding-top:14rpx;margin-top:16rpx;line-height:1.7}.family-birthday>text+text{font-size:22rpx}.family-birthday.is-today{color:#9c4f70}.family-relation{padding:12rpx 0 4rpx;font-size:24rpx;line-height:1.75;color:#806d7d;word-break:break-all}.family-member-footer{display:flex;align-items:center;justify-content:space-between;gap:6rpx;flex-wrap:wrap;border-top:1rpx dashed #dac8d1;margin-top:14rpx;padding-top:4rpx}.family-order{display:flex;gap:4rpx}.family-order button,.family-remove{display:flex;align-items:center;justify-content:center;min-height:88rpx;min-width:88rpx;padding:10rpx 8rpx;font-size:22rpx;line-height:1.6;color:#806d7d}.family-order button[disabled]{color:#b09ca9}.family-remove{color:#91536d}.family-edit:active,.family-order button:active,.family-remove:active{background:#ffd9e866;transform:scale(.97)}
.family-empty{display:flex;flex-direction:column;align-items:center;gap:20rpx;padding:40rpx 20rpx;font-size:25rpx;color:#806d7d;line-height:1.8}.family-empty-bunny{font-size:50rpx;color:#9c6480}.family-empty .button{font-size:25rpx}.family-footnote{display:flex;flex-direction:column;align-items:center;gap:8rpx;margin:18rpx 0;font-size:22rpx;color:#826e80;text-align:center;line-height:1.8}.family-footnote>text:first-child{font-size:32rpx}
.family-drawer-mask{z-index:1000}.family-drawer{display:flex;flex-direction:column;top:0;bottom:0;height:100%;padding:0;border-radius:30rpx 0 0 0}.family-drawer .drawer-head{flex-shrink:0;padding:18rpx 28rpx}.family-drawer .drawer-head>view{display:flex;flex-direction:column;gap:3rpx;min-width:0}.family-drawer-kicker{font-size:21rpx;color:#826e80}.family-drawer-title{font-size:32rpx;font-weight:600}.family-drawer .close{flex-shrink:0;width:88rpx;height:88rpx}.family-drawer-body{flex:1;height:0;min-height:0;padding:22rpx 28rpx 0}.family-avatar-editor{display:flex;flex-direction:column;align-items:center;gap:10rpx;margin-bottom:16rpx}.family-form-avatar{position:relative;width:124rpx;height:124rpx;padding:0;border-radius:42rpx 52rpx 36rpx 47rpx;background:#ffd9e8;border:1rpx solid #cba7b9;overflow:hidden}.family-form-avatar image{width:100%;height:100%}.family-form-avatar>view{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;font-size:21rpx;color:#854d69}.family-form-avatar>view>text:first-child{font-size:38rpx;line-height:1.1}.avatar-edit-mark{position:absolute;right:4rpx;bottom:4rpx;width:34rpx;height:34rpx;text-align:center;line-height:32rpx;font-size:26rpx;background:#fff9f0;border-radius:50%}.family-avatar-editor>text{font-size:22rpx;color:#826e80}.family-clear-avatar,.family-clear{display:flex;align-items:center;justify-content:center;min-height:88rpx;padding:8rpx;font-size:23rpx;color:#854d69}.family-clear{justify-content:flex-start;padding-left:0}.family-drawer .field{margin:20rpx 0}.family-drawer .field>text{display:block;font-size:25rpx;margin-bottom:10rpx}.required-mark{font-size:20rpx;color:#9c4f70;margin-left:8rpx}.family-picker{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.family-picker>text{color:#826e80}.family-relation-form{padding:18rpx 20rpx 14rpx;margin-top:12rpx;background:#f0f5eb;border:1rpx dashed #b8ccb4;border-radius:24rpx 32rpx 20rpx 28rpx}.family-relation-form-title{display:block;font-size:27rpx}.family-form-note{display:block;font-size:22rpx;color:#826e80;line-height:1.8}.family-save{margin-top:20rpx}.family-drawer-space{height:calc(50rpx + env(safe-area-inset-bottom))}
@media screen and (max-width:340px){.family-heading .title{font-size:38rpx}.family-member{padding:18rpx 18rpx 8rpx}.family-member-top{gap:10rpx}.family-avatar{width:82rpx;height:82rpx}.family-name>text:first-child{font-size:29rpx}.family-role{font-size:21rpx}.family-edit{width:88rpx}.family-opening-stamp{display:none}.family-drawer-title{font-size:29rpx}}
