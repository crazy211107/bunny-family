/* Vant Steps 的流程定位 + Tabs 的显式激活态，使用原生轻量控件。 */
.studio-page{padding-bottom:calc(52rpx + env(safe-area-inset-bottom))}.page-heading{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-bottom:18rpx}.page-heading>view{min-width:0;flex:1}.page-eyebrow{font-size:20rpx;letter-spacing:1rpx;color:#826e80;margin-bottom:6rpx}.page-heading .title{font-size:44rpx;line-height:1.4;letter-spacing:1rpx;transform:rotate(-1deg)}.page-heading .subtitle{font-size:23rpx;line-height:1.7;color:#806d7d;margin-top:6rpx}.page-heading>.text-btn{min-height:88rpx;flex-shrink:0;padding:8rpx 12rpx;font-size:24rpx;color:#854d69}.workshop-steps{display:flex;align-items:center;justify-content:space-between;gap:5rpx;margin-bottom:18rpx;font-size:21rpx;color:#826e80}.step{white-space:nowrap;padding:8rpx 10rpx;line-height:1.5}.workshop-steps .done{color:#526f58}.workshop-steps .active{background:#ffd9e8;border:1rpx solid #cc9bb1;border-radius:18rpx 24rpx 16rpx 22rpx;color:#6b5b73}.step-line{color:#8da58a;font-size:24rpx}
.editor-film{padding:18rpx 20rpx;border-radius:28rpx 38rpx 24rpx 34rpx}.editor-film>.tape{display:none}.preview-top{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.preview-copy{min-width:0;display:flex;flex-direction:column;gap:3rpx}.preview-label{font-size:25rpx;font-weight:600}.preview-meta{font-size:21rpx;line-height:1.6;color:#826e80}.preview-top .text-btn{flex-shrink:0;min-height:88rpx;font-size:23rpx;color:#854d69;padding:6rpx 12rpx}.history-bar{display:flex;align-items:center;flex-wrap:wrap;gap:4rpx;padding-bottom:8rpx;border-bottom:1rpx dashed #ddcbd4;margin-bottom:12rpx}.history-bar .text-btn{min-height:88rpx;padding:8rpx 12rpx;font-size:23rpx;color:#854d69}.history-bar .text-btn[disabled]{color:#aa98a5}.step-count{font-size:20rpx;color:#826e80}.draft-save{margin-left:auto}.canvas-stage{position:relative;display:flex;justify-content:center;padding:14rpx 0;background:#f3eae1;border:1rpx solid #ddcbd4;border-radius:18rpx 24rpx 16rpx 22rpx}.artboard{width:540rpx;height:600rpx;background:#fffbf5;border:1rpx solid #dfcfc3;border-radius:5rpx}.drawing .artboard{border-color:#a56b87}.canvas-note{padding:14rpx 18rpx;margin-top:12rpx;text-align:center;font-size:23rpx;line-height:1.75;color:#854d69;background:#fff0df;border-radius:16rpx}.canvas-note .text-btn{min-height:88rpx;color:#854d69}.rail-caption{display:flex;align-items:center;justify-content:space-between;gap:10rpx;margin-top:16rpx;font-size:22rpx;color:#826e80}.rail-caption>text:first-child{font-size:24rpx;color:#6b5b73}.photo-rail{width:100%;margin-top:10rpx;white-space:nowrap}.rail-inner{display:inline-flex;gap:12rpx;padding:5rpx 4rpx 8rpx}.rail-item{position:relative;flex-shrink:0;width:104rpx;height:112rpx;padding:5rpx;background:#fffdf6;border:1rpx solid #d6c4cd;border-radius:8rpx 12rpx 7rpx 10rpx}.rail-item image{width:100%;height:100%;border-radius:4rpx}.rail-item.selected{border-color:#a46b86;box-shadow:0 0 0 3rpx #ffd9e8}.rail-item.selected::after{content:'✓';position:absolute;right:1rpx;bottom:1rpx;display:flex;align-items:center;justify-content:center;width:30rpx;height:30rpx;background:#ffd9e8;color:#6b5b73;border-radius:50%;font-size:21rpx}.rail-add{display:flex;align-items:center;justify-content:center;font-size:38rpx;color:#854d69;border-style:dashed}.control-pressed{transform:scale(.97);opacity:.85}
.editor-controls{padding:18rpx 20rpx 22rpx}.studio-tabs{display:flex;align-items:center;gap:4rpx;padding:0 0 12rpx;border-bottom:1rpx dashed #ddcbd4}.studio-tab{position:relative;flex:1;min-width:0;display:flex;align-items:center;justify-content:center;min-height:88rpx;font-size:24rpx;color:#806d7d;border-radius:20rpx 26rpx 18rpx 24rpx}.studio-tab.selected{background:#ffd9e8;color:#6b5b73;font-weight:600}.studio-tab.selected::after{content:'';position:absolute;bottom:8rpx;width:24rpx;height:3rpx;border-radius:3rpx;background:#9d6480}.tool-body{padding-top:18rpx}.tool-title{font-size:29rpx;font-weight:600;letter-spacing:1rpx;line-height:1.5;margin-bottom:8rpx}.tool-body .muted{font-size:23rpx;color:#806d7d;line-height:1.8}.tool-subtitle{font-size:25rpx;color:#806d7d;margin:8rpx 0 12rpx}.template-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10rpx;margin-top:16rpx}.template-item{display:flex;flex-direction:column;align-items:center;gap:8rpx;padding:6rpx 5rpx 10rpx;border:1rpx solid transparent;border-radius:12rpx;min-width:0;min-height:150rpx}.template-item.selected{background:#fff0f6;border-color:#a46b86;box-shadow:0 3rpx 0 #d9acc033}.template-art{position:relative;width:100%;height:108rpx;display:flex;align-items:center;justify-content:center;overflow:hidden;border:1rpx solid #d9c7d1;border-radius:5rpx}.template-photo{width:86%;height:74%;border-radius:3rpx}.template-badge{position:absolute;right:3rpx;bottom:3rpx;padding:1rpx 5rpx;font-size:17rpx;background:#fff9f0ee;border-radius:4rpx}.template-name{font-size:21rpx;color:#806d7d;line-height:1.5}.template-item.selected .template-name{font-weight:600;color:#6b5b73}.sub-block{margin-top:20rpx;padding-top:16rpx;border-top:1rpx dashed #ddcbd4}.slot-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10rpx}.slot{display:flex;flex-direction:column;align-items:center;gap:6rpx;padding:5rpx;background:#fffdf6;border:1rpx solid #d6c4cd;border-radius:7rpx}.slot image{width:100%;height:112rpx;border-radius:4rpx}.slot text{font-size:20rpx;line-height:1.5}.picker-arrow{float:right;color:#826e80;margin-left:10rpx}.sticker-tray{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10rpx;margin:16rpx 0}.sticker-chip{display:flex;align-items:center;justify-content:center;min-width:0;min-height:96rpx;padding:10rpx 4rpx;font-size:23rpx;background:#f8e9ef;border:1rpx solid #d5b9ca;border-radius:20rpx 26rpx 18rpx 24rpx}.sticker-chip:active{background:#c9e7d3}.adjust-block{margin-top:12rpx}.sticker-tip{padding:18rpx;font-size:23rpx;color:#806d7d;line-height:1.8;background:#fff2df;border-radius:18rpx}.small-action{min-height:88rpx;margin-top:16rpx;font-size:24rpx}.tone-slider{margin:0 0 12rpx}.brush-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10rpx;margin:16rpx 0}.brush-chip{display:flex;align-items:center;justify-content:center;min-height:88rpx;padding:8rpx 4rpx;font-size:23rpx;background:#fff9f0;border:1rpx solid #d5b9ca;border-radius:20rpx 26rpx 18rpx 24rpx}.brush-chip.selected{background:#c9e7d3;border-color:#8da993;font-weight:600}.color-row{display:flex;align-items:center;justify-content:space-between;gap:8rpx;margin:8rpx 0 18rpx}.color-dot{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;flex-shrink:0;padding:0;border-radius:50%;border:12rpx solid #fff9f0;box-shadow:0 0 0 1rpx #d9c7d1}.color-dot.selected{box-shadow:0 0 0 3rpx #98617a}.color-dot>text{display:flex;align-items:center;justify-content:center;width:34rpx;height:34rpx;font-size:23rpx;line-height:1;background:#fff9f0e6;color:#6b5b73;border-radius:50%}.tone-row{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:6rpx}.tone-value{font-size:23rpx;color:#854d69}.tool-body .field-label{font-size:23rpx;color:#806d7d}.input-counter{margin-top:6rpx;font-size:21rpx;color:#826e80;text-align:right}.tool-body .tiny,.editor-save .tiny{font-size:21rpx;color:#826e80;line-height:1.8}.editor-save{margin-top:20rpx;padding-top:18rpx;border-top:1rpx dashed #ddcbd4}.editor-save .save-btn{margin:0 0 12rpx;background:#ffd9e8;border-color:#c18aa5}.png-action{margin-top:12rpx}.editor-save .tiny{margin-top:12rpx;text-align:center}
.studio-page>.section-title{font-size:30rpx;letter-spacing:1rpx;margin:24rpx 0 16rpx}.draft-count{display:inline-block;font-size:23rpx;color:#854d69;margin-left:8rpx;padding:1rpx 12rpx;background:#ffd9e8;border-radius:14rpx}.draft-row{display:flex;align-items:center;gap:12rpx;padding:14rpx 18rpx;margin-bottom:12rpx}.draft-open{flex:1;min-width:0;display:flex;flex-direction:column;justify-content:center;gap:5rpx;min-height:88rpx}.draft-name{font-size:26rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.draft-open .tiny{font-size:21rpx;color:#826e80}.draft-remove{flex-shrink:0;display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;padding:0;font-size:32rpx;color:#975d78;background:#fff0f5;border-radius:26rpx}
@media screen and (max-width:340px){.page-heading{align-items:flex-start;gap:8rpx}.page-heading .title{font-size:40rpx}.page-heading>.text-btn{padding:8rpx;font-size:22rpx}.page-eyebrow{font-size:19rpx;letter-spacing:0}.step{padding:8rpx 4rpx;font-size:20rpx}.history-bar{gap:0}.history-bar .text-btn{padding:8rpx;font-size:22rpx}.step-count{font-size:18rpx}.studio-tab{font-size:22rpx}.template-name{font-size:20rpx}.sticker-tray,.brush-row{grid-template-columns:repeat(2,minmax(0,1fr))}.rail-caption{flex-wrap:wrap}.color-row{gap:5rpx}.color-dot{width:88rpx;height:88rpx;border-width:13rpx}}
