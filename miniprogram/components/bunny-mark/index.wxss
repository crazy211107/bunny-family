:host{display:inline-block;width:80rpx;height:88rpx}.bunny{width:80rpx;height:88rpx;position:relative;color:#6b5b73}.ear{position:absolute;top:0;width:22rpx;height:55rpx;background:#fff9f0;border:3rpx solid #6b5b73;border-radius:60%;z-index:0}.ear.left{left:17rpx;transform:rotate(-16deg)}.ear.right{right:17rpx;transform:rotate(16deg)}.ear>view{width:6rpx;height:31rpx;background:#f5bdd2;border-radius:50%;margin:9rpx auto}.face{position:absolute;left:4rpx;bottom:1rpx;width:72rpx;height:57rpx;background:#fff9f0;border:3rpx solid #6b5b73;border-radius:45% 46% 40% 43%}.eye{position:absolute;top:22rpx;width:5rpx;height:6rpx;border-radius:50%;background:#6b5b73}.eye.one{left:20rpx}.eye.two{right:20rpx}.blush{position:absolute;top:32rpx;width:12rpx;height:5rpx;border-radius:50%;background:#ffd9e8}.blush.one{left:9rpx}.blush.two{right:9rpx}.nose{position:absolute;left:27rpx;top:26rpx;font-size:22rpx;line-height:22rpx}.small{transform:scale(.75);transform-origin:center}
