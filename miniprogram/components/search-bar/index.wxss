
.search-bar{display:flex;align-items:center;gap:16rpx;min-height:44px;width:100%;padding:0 4rpx 0 22rpx;box-sizing:border-box;background:#fffdf8;border:1rpx solid #deccd6;border-radius:16rpx}.search-bar:focus-within{border-color:#875873;box-shadow:0 0 0 3rpx #ffd9e8}.search-icon{position:relative;flex-shrink:0;width:12px;height:12px;border:1.5px solid #806c7b;border-radius:50%;margin-right:6px;box-sizing:border-box}.search-icon::after{content:'';position:absolute;right:-5px;bottom:-3px;width:6px;height:1.5px;background:#806c7b;transform:rotate(45deg);border-radius:2px}.search-input{flex:1;min-width:0;height:44px;font-family:var(--font-body);font-size:13px;line-height:1.6;color:#6b5b73;background:transparent}.search-placeholder{color:#806c7b}.search-clear{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:44px;height:44px;min-width:44px;margin:0;padding:0;border:0;border-radius:12rpx;font-size:22px;line-height:1;color:#875873;background:transparent}.search-clear::after{border:0}.search-clear:focus{outline:2px solid #875873;outline-offset:-3px}.search-pressed{background:#ffd9e8}
