.search-bar{display:flex;align-items:center;gap:18rpx;width:100%;min-height:92rpx;padding:0 8rpx 0 24rpx;box-sizing:border-box;background:#fffcf5;border:1rpx solid #d6c1cd;border-radius:24rpx 30rpx 22rpx 28rpx}.search-icon{position:relative;flex:0 0 auto;width:25rpx;height:25rpx;border:3rpx solid #806579;border-radius:50%;margin-right:7rpx;box-sizing:border-box}.search-icon::after{content:'';position:absolute;width:13rpx;height:3rpx;background:#806579;transform:rotate(45deg);right:-10rpx;bottom:-5rpx;border-radius:3rpx}.search-input{min-width:0;flex:1;height:88rpx;font-size:26rpx;line-height:1.6;color:#6b5b73;background:transparent}.search-placeholder{color:#806c7b}.search-clear{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;flex:0 0 auto;font-size:34rpx;color:#875873;border-radius:24rpx}.search-pressed{background:#ffd9e8;transform:scale(.96)}
