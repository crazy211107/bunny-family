  padding: 6rpx 8rpx;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  font-size: 28rpx;
  line-height: 1.65;
  color: #6b5b73;
}
.ai-placeholder {
  color: #806c7b;
}
.ai-compose-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  min-height: 84rpx;
  gap: 14rpx;
}
.ai-input-tools {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}
.ai-send {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  min-height: 84rpx;
  padding: 0;
  margin: 0;
  border: 1rpx solid #afcbb8;
  border-radius: 25rpx;
  background: #c9e7d3;
  color: #6b5b73;
}
.ai-send image {
