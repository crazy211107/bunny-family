
:host {
  color: #6b5b73;
  font-family: "YouYuan","Microsoft YaHei",sans-serif;
  font-size: 26rpx;
  line-height: 1.65;
}
view,scroll-view,input,textarea,button,image {
  box-sizing: border-box;
}
button {
  margin: 0;
  padding: 0;
  color: #6b5b73;
  font: inherit;
  background: none;
  border-radius: 0;
  line-height: 1.5;
}
button::after {
  border: 0;
}
button[disabled] {
  opacity: .45;
}
image {
  display: block;
}
.ai-float {
  position: fixed;
  z-index: 950;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff9f0;
  border-radius: 30% 38% 28% 35%;
  background: #ffd9e8;
  box-shadow: 0 0 0 1rpx #bf96ab,0 7rpx 16rpx #6b5b7320;
  color: #6b5b73;
}
.ai-float-symbol {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: 1rpx;
}
.ai-float-caption {
  font-size: 19rpx;
  line-height: 1.25;
  margin-top: 3rpx;
}
.ai-ear {
  position: absolute;
  top: -22rpx;
  width: 22rpx;
  height: 40rpx;
  border: 4rpx solid #fff9f0;
  border-bottom: 0;
  border-radius: 50%;
  background: #ffd9e8;
  z-index: -1;
}
.ai-ear-left {
  left: 15rpx;
  transform: rotate(-14deg);
}
.ai-ear-right {
  right: 15rpx;
  transform: rotate(14deg);
}
.ai-float-collapsed {
  border-radius: 50%;
  background: #c9e7d3;
  transform: scale(.78);
}
.ai-float-collapsed .ai-float-symbol {
  font-size: 25rpx;
}
.ai-pressed {
  opacity: .82;
  transform: scale(.97);
}
.ai-overlay {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 1300;
  display: flex;
  flex-direction: column;
  background: #fff9f0;
  overflow: hidden;
  box-shadow: 0 0 0 100vh #fff9f0;
}
.ai-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 10rpx 26rpx 14rpx;
  border-bottom: 1rpx solid #e1ced8;
  flex-shrink: 0;
}
.ai-brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}
.ai-brand>view:last-child {
  display: flex;
  flex-direction: column;
  gap: 1rpx;
  min-width: 0;
}
.ai-brand-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 76rpx;
  background: #ffd9e8;
  border: 1rpx solid #d7aabd;
  border-radius: 24rpx 31rpx 21rpx 28rpx;
  font-size: 27rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.ai-brand-name {
  font-size: 31rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.ai-brand-note {
  font-size: 21rpx;
  color: #806c7b;
}
.ai-close,.ai-icon-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  font-size: 35rpx;
  border-radius: 27rpx;
  background: #fff0f6;
  color: #87516c;
}
.ai-text-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  min-width: 72rpx;
  padding: 8rpx 12rpx;
  color: #87516c;
  font-size: 23rpx;
  line-height: 1.5;
  flex-shrink: 0;
  border-radius: 18rpx;
}
.ai-messages {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 22rpx 26rpx 0;
}
.ai-welcome {
  padding: 10rpx 6rpx 18rpx;
}
.ai-prompt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  min-height: 88rpx;
  padding: 16rpx 20rpx;
  margin: 12rpx 0;
  background: #fffcf6;
  border: 1rpx solid #ddc9d4;
  border-radius: 22rpx 29rpx 19rpx 26rpx;
  font-size: 25rpx;
}
.ai-prompt>text:last-child {
  color: #9d6982;
}
.ai-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 18rpx 22rpx;
  background: #fffcf6;
  border: 1rpx solid #cdb6c5;
  border-radius: 25rpx 33rpx 22rpx 30rpx;
  font-size: 26rpx;
  line-height: 1.5;
}
.ai-button-pink {
  background: #ffd9e8;
  border-color: #c18aa5;
}
.ai-button-mint {
  background: #c9e7d3;
  border-color: #a6c3ac;
}
.ai-message {
  margin-bottom: 24rpx;
}
.ai-message-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 21rpx;
  color: #806c7b;
  padding: 0 4rpx;
  margin-bottom: 8rpx;
}
.ai-message-user .ai-message-meta {
  justify-content: flex-end;
}
.ai-bubble {
  padding: 20rpx 22rpx;
  border: 1rpx solid #deccd6;
  border-radius: 8rpx 28rpx 24rpx 27rpx;
  background: #fffcf6;
  font-size: 26rpx;
  line-height: 1.9;
  word-break: break-all;
  min-width: 0;
}
.ai-message-user {
  padding-left: 58rpx;
}
.ai-message-user .ai-bubble {
  background: #ffdfe9;
  border-color: #e0b9ca;
  border-radius: 26rpx 8rpx 24rpx 28rpx;
}
.ai-user-text {
  white-space: pre-wrap;
}
.ai-md {
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
  line-height: 1.9;
}
.ai-md-heading {
  font-size: 28rpx;
  font-weight: 600;
  margin: 12rpx 0 6rpx;
}
.ai-md-heading:first-child {
  margin-top: 0;
}
.ai-md-bullet {
  margin: 7rpx 0;
  padding-left: 3rpx;
}
.ai-md-quote {
  border-left: 5rpx solid #b8cfb2;
  background: #f0f5eb;
  padding: 10rpx 14rpx;
  font-size: 24rpx;
  color: #67745e;
  margin: 10rpx 0;
}
.ai-md-code {
  padding: 16rpx;
  margin: 12rpx 0;
  background: #f2e9e1;
  border: 1rpx solid #dfcec3;
  border-radius: 13rpx;
  font-family: monospace;
  font-size: 23rpx;
  white-space: pre-wrap;
  word-break: break-all;
}
.ai-md-space {
  height: 10rpx;
  line-height: 10rpx;
}
.ai-streaming {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 44rpx;
  color: #87516c;
  font-size: 23rpx;
  margin-top: 6rpx;
}
.ai-stream-dot {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #b07996;
  animation: ai-breathe 1.2s ease infinite;
}
.ai-message-status {
  padding-top: 10rpx;
  margin-top: 10rpx;
  border-top: 1rpx dashed #ddc9d4;
  font-size: 22rpx;
  color: #806c7b;
}
.ai-message-error {
  color: #933e60;
}
.ai-source-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 10rpx;
  font-size: 19rpx;
  color: #806c7b;
}
.ai-source-tag {
  padding: 3rpx 9rpx;
  background: #eef4e9;
  border-radius: 9rpx;
  color: #5a735d;
  font-size: 20rpx;
}
.ai-message-actions {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-wrap: wrap;
}
.ai-message-actions .ai-text-action {
  min-height: 72rpx;
  font-size: 22rpx;
  padding: 6rpx 12rpx;
}
.ai-image-retry {
  font-size: 21rpx;
  color: #87516c;
  line-height: 1.75;
}
.ai-scroll-end {
  height: 4rpx;
}
.ai-latest {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #87516c;
  background: #fff0f6;
  flex-shrink: 0;
}
.ai-feedback,.ai-notice {
  padding: 12rpx 20rpx;
  font-size: 22rpx;
  line-height: 1.65;
  word-break: break-all;
  flex-shrink: 0;
  max-height: 160rpx;
  overflow: auto;
}
.ai-feedback {
  color: #8f385b;
  background: #ffe5ed;
  border-left: 5rpx solid #bd6c8f;
}
.ai-notice {
  color: #806c7b;
  background: #fff3d7;
  border-top: 1rpx dashed #ddc58d;
}
.ai-composer {
  padding: 8rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #ddc9d4;
  background: #fff9f0;
  flex-shrink: 0;
}
.ai-compose-row {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
}
.ai-question {
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  max-height: 200rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #ccb4c2;
  border-radius: 24rpx 30rpx 20rpx 27rpx;
  background: #fffdf7;
  color: #6b5b73;
  font-size: 27rpx;
  line-height: 1.65;
}
.ai-placeholder {
  color: #9c8394;
}
.ai-send {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 132rpx;
  min-height: 88rpx;
  padding: 14rpx 8rpx;
  background: #c9e7d3;
  border: 1rpx solid #a1bda5;
  border-radius: 24rpx 30rpx 20rpx 27rpx;
  font-size: 26rpx;
}
.ai-stop {
  background: #ffd9e8;
  border-color: #c895ad;
}
.ai-attachment {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 8rpx 0;
  padding: 10rpx;
  background: #f8eaf0;
  border: 1rpx solid #e0c6d3;
  border-radius: 18rpx;
}
.ai-attachment>image {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.ai-attachment>view:nth-child(2) {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  flex: 1;
}
.ai-attachment>view:nth-child(2)>text:first-child {
  font-size: 23rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ai-attachment>view:nth-child(2)>text:last-child {
  font-size: 20rpx;
  color: #806c7b;
}
.ai-attachment .ai-icon-action {
  width: 76rpx;
  height: 88rpx;
}
.ai-subbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
  padding: 0 20rpx;
  border-bottom: 1rpx dashed #ddc9d4;
  flex-shrink: 0;
}
.ai-subbar>text {
  font-size: 21rpx;
  color: #806c7b;
}
.ai-subscroll {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 22rpx 26rpx calc(44rpx + env(safe-area-inset-bottom));
}
.ai-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  text-align: center;
  padding: 60rpx 20rpx;
}
.ai-empty>text:first-child {
  font-size: 60rpx;
  color: #a56c86;
}
.ai-empty>text:nth-child(2) {
  font-size: 31rpx;
}
.ai-empty>text:nth-child(3) {
  font-size: 24rpx;
  line-height: 1.8;
  color: #806c7b;
}
.ai-history-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 14rpx;
  background: #fffcf6;
  border: 1rpx solid #ddc9d4;
  border-radius: 22rpx 30rpx 18rpx 26rpx;
}
.ai-history-current {
  background: #edf4e8;
  border-color: #a8c4ac;
}
.ai-history-open {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: center;
  flex-direction: column;
  gap: 7rpx;
  min-height: 104rpx;
}
.ai-history-open>text:first-child {
  font-size: 27rpx;
  word-break: break-all;
}
.ai-history-open>text:last-child {
  font-size: 21rpx;
  color: #806c7b;
}
.ai-info-paper {
  padding: 20rpx 22rpx;
  margin-bottom: 20rpx;
  background: #fff1cf;
  border: 1rpx solid #ddc58d;
  border-radius: 10rpx 28rpx 16rpx 24rpx;
}
.ai-section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.6;
}
.ai-domain {
  display: block;
  font-size: 27rpx;
  color: #6d6148;
  word-break: break-all;
  margin: 8rpx 0;
}
.ai-help {
  display: block;
  font-size: 23rpx;
  line-height: 1.85;
  color: #806c7b;
  margin: 10rpx 0;
}
.ai-preview-sources {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 18rpx;
}
.ai-preview-source {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 12rpx 16rpx;
  background: #f1e9e4;
  border-radius: 12rpx;
  font-size: 23rpx;
  color: #806c7b;
}
.ai-preview-included {
  background: #e7f1e4;
  color: #4f6a55;
}
.ai-preview-source>text:last-child {
  flex-shrink: 0;
  font-size: 21rpx;
}
.ai-context-text {
  display: block;
  white-space: pre-wrap;
  word-break: break-all;
  padding: 20rpx;
  background: #fffcf6;
  border: 1rpx solid #ddc9d4;
  border-radius: 16rpx;
  font-family: monospace;
  font-size: 22rpx;
  line-height: 1.85;
}
.ai-warning {
  padding: 16rpx;
  background: #ffe5ed;
  border-radius: 12rpx;
  font-size: 23rpx;
  color: #8f385b;
  margin: 14rpx 0;
}
.ai-setting-card {
  padding: 20rpx 22rpx;
  margin: 20rpx 0;
  background: #fffcf6;
  border: 1rpx solid #ddc9d4;
  border-radius: 24rpx 34rpx 20rpx 30rpx;
}
.ai-modes {
  display: flex;
  gap: 10rpx;
  margin: 16rpx 0;
}
.ai-mode {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 12rpx 8rpx;
  border: 1rpx solid #d3b9c9;
  border-radius: 22rpx 28rpx 18rpx 25rpx;
  font-size: 23rpx;
  background: #fff9f0;
}
.ai-selected {
  border-color: #aa748e;
  background: #ffd9e8;
  color: #6b5b73;
}
.ai-field {
  margin: 20rpx 0;
}
.ai-field>text {
  display: block;
  font-size: 24rpx;
  margin-bottom: 10rpx;
  color: #6b5b73;
}
.ai-field-hint {
  font-size: 20rpx;
  color: #806c7b;
  margin-left: 8rpx;
}
.ai-input {
  display: block;
  width: 100%;
  min-height: 88rpx;
  padding: 18rpx 20rpx;
  background: #fffaf2;
  border: 1rpx solid #d3b9c9;
  border-radius: 20rpx 27rpx 18rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6b5b73;
}
.ai-secret-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.ai-secret-row .ai-input {
  flex: 1;
  min-width: 0;
}
.ai-secret-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
  font-size: 23rpx;
  color: #87516c;
}
.ai-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx dashed #e2d2dc;
}
.ai-switch-row>view {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}
.ai-switch-row>view>text:first-child {
  font-size: 25rpx;
}
.ai-switch-row>view>text:last-child {
  font-size: 22rpx;
  color: #806c7b;
  line-height: 1.75;
}
.ai-switch-row>switch {
  flex-shrink: 0;
  transform: scale(.9);
  transform-origin: right center;
}
.ai-key-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  flex-wrap: wrap;
}
.ai-key-actions .ai-text-action {
  font-size: 22rpx;
  padding-left: 0;
}
.ai-section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  flex-wrap: wrap;
}
.ai-scope-grid {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 10rpx;
  margin: 16rpx 0;
}
.ai-scope {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 88rpx;
  min-width: 0;
  padding: 12rpx;
  border: 1rpx solid #d3b9c9;
  border-radius: 18rpx 24rpx 15rpx 21rpx;
  background: #fff9f0;
  font-size: 23rpx;
}
.ai-scope.ai-selected {
  background: #eef4e9;
  border-color: #aac3a9;
}
.ai-checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  border: 1rpx solid #aa748e;
  border-radius: 7rpx;
  background: #fffcf6;
  font-size: 22rpx;
  color: #5a735d;
}
.ai-form-grid {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 16rpx;
}
.ai-form-grid .ai-field {
  min-width: 0;
}
.ai-system-input {
  height: 200rpx;
  font-size: 25rpx;
  line-height: 1.8;
}
.ai-save {
  width: 100%;
  margin-top: 20rpx;
}
.ai-settings-foot {
  text-align: center;
  font-size: 22rpx;
  line-height: 1.8;
  color: #806c7b;
  padding: 16rpx 0 24rpx;
}
@keyframes ai-breathe{
0%,100% {
  opacity: .4;
}
50% {
  opacity: 1;
}}@media(max-width:340px){
.ai-header {
  padding-left: 20rpx;
  padding-right: 20rpx;
}
.ai-brand-name {
  font-size: 29rpx;
}
.ai-brand-note {
  font-size: 20rpx;
}
.ai-messages,.ai-subscroll {
  padding-left: 20rpx;
  padding-right: 20rpx;
}
.ai-composer {
  padding-left: 16rpx;
  padding-right: 16rpx;
}
.ai-send {
  width: 116rpx;
}
.ai-bubble {
  font-size: 25rpx;
  padding: 18rpx;
}
.ai-scope-grid {
  grid-template-columns: 1fr;
}
.ai-form-grid {
  gap: 10rpx;
}
.ai-form-grid .ai-input {
  padding-left: 12rpx;
  padding-right: 12rpx;
}
.ai-setting-card {
  padding: 18rpx;
}}
@media(min-width:600px){
.ai-overlay {
  max-width: 600px;
  left: auto;
  border-left: 1rpx solid #d3b9c9;
  box-shadow: -30px 0 100px #6b5b7326;
}
.ai-float {
  max-width: 58px;
  max-height: 58px;
}}@media(prefers-reduced-motion:reduce){
.ai-stream-dot {
  animation: none;
}
.ai-pressed {
  transform: none;
}}
.ai-keyboard .ai-privacy,.ai-keyboard .ai-brand-note {
  display: none;
}
.ai-keyboard .ai-header {
  padding-top: 0;
  padding-bottom: 4rpx;
}
.ai-keyboard .ai-question {
  max-height: 140rpx;
}
.ai-keyboard .ai-notice,.ai-keyboard .ai-feedback {
  max-height: 100rpx;
}
.ai-keyboard .ai-composer {
  padding-bottom: 12rpx;
}
.ai-float-collapsed {
  background: transparent;
  border-color: transparent;
  box-shadow: none;
  transform: none;
}
.ai-float-collapsed::before {
  content: "";
  position: absolute;
  inset: 5px;
  border: 1rpx solid #a5c1aa;
  border-radius: 50%;
  background: #c9e7d3;
  box-shadow: 0 3rpx 9rpx #6b5b731a;
}
.ai-float-collapsed .ai-float-symbol {
  position: relative;
  z-index: 1;
}
.ai-window-note {
  text-align: center;
  font-size: 22rpx;
  color: #806c7b;
  padding: 18rpx 12rpx;
}
.ai-inline-bold {
  font-weight: 600;
}
