  background: #805a73;
}
.ai-history-preview {
  margin: 22rpx 0 28rpx;
  padding: 20rpx;
  border: 1rpx dashed #d6bccb;
  border-radius: 20rpx;
  background: #fffdf8;
}
.ai-history-excerpt {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #eee1e5;
}
.ai-history-excerpt>text {
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
  font-size: 24rpx;
  line-height: 1.8;
}
.ai-history-excerpt .ai-history-speaker {
  margin-bottom: 7rpx;
  font-size: 21rpx;
  font-weight: 600;
  color: #805a73;
}
.ai-float {
  flex-direction: row;
  padding: 0 10rpx 0 4rpx;
  background: #fff9f0;
  border: 1rpx solid #cdaebe;
  border-radius: 26rpx 34rpx 12rpx 29rpx;
  box-shadow: 0 6rpx 0 #b99aac1f,0 9rpx 23rpx #6b5b7312;
  max-width: none;
  max-height: none;
}
.ai-float-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
  width: 74rpx;
  height: 86rpx;
  flex-shrink: 0;
}
.ai-float-words {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding-right: 5rpx;
}
.ai-float-words>text:first-child {
  font-size: 27rpx;
  font-weight: 600;
}
.ai-float-words>text:last-child {
  font-size: 17rpx;
  color: #806c7b;
}
.ai-float-collapsed {
  padding: 0;
  background: transparent;
  border-color: transparent;
  box-shadow: none;
}
.ai-float-dot {
  position: absolute;
  top: 5rpx;
  right: 6rpx;
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid #fff9f0;
  background: #c9e7d3;
  border-radius: 50%;
}
.ai-pressed {
  background-color: #f1e6ed;
  opacity: .85;
  transform: translateY(1rpx);
}
button:focus-visible, textarea:focus-visible, input:focus-visible {
  outline: 3rpx solid #9d6c89;
  outline-offset: 4rpx;
}
.ai-compose-card:focus-within {
  border-color: #af829c;
  box-shadow: 0 0 0 4rpx #f3e4ec;
}
.ai-keyboard .ai-context-strip {
  display: none;
}
.ai-keyboard .ai-question {
  min-height: 56rpx;
  max-height: 120rpx;
}
.ai-keyboard .ai-compose-card {
  padding-top: 10rpx;
  padding-bottom: 8rpx;
}
@media(max-width:340px) {
.ai-header {
  padding-left: 10rpx;
  padding-right: 14rpx;
}
.ai-brand-note {
  font-size: 18rpx;
}
.ai-messages {
  padding-left: 20rpx;
  padding-right: 20rpx;
}
.ai-bubble {
  padding: 22rpx;
}
.ai-composer {
  padding-left: 18rpx;
  padding-right: 18rpx;
}
}
@media(prefers-reduced-motion:reduce) {
.ai-stream-dot {
  animation: none;
}
.ai-pressed {
  transform: none;
}
button, textarea {
  transition: none;
}
}
/* 可用性校正：两项主操作，44px触区，更多菜单不覆盖Header。 */
.ai-header { position: relative; z-index: 3; flex-shrink: 0; min-height: 56px; padding: 4px 10px; gap: 4px; background: #fff9f0; border-bottom: 1px solid #ebdfe4; }
.ai-back,.ai-close,.ai-more { width: 44px; height: 44px; min-width: 44px; min-height: 44px; padding: 0; margin: 0; border-radius: 14px; background: transparent; color: #6b5b73; }
.ai-more { font-size: 25px; line-height: 1; font-weight: 600; }
.ai-brand { flex: 1; min-width: 0; gap: 5px; }
.ai-brand>view:last-child { min-width: 0; }
.ai-brand-icon { width: 30px; height: 35px; flex-shrink: 0; }
.ai-brand-name { font-size: 16px; line-height: 1.4; letter-spacing: 0; }
.ai-brand-note { display: block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; line-height: 1.5; }
.ai-new-chat { display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin: 0; padding: 0 11px; min-width: 78px; min-height: 44px; border: 1px solid #dfb9cb; border-radius: 14px; background: #ffe3ed; color: #6b5b73; font-size: 13px; line-height: 1.5; }
.ai-new-chat.ai-pressed { background: #ffd9e8; }
.ai-menu { position: absolute; top: 100%; right: 12px; z-index: 4; width: 224px; max-width: calc(100% - 24px); padding: 5px; border: 1px solid #e3cad7; border-radius: 16px; background: #fffdf8; box-shadow: 0 8px 24px #6b5b731a; }
.ai-menu-item { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 44px; margin: 0; padding: 10px 13px; border-radius: 11px; background: transparent; color: #6b5b73; font-size: 14px; line-height: 1.6; text-align: left; }
.ai-menu-item>text { color: #806c7b; }
.ai-messages { position: relative; z-index: 0; padding: 16px 14px 0; }
.ai-welcome-simple { display: flex; flex-direction: column; align-items: stretch; padding: 26px 10px 20px; }
.ai-empty-mark { display: flex; justify-content: center; align-items: center; width: 48px; height: 52px; margin: 0 auto 14px; }
.ai-empty-title { display: block; text-align: center; font-family: YouYuan,KaiTi,STKaiti,sans-serif; font-size: 21px; line-height: 1.6; font-weight: 600; }
.ai-empty-copy { display: block; margin: 5px 0 22px; text-align: center; color: #806c7b; font-size: 13px; line-height: 1.8; }
.ai-prompt { display: flex; justify-content: space-between; align-items: center; width: 100%; min-height: 44px; margin: 0 0 9px; padding: 12px 14px; border: 1px solid #e6ceda; border-radius: 15px; background: #fffdf8; font-size: 13px; line-height: 1.7; color: #6b5b73; text-align: left; transform: none; }
.ai-connect-guide { display: flex; flex-direction: column; gap: 12px; padding: 14px; border: 1px dashed #dfcad5; border-radius: 16px; background: #fffdf8; }
.ai-connect-guide>text { font-size: 13px; line-height: 1.8; color: #806c7b; text-align: center; }
.ai-connect-guide .ai-button { min-height: 44px; font-size: 14px; padding: 10px 16px; }
.ai-message { margin-bottom: 22px; }
.ai-bubble { box-shadow: none; border-color: #eadfe1; }
.ai-md,.ai-user-text,.ai-question { font-size: 14px; line-height: 1.85; }
.ai-md-heading { font-size: 16px; }
.ai-message-actions { justify-content: flex-end; min-height: 44px; gap: 4px; }
.ai-message-copy,.ai-code-copy { min-height: 44px; min-width: 44px; font-size: 12px; }
.ai-user-copy { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; min-width: 44px; min-height: 44px; padding: 0; margin: 0; border-radius: 12px; background: transparent; }
.ai-user-copy image { width: 14px; height: 14px; }
.ai-user-copy.ai-pressed { background: #f6e7ee; }
.ai-earlier { display: flex; align-items: center; justify-content: center; min-height: 44px; width: 100%; margin: 0 0 12px; padding: 10px; border-radius: 12px; border: 1px dashed #ddcbd5; background: #fffdf8; color: #806c7b; font-size: 12px; line-height: 1.6; }
.ai-latest { align-self: center; min-height: 44px; min-width: 44px; margin: 0 0 6px; padding: 8px 14px; border: 1px solid #dbc5d2; border-radius: 16px; color: #6b5b73; background: #fffdf8; font-size: 12px; }
.ai-composer { position: relative; z-index: 1; padding: 8px 12px calc(8px + env(safe-area-inset-bottom)); background: #fff9f0; border-top: 1px solid #eee3e6; }
.ai-compose-card { padding: 9px 12px 8px; border: 1px solid #d9bdcd; border-radius: 19px; box-shadow: none; }
.ai-question { min-height: 42px; max-height: 132px; padding: 4px 2px; }
.ai-compose-row { min-height: 44px; gap: 8px; }
.ai-attach-button { display: flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; padding: 0; margin: 0; background: transparent; color: #806c7b; font-size: 27px; line-height: 1; border-radius: 13px; }
.ai-send { width: 44px; height: 44px; min-width: 44px; min-height: 44px; border-radius: 14px; }
.ai-send image { width: 22px; height: 22px; }
.ai-disclosure { display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; min-height: 44px; margin: 0; padding: 10px 0; color: #6b5b73; background: transparent; font-size: 14px; line-height: 1.7; text-align: left; }
.ai-disclosure>text { flex-shrink: 0; color: #806c7b; font-size: 12px; }
.ai-history-preview { padding: 12px; margin-top: 14px; }
.ai-text-action { min-height: 44px; min-width: 44px; }
.ai-keyboard .ai-brand-note { display: block; }
.ai-keyboard .ai-header { padding-top: 4px; padding-bottom: 4px; }
.ai-keyboard .ai-question { min-height: 36px; max-height: 100px; }
.ai-keyboard .ai-composer { padding-bottom: 6px; }
@media(max-width:350px) { .ai-brand-icon { display: none; } .ai-header { padding-left: 6px; padding-right: 6px; } .ai-new-chat { min-width: 74px; padding-left: 9px; padding-right: 9px; } .ai-messages { padding-left: 10px; padding-right: 10px; } }



/* 最新消息按钮脱离文档流：显隐不改变滚动区高度。 */
.ai-conversation { position: relative; flex: 1; min-height: 0; overflow: hidden; width: 100%; }
.ai-conversation .ai-messages { position: absolute; top: 0; left: 0; right: 0; bottom: 0; width: 100%; height: 100%; min-height: 0; }
.ai-conversation .ai-latest { position: absolute; z-index: 2; left: 50%; bottom: 10px; transform: translateX(-50%); margin: 0; box-shadow: 0 3px 12px #6b5b7312; }
.ai-conversation .ai-latest.ai-pressed { transform: translateX(-50%); }
