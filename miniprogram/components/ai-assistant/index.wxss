/* 豆伴 · 小窝信笺
   与家庭手账共用奶油/粉/绿；正文用清晰系统字，手写只留给品牌。
   全部样式位于原生组件内，不依赖 React、外部字体或远程 CSS。 */
:host {
  --ai-paper: #fff9f0;
  --ai-surface: #fffdf8;
  --ai-ink: #6b5b73;
  --ai-muted: #756272;
  --ai-line: #e2d1da;
  --ai-pink: #ffd9e8;
  --ai-mint: #c9e7d3;
  --ai-action: #875873;
  --ai-display: YouYuan,STKaiti,KaiTi,serif;
  --ai-body: -apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;
  font-family: var(--ai-body);
  font-size: 14px;
  line-height: 1.7;
  color: var(--ai-ink);
}
.ai-v,.ai-scroll,.ai-in,.ai-ta,.ai-btn,.ai-img {
  box-sizing: border-box;
}
.ai-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--ai-ink);
  font-family: var(--ai-body);
  font-size: 14px;
  font-weight: 400;
  line-height: 1.5;
  border-radius: 10px;
  transition: background .12s ease,opacity .12s ease;
}
.ai-btn::after {
  border: 0;
}
.ai-btn.ai-disabled {
  opacity: .42;
  box-shadow: none;
}
.ai-btn:focus,.ai-btn:focus-visible {
  outline: 2px solid var(--ai-action);
  outline-offset: 2px;
}
.ai-in,.ai-ta {
  font-family: var(--ai-body);
  color: var(--ai-ink);
}
.ai-img {
  display: block;
}
.ai-pressed {
  background-color: #f4e8ee;
  opacity: .9;
}
/* 三级叠放：悬浮书签950 → 对话1300 → 页头菜单。没有盖住新对话的透明遮罩。 */
.ai-float {
  position: fixed;
  z-index: 950;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  min-width: 44px;
  min-height: 44px;
  padding: 4px 8px;
  border: 1px solid #d5bdcc;
  border-radius: 14px 18px 14px 16px;
  background: #fffdf8;
  box-shadow: 0 3px 10px #6b5b7314;
  color: #875873;
}
.ai-float-mini {
  width: 23px;
  height: 27px;
  flex-shrink: 0;
}
.ai-float-words {
  display: flex;
  flex-direction: column;
  gap: 1px;
  min-width: 0;
}
.ai-float-words>.ai-t:first-child {
  font-family: var(--ai-display);
  font-size: 13px;
}
.ai-float-words>.ai-t:last-child:not(:first-child) {
  font-size: 9px;
  color: var(--ai-muted);
}
.ai-float-collapsed {
  flex-direction: column;
  gap: 1px;
  padding: 4px 0;
  transform: none;
}
.ai-float-collapsed .ai-float-words>.ai-t:first-child {
  font-size: 10px;
  line-height: 1.2;
}
.ai-float-dot {
  position: absolute;
  top: 3px;
  right: 3px;
  width: 7px;
  height: 7px;
  border: 1px solid #fff9f0;
  border-radius: 50%;
  background: #c9e7d3;
}
.ai-overlay {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 1300;
  display: flex;
  flex-direction: column;
  width: 100%;
  background: var(--ai-paper);
  overflow: hidden;
  color: var(--ai-ink);
  font-family: var(--ai-body);
  box-shadow: 0 0 0 100vh #fff9f0;
}
/* 页头不参与消息滚动，返回 / 新对话 / 更多各有独立命中区。 */
.ai-header {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 5px;
  flex-shrink: 0;
  min-height: 60px;
  padding: 5px 12px;
  border-bottom: 1px solid #eadde2;
  background: #fff9f0;
}
.ai-back,.ai-more,.ai-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44px;
  min-width: 44px;
  height: 44px;
  min-height: 44px;
  border-radius: 12px;
  background: transparent;
  color: #6b5b73;
}
.ai-back .ai-img {
  width: 20px;
  height: 20px;
}
.ai-more {
  font-size: 25px;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 2px;
}
.ai-close {
  font-size: 24px;
}
.ai-brand {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1;
  min-width: 0;
}
.ai-brand-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 36px;
  flex-shrink: 0;
  background: #eeeedd;
  border-radius: 11px 14px 10px 13px;
}
.ai-brand-icon .ai-img {
  width: 23px;
  height: 27px;
}
.ai-brand-copy {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
.ai-brand-name {
  display: block;
  font-family: var(--ai-display);
  font-size: 17px;
  font-weight: 600;
  line-height: 1.45;
  color: #6b5b73;
}
.ai-brand-note {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 10px;
  line-height: 1.65;
  color: #756272;
}
.ai-new-chat {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3px;
  flex-shrink: 0;
  min-width: 82px;
  min-height: 44px;
  padding: 0 11px;
  border: 1px solid #d5adbf;
  border-radius: 12px 15px 12px 14px;
  background: #ffd9e8;
  color: #6b5b73;
  font-size: 12px;
  font-weight: 500;
  line-height: 1.5;
  box-shadow: 0 2px 0 #d8a7bb12;
}
.ai-new-chat.ai-pressed {
  background: #f6c8db;
}
.ai-plus {
  font-size: 17px;
  line-height: 1;
}
.ai-menu {
  position: absolute;
  top: 100%;
  right: 12px;
  z-index: 4;
  width: 238px;
  max-width: calc(100% - 24px);
  padding: 7px;
  border: 1px solid #ddc5d2;
  border-radius: 15px;
  background: #fffdf8;
  box-shadow: 0 8px 26px #6b5b7321;
}
.ai-menu-label {
  display: block;
  padding: 5px 10px 6px;
  font-size: 10px;
  color: #756272;
  letter-spacing: .5px;
}
.ai-menu-item {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 11px;
  width: 100%;
  min-height: 44px;
  padding: 8px 10px;
  border-radius: 9px;
  text-align: left;
  font-size: 13px;
  background: transparent;
}
.ai-menu-item .ai-img {
  width: 19px;
  height: 19px;
  flex-shrink: 0;
}
.ai-menu-item>.ai-t:not(.ai-chevron) {
  flex: 1;
}
.ai-chevron {
  margin-left: auto;
  color: #756272;
  font-size: 18px;
}
.ai-menu-last {
  border-top: 1px solid #eee2e7;
  border-radius: 0 0 9px 9px;
  margin-top: 5px;
  font-size: 12px;
  color: #756272;
}
/* 回归保护：消息区有固定边界；最新按钮绝对定位，显隐不挤压头尾。 */
.ai-conversation {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  width: 100%;
}
.ai-conversation .ai-messages {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  min-height: 0;
  padding: 0;
}
.ai-message-column {
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
  padding: 20px 16px 8px;
}
.ai-conversation .ai-latest {
  position: absolute;
  z-index: 2;
  left: 50%;
  bottom: 10px;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  min-width: 44px;
  margin: 0;
  padding: 7px 15px;
  border: 1px solid #d8c1cf;
  border-radius: 13px;
  background: #fffdf8;
  color: #875873;
  font-size: 12px;
  box-shadow: 0 3px 12px #6b5b7312;
  white-space: nowrap;
}
.ai-conversation .ai-latest.ai-pressed {
  transform: translateX(-50%);
  background: #ffe8f0;
}
.ai-earlier {
  width: 100%;
  min-height: 44px;
  padding: 9px 13px;
  margin: 0 0 16px;
  border: 1px dashed #d7bfcd;
  border-radius: 11px;
  background: #fffdf8;
  color: #756272;
  font-size: 12px;
  line-height: 1.7;
}
.ai-scroll-end {
  height: 1px;
  pointer-events: none;
}
/* 空会话是一封待写的小信。图形与引导只在真正空白时出现。 */
.ai-welcome {
  max-width: 460px;
  margin: 19px auto 24px;
  padding: 0 5px;
}
.ai-welcome-art {
  position: relative;
  width: 94px;
  height: 85px;
  isolation: isolate;
  margin: 0 0 13px 2px;
}
.ai-welcome-art .ai-img {
  position: relative;
  z-index: 1;
  width: 94px;
  height: 85px;
}
.ai-art-paper {
  position: absolute;
  left: 11px;
  right: 10px;
  top: 26px;
  bottom: 6px;
  background: #f8e5ec;
  border: 1px solid #e5cbd8;
  border-radius: 12px;
  transform: rotate(-7deg);
}
.ai-art-flower {
  position: absolute;
  right: -5px;
  bottom: 6px;
  z-index: 2;
  font-size: 21px;
  color: #ab7991;
}
.ai-welcome-eyebrow {
  display: block;
  font-size: 10px;
  color: #756272;
  letter-spacing: .5px;
  margin-bottom: 8px;
}
.ai-empty-title {
  display: block;
  font-family: var(--ai-display);
  font-size: 26px;
  line-height: 1.45;
  font-weight: 600;
  letter-spacing: .5px;
  color: #6b5b73;
}
.ai-empty-title>.ai-t {
  display: block;
}
.ai-empty-copy {
  display: block;
  max-width: 360px;
  margin: 12px 0 23px;
  font-size: 13px;
  line-height: 1.85;
  color: #756272;
}
.ai-suggestions {
  display: flex;
  flex-direction: column;
  gap: 9px;
}
.ai-prompt {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12px;
  width: 100%;
  min-height: 65px;
  padding: 11px 13px;
  border: 1px solid #e1cbd7;
  border-radius: 13px;
  background: #fffdf8;
  text-align: left;
  transform: none;
  box-shadow: 0 2px 0 #6b5b7303;
}
.ai-prompt-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 37px;
  border-radius: 10px;
  background: #e5efdf;
  flex-shrink: 0;
}
.ai-prompt-icon-1 {
  background: #fae6d1;
}
.ai-prompt-icon .ai-img {
  width: 20px;
  height: 20px;
}
.ai-prompt-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.ai-prompt-copy>.ai-t:first-child {
  font-size: 13px;
  font-weight: 500;
  color: #6b5b73;
}
.ai-prompt-copy>.ai-t:last-child {
  font-size: 11px;
  color: #756272;
  line-height: 1.6;
}
.ai-prompt-arrow {
  font-size: 16px;
  color: #875873;
  flex-shrink: 0;
}
.ai-connect-guide {
  display: flex;
  flex-direction: column;
  gap: 15px;
  padding: 17px;
  border: 1px solid #d6d9c3;
  border-radius: 14px;
  background: #f0f4e9;
}
.ai-connect-guide>.ai-v {
  display: flex;
  flex-direction: column;
  gap: 5px;
}
.ai-connect-title {
  font-size: 14px;
  font-weight: 500;
}
.ai-connect-guide>.ai-v>.ai-t:last-child {
  font-size: 12px;
  line-height: 1.75;
  color: #65735e;
}
/* 消息：用户是粉色短笺，豆伴是可长读的纸面；正文不再逐条堆装饰。 */
.ai-message {
  display: flex;
  flex-direction: column;
  min-width: 0;
  width: 100%;
  margin: 0 0 24px;
}
.ai-message-meta {
  display: flex;
  align-items: center;
  gap: 7px;
  min-height: 32px;
  margin: 0 2px 8px;
  font-size: 11px;
  line-height: 1.5;
  color: #756272;
}
.ai-message-author {
  font-size: 12px;
  font-weight: 500;
  color: #875873;
}
.ai-message-time {
  font-size: 10px;
  color: #756272;
  font-variant-numeric: tabular-nums;
}
.ai-answer-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 27px;
  height: 29px;
  background: #e6eee1;
  border: 1px solid #d8e1cf;
  border-radius: 8px 10px 7px 10px;
  margin-right: 1px;
  flex-shrink: 0;
}
.ai-answer-mark .ai-img {
  width: 18px;
  height: 22px;
}
.ai-bubble {
  width: 100%;
  min-width: 0;
  padding: 15px 16px;
  border: 1px solid #e6d9df;
  border-radius: 4px 16px 16px 16px;
  background: #fffdf8;
  box-shadow: none;
  overflow: hidden;
}
.ai-message-user {
  align-items: flex-end;
}
.ai-message-user .ai-message-meta {
  justify-content: flex-end;
  margin-bottom: 4px;
}
.ai-message-user .ai-bubble {
  width: auto;
  min-width: 48px;
  max-width: 88%;
  padding: 12px 16px;
  border-color: #efccdc;
  border-radius: 15px 4px 15px 15px;
  background: #fae0eb;
}
.ai-user-text {
  display: block;
  white-space: pre-wrap;
  font-size: 14px;
  line-height: 1.85;
  overflow-wrap: anywhere;
  word-break: break-word;
}
.ai-user-copy {
  width: 44px;
  height: 44px;
  min-width: 44px;
  min-height: 44px;
  margin-left: 1px;
  background: transparent;
  border-radius: 10px;
}
.ai-user-copy .ai-img {
  width: 13px;
  height: 13px;
}
.ai-md {
  display: block;
  margin: 0;
  font-size: 14px;
  line-height: 1.9;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  word-break: break-word;
  color: #6b5b73;
}
.ai-md-heading {
  font-size: 16px;
  line-height: 1.65;
  font-weight: 600;
  margin: 13px 0 7px;
}
.ai-md-heading:first-child {
  margin-top: 0;
}
.ai-md-bullet {
  position: relative;
  margin: 5px 0;
  padding-left: 10px;
  border-left: 2px solid #ead4df;
  background: transparent;
}
.ai-md-quote {
  margin: 10px 0;
  padding: 10px 12px;
  border-left: 3px solid #afc6ab;
  border-radius: 0 8px 8px 0;
  background: #eff3e9;
  color: #596c54;
}
.ai-md-space {
  display: block;
  height: 10px;
  line-height: 10px;
}
.ai-inline-bold {
  font-weight: 600;
  color: #6b5b73;
}
.ai-inline-code {
  font-family: Consolas,Menlo,monospace;
  font-size: 12px;
  background: #f4e9ef;
  color: #875873;
  padding: 1px 4px;
  border-radius: 4px;
}
.ai-code-block {
  width: 100%;
  min-width: 0;
  margin: 12px 0;
  border: 1px solid #dfd0d8;
  border-radius: 10px;
  overflow: hidden;
  background: #f5eee8;
}
.ai-code-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  min-height: 44px;
  padding: 0 6px 0 13px;
  border-bottom: 1px solid #e4d6dd;
  color: #756272;
  background: #efe6e2;
  font-family: Consolas,Menlo,monospace;
  font-size: 11px;
  line-height: 1.5;
}
.ai-code-copy {
  display: flex;
  align-items: center;
  gap: 5px;
  min-width: 44px;
  min-height: 44px;
  padding: 0 9px;
  font-size: 11px;
  color: #875873;
}
.ai-code-copy .ai-img {
  width: 13px;
  height: 13px;
}
.ai-code-scroll {
  width: 100%;
  white-space: nowrap;
}
.ai-md-code {
  display: block;
  min-width: 100%;
  width: max-content;
  padding: 13px;
  font-family: Consolas,Menlo,"Courier New",monospace;
  font-size: 12px;
  line-height: 1.8;
  white-space: pre;
  color: #655564;
}
.ai-streaming {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 10px;
  font-size: 11px;
  line-height: 1.6;
  color: #756272;
}
.ai-stream-dot {
  width: 6px;
  height: 6px;
  flex-shrink: 0;
  border-radius: 50%;
  background: #a77b94;
  animation: ai-breathe 1.2s ease-in-out infinite;
}
.ai-message-status {
  display: block;
  margin-top: 11px;
  padding-top: 9px;
  border-top: 1px solid #e7d9df;
  color: #756272;
  font-size: 11px;
  line-height: 1.7;
}
.ai-message-error {
  color: #963e61;
}
.ai-message-actions {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex-wrap: wrap;
  gap: 2px;
  min-height: 44px;
  padding: 0 2px;
  margin-top: 3px;
}
.ai-message-copy {
  display: flex;
  align-items: center;
  gap: 6px;
  min-width: 44px;
  min-height: 44px;
  padding: 0 10px;
  color: #756272;
  font-size: 11px;
  border-radius: 9px;
}
.ai-message-copy .ai-img {
  width: 13px;
  height: 13px;
}
.ai-retry-icon {
  font-size: 17px;
  line-height: 1;
}
.ai-image-retry {
  font-size: 11px;
  color: #756272;
}
/* 输入区固定在消息区外；自动增高仍有上限，不用高度动效。 */
.ai-composer {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  padding: 7px 13px calc(10px + env(safe-area-inset-bottom));
  background: #fff9f0;
  border-top: 1px solid #eee2e6;
}
.ai-composer-column {
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
}
.ai-compose-card {
  width: 100%;
  padding: 11px 12px 8px;
  border: 1px solid #d4b6c8;
  border-radius: 17px 20px 16px 19px;
  background: #fffdf8;
  box-shadow: 0 3px 0 #6b5b7305;
}
.ai-compose-card:focus-within {
  border-color: #a87892;
  box-shadow: 0 0 0 3px #f2dfe8;
}
.ai-question {
  display: block;
  width: 100%;
  min-height: 42px;
  max-height: 136px;
  margin: 0;
  padding: 3px 1px 4px;
  font-size: 14px;
  line-height: 1.75;
  border: 0;
  background: transparent;
  outline: none;
  color: #6b5b73;
  box-sizing: border-box;
}
.ai-placeholder {
  color: #756272;
  font-size: 13px;
}
.ai-compose-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 44px;
  margin-top: 5px;
}
.ai-input-tools {
  display: flex;
  align-items: center;
  gap: 7px;
  min-width: 0;
  flex: 1;
}
.ai-attach-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
  width: 44px;
  padding: 0;
  border-radius: 11px;
  color: #756272;
}
.ai-attach-button .ai-img {
  width: 20px;
  height: 20px;
}
.ai-composer-model {
  display: block;
  min-width: 0;
  font-size: 10px;
  line-height: 1.6;
  color: #756272;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}
.ai-send {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  min-width: 44px;
  min-height: 44px;
  flex-shrink: 0;
  padding: 0;
  border: 1px solid #acd0b6;
  border-radius: 13px 16px 12px 15px;
  background: #c9e7d3;
  color: #42654d;
}
.ai-send .ai-img {
  width: 21px;
  height: 21px;
}
.ai-send.ai-disabled {
  background: #f0eae5;
  border-color: #dfd2d9;
  opacity: 1;
}
.ai-send.ai-disabled .ai-img {
  opacity: .42;
}
.ai-stop {
  background: #f9dde9;
  border-color: #d5a7bc;
}
.ai-stop-square {
  width: 13px;
  height: 13px;
  border-radius: 3px;
  background: #875873;
}
.ai-attachment {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px;
  margin-bottom: 10px;
  border: 1px solid #dfccd6;
  border-radius: 11px;
  background: #f7eef2;
}
.ai-attachment>.ai-img {
  width: 43px;
  height: 43px;
  border-radius: 7px;
  object-fit: cover;
  flex-shrink: 0;
}
.ai-attachment>.ai-v {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
  min-width: 0;
}
.ai-attachment>.ai-v>.ai-t:first-child {
  font-size: 12px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ai-attachment>.ai-v>.ai-t:last-child {
  font-size: 10px;
  color: #756272;
}
.ai-icon-action {
  min-width: 44px;
  min-height: 44px;
  font-size: 23px;
  color: #875873;
}
/* 状态反馈只保留一个出口，与空态、等待、停止、错误各自区分。 */
.ai-feedback,.ai-notice {
  flex-shrink: 0;
  margin: 7px 13px 0;
  padding: 10px 13px;
  border: 1px solid #e2bccd;
  border-radius: 10px;
  background: #fbe9ef;
  color: #963e61;
  font-size: 12px;
  line-height: 1.8;
  max-height: 100px;
  overflow: auto;
}
.ai-feedback {
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.ai-feedback-label {
  font-size: 11px;
  font-weight: 600;
}
.ai-notice {
  border-color: #d6ddc8;
  background: #eff3e8;
  color: #596c54;
}
.ai-warning {
  padding: 10px 12px;
  background: #fff0cb;
  border: 1px solid #e1cd96;
  border-radius: 9px;
  color: #795a2c;
  font-size: 12px;
  line-height: 1.8;
  margin: 12px 0;
}
/* 会话列表、连接与资料预览沿用相同页宽、分组与表单规范。 */
.ai-subscroll {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
  padding: 0;
}
.ai-page-column {
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
  padding: 17px 15px calc(24px + env(safe-area-inset-bottom));
}
.ai-page-foot {
  display: block;
  margin: 15px 5px 0;
  font-size: 11px;
  line-height: 1.85;
  color: #756272;
}
.ai-history-tools {
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
  padding: 15px 15px 0;
  flex-shrink: 0;
}
.ai-history-search {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 3px 0 13px;
  min-height: 44px;
  border: 1px solid #dfccd6;
  border-radius: 12px;
  background: #fffdf8;
}
.ai-history-search:focus-within {
  border-color: #a87892;
  box-shadow: 0 0 0 3px #f2dfe8;
}
.ai-history-search>.ai-img {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}
.ai-history-search .ai-in {
  flex: 1;
  min-width: 0;
  height: 44px;
  font-size: 13px;
  background: transparent;
}
.ai-history-search>.ai-btn {
  width: 44px;
  min-width: 44px;
  height: 44px;
  font-size: 22px;
  color: #875873;
}
.ai-list-count {
  display: block;
  margin: 12px 1px 0;
  font-size: 10px;
  color: #756272;
  line-height: 1.7;
}
.ai-history-row {
  position: relative;
  display: flex;
  align-items: stretch;
  gap: 0;
  margin: 0 0 11px;
  padding: 0;
  border: 1px solid #e2d1da;
  border-radius: 13px;
  background: #fffdf8;
  box-shadow: 0 2px 0 #6b5b7303;
  overflow: hidden;
}
.ai-history-current {
  border-color: #b6cbb5;
  box-shadow: inset 3px 0 #a4c3aa;
  background: #f1f5eb;
}
.ai-history-open {
  display: flex;
  align-items: stretch;
  justify-content: flex-start;
  flex-direction: column;
  gap: 7px;
  flex: 1;
  min-width: 0;
  min-height: 88px;
  padding: 14px 10px 13px 16px;
  text-align: left;
  background: transparent;
  border-radius: 0;
}
.ai-history-title-line {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}
.ai-history-title-line>.ai-t:first-child {
  flex: 1;
  min-width: 0;
  font-size: 14px;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ai-current-tag {
  padding: 2px 6px;
  border-radius: 5px;
  background: #dbe9d8;
  color: #42654d;
  font-size: 9px;
  flex-shrink: 0;
}
.ai-history-snippet {
  display: block;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 12px;
  color: #756272;
  line-height: 1.7;
}
.ai-history-when {
  font-size: 10px;
  color: #756272;
  font-variant-numeric: tabular-nums;
}
.ai-history-delete {
  align-self: center;
  min-width: 44px;
  min-height: 44px;
  margin-right: 5px;
  font-size: 21px;
  color: #9a778b;
  background: transparent;
  border-radius: 10px;
}
.ai-empty {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 10px;
  padding: 46px 16px;
  text-align: center;
}
.ai-empty-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62px;
  height: 65px;
  background: #f4e6ed;
  border: 1px solid #e2ccd7;
  border-radius: 22px 28px 19px 26px;
  margin-bottom: 7px;
}
.ai-empty-symbol .ai-img {
  width: 31px;
  height: 31px;
}
.ai-empty>.ai-t {
  font-size: 16px;
  font-family: var(--ai-display);
  line-height: 1.8;
}
.ai-empty>.ai-t+.ai-t {
  font-family: var(--ai-body);
  font-size: 12px;
  color: #756272;
  max-width: 300px;
}
.ai-settings-intro {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 0 2px 18px;
}
.ai-settings-intro-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 41px;
  flex-shrink: 0;
  background: #e5eddf;
  border-radius: 12px 16px 10px 15px;
}
.ai-settings-intro-icon .ai-img {
  width: 22px;
  height: 22px;
}
.ai-settings-intro>.ai-v:last-child {
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.ai-settings-intro>.ai-v>.ai-t:first-child {
  font-family: var(--ai-display);
  font-size: 17px;
  font-weight: 600;
}
.ai-settings-intro>.ai-v>.ai-t:last-child {
  font-size: 11px;
  color: #756272;
  line-height: 1.8;
}
.ai-setting-card,.ai-info-paper {
  padding: 16px;
  margin: 0 0 13px;
  border: 1px solid #e2d1da;
  border-radius: 14px;
  background: #fffdf8;
  box-shadow: 0 2px 0 #6b5b7303;
}
.ai-section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 15px;
}
.ai-section-title {
  display: block;
  font-size: 15px;
  line-height: 1.6;
  font-weight: 600;
  color: #6b5b73;
}
.ai-status-tag,.ai-count-tag {
  display: inline-block;
  padding: 3px 7px;
  border: 1px solid #dfccd7;
  border-radius: 6px;
  background: #f6edf2;
  color: #875873;
  font-size: 10px;
  line-height: 1.5;
  white-space: nowrap;
}
.ai-count-tag {
  margin-left: 8px;
  background: #f8efd9;
  border-color: #e3d0a3;
  color: #795a2c;
}
.ai-modes {
  display: flex;
  gap: 4px;
  padding: 4px;
  margin: 0 0 18px;
  background: #f3eae5;
  border: 1px solid #e0d0d8;
  border-radius: 11px;
}
.ai-mode {
  min-width: 0;
  min-height: 44px;
  flex: 1;
  padding: 7px 8px;
  border: 1px solid transparent;
  border-radius: 8px;
  font-size: 12px;
  line-height: 1.6;
}
.ai-mode.ai-selected {
  background: #fffdf8;
  border-color: #ceb0c1;
  color: #875873;
  box-shadow: 0 2px 3px #6b5b7306;
  font-weight: 500;
}
.ai-field {
  margin: 15px 0;
}
.ai-field>.ai-t:first-child {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 10px;
  font-size: 12px;
  font-weight: 500;
  line-height: 1.7;
  margin-bottom: 7px;
}
.ai-field-hint {
  color: #756272;
  font-size: 10px;
  font-weight: 400;
}
.ai-input {
  display: block;
  width: 100%;
  height: 46px;
  min-height: 44px;
  padding: 10px 12px;
  border: 1px solid #ddc9d4;
  border-radius: 9px;
  background: #fffdf8;
  color: #6b5b73;
  font-size: 13px;
  line-height: 1.7;
}
.ai-input:focus {
  border-color: #a77892;
  box-shadow: 0 0 0 3px #f3e3eb;
}
.ai-help {
  display: block;
  font-size: 11px;
  line-height: 1.85;
  color: #756272;
  margin-top: 7px;
}
.ai-secret-row {
  display: flex;
  align-items: center;
  gap: 7px;
}
.ai-secret-row .ai-input {
  flex: 1;
  min-width: 0;
}
.ai-secret-toggle {
  min-width: 44px;
  min-height: 44px;
  padding: 0 4px;
  font-size: 12px;
  color: #875873;
}
.ai-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 0;
  min-height: 60px;
  border-top: 1px solid #eee2e7;
}
.ai-switch-row>.ai-v {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.ai-switch-row>.ai-v>.ai-t:first-child {
  font-size: 13px;
  font-weight: 500;
}
.ai-switch-row>.ai-v>.ai-t+.ai-t {
  font-size: 11px;
  line-height: 1.8;
  color: #756272;
}
.ai-switch-row .ai-switch {
  flex-shrink: 0;
}
.ai-key-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 5px;
  border-top: 1px solid #eee2e7;
  padding-top: 11px;
}
.ai-text-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
  padding: 5px 6px;
  color: #875873;
  font-size: 12px;
  line-height: 1.7;
}
.ai-danger-text {
  color: #963e61;
}
.ai-test-button {
  min-height: 44px;
  min-width: 88px;
  padding: 0 14px;
  border: 1px solid #c7d8c6;
  border-radius: 10px;
  background: #e8f1e3;
  color: #42654d;
  font-size: 12px;
}
.ai-connection-note {
  margin-top: 12px;
  padding-top: 11px;
  border-top: 1px dashed #e2d1da;
}
.ai-disclosure {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  width: 100%;
  min-height: 44px;
  padding: 0;
  border-radius: 5px;
  text-align: left;
  color: #6b5b73;
  font-size: 14px;
  line-height: 1.7;
}
.ai-disclosure .ai-v {
  flex: 1;
  min-width: 0;
}
.ai-disclosure .ai-v>.ai-t:first-child {
  display: block;
  font-weight: 500;
  font-size: 14px;
}
.ai-disclosure .ai-t {
  font-size: 19px;
  font-weight: 400;
  color: #875873;
  flex-shrink: 0;
}
.ai-disclosure-note {
  display: block;
  font-size: 11px!important;
  line-height: 1.8;
  color: #756272;
  font-weight: 400;
  margin-top: 6px;
}
.ai-expanded {
  padding-top: 15px;
  margin-top: 14px;
  border-top: 1px solid #e8dce2;
}
.ai-scope-grid {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 8px;
  margin-bottom: 15px;
}
.ai-scope {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
  min-width: 0;
  min-height: 44px;
  padding: 9px 10px;
  border: 1px solid #dfcbd6;
  border-radius: 10px;
  background: #fffdf8;
  text-align: left;
  font-size: 12px;
  line-height: 1.7;
}
.ai-scope.ai-selected {
  background: #fff0f5;
  border-color: #cba5b9;
}
.ai-checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 15px;
  height: 15px;
  border: 1px solid #b48ba3;
  border-radius: 4px;
  background: #fffdf8;
  color: #875873;
  font-size: 11px;
  line-height: 1;
}
.ai-selected .ai-checkbox {
  background: #f5d6e4;
}
.ai-preview-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  min-height: 44px;
  margin-top: 12px;
  padding: 10px 0 0;
  border-top: 1px solid #eee2e7;
  border-radius: 0;
  color: #875873;
  text-align: left;
  font-size: 12px;
}
.ai-form-grid {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 14px;
}
.ai-form-grid .ai-field {
  min-width: 0;
}
.ai-system-input {
  height: 138px;
  line-height: 1.85;
  resize: none;
}
.ai-settings-footer {
  width: 100%;
  flex-shrink: 0;
  padding: 10px 15px calc(10px + env(safe-area-inset-bottom));
  background: #fff9f0;
  border-top: 1px solid #e8dae1;
}
.ai-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  min-height: 44px;
  padding: 11px 16px;
  border: 1px solid #d3adbf;
  border-radius: 11px 14px 11px 13px;
  font-size: 13px;
  line-height: 1.7;
  color: #6b5b73;
}
.ai-button-pink {
  background: #ffd9e8;
  border-color: #d1a1b7;
}
.ai-button-mint {
  background: #c9e7d3;
  border-color: #a8c3ad;
}
.ai-save {
  max-width: 690px;
  margin: 0 auto;
}
.ai-preview-destination {
  border-color: #cfdbc3;
  background: #f2f5eb;
}
.ai-kicker {
  font-size: 10px;
  color: #65735e;
  letter-spacing: .5px;
}
.ai-domain {
  display: block;
  margin: 7px 0;
  font-family: Consolas,Menlo,monospace;
  font-size: 18px;
  line-height: 1.6;
  font-weight: 500;
  overflow-wrap: anywhere;
  color: #53654d;
}
.ai-preview-summary {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  margin-top: 17px;
  padding-top: 14px;
  border-top: 1px solid #d9dfcc;
}
.ai-preview-summary>.ai-v {
  display: flex;
  flex-direction: column;
  gap: 4px;
  align-items: center;
}
.ai-preview-summary>.ai-v+.ai-v {
  border-left: 1px solid #d9dfcc;
}
.ai-preview-summary>.ai-v>.ai-t:first-child {
  font-family: Georgia,serif;
  font-size: 25px;
  line-height: 1.4;
}
.ai-preview-summary>.ai-v>.ai-t:last-child {
  font-size: 10px;
  color: #65735e;
}
.ai-history-excerpt {
  padding: 12px 0;
  border-bottom: 1px solid #eee2e7;
}
.ai-history-excerpt:last-child {
  border: 0;
}
.ai-history-speaker {
  display: block;
  font-size: 11px;
  font-weight: 500;
  color: #875873;
  margin-bottom: 6px;
}
.ai-history-excerpt>.ai-t:last-child {
  display: block;
  font-size: 12px;
  line-height: 1.85;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.ai-preview-sources {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 7px;
}
.ai-preview-source {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 10px;
  border: 1px solid #e2d1da;
  border-radius: 8px;
  background: #f7f0e9;
}
.ai-preview-source>.ai-t:first-child {
  font-size: 12px;
}
.ai-preview-source>.ai-t:last-child {
  font-size: 10px;
  color: #756272;
}
.ai-preview-included {
  background: #eef3e8;
  border-color: #c6d6c0;
}
.ai-context-text {
  display: block;
  margin-top: 17px;
  font-family: var(--ai-body);
  font-size: 12px;
  line-height: 1.9;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  word-break: break-word;
}
/* 键盘只压缩输入区留白，不改变滚动判定，不引入自动滚动动效。 */
.ai-keyboard .ai-question {
  min-height: 34px;
  max-height: 100px;
}
.ai-keyboard .ai-compose-card {
  padding-top: 7px;
  padding-bottom: 5px;
}
.ai-keyboard .ai-composer {
  padding-top: 6px;
  padding-bottom: 6px;
}
.ai-keyboard .ai-compose-row {
  margin-top: 2px;
}
.ai-keyboard .ai-header {
  min-height: 56px;
  padding-top: 3px;
  padding-bottom: 3px;
}
@media(max-width:350px) {
  .ai-header {
    padding-left: 6px;
    padding-right: 6px;
    gap: 3px;
  }
  .ai-brand-icon {
    display: none;
  }
  .ai-brand-name {
    font-size: 16px;
  }
  .ai-brand-note {
    font-size: 10px;
  }
  .ai-new-chat {
    min-width: 78px;
    padding: 0 8px;
  }
  .ai-message-column {
    padding-left: 12px;
    padding-right: 12px;
  }
  .ai-bubble {
    padding: 13px;
  }
  .ai-message-user .ai-bubble {
    padding: 11px 14px;
  }
  .ai-composer {
    padding-left: 10px;
    padding-right: 10px;
  }
  .ai-welcome {
    padding: 0 3px;
    margin-top: 12px;
  }
  .ai-empty-title {
    font-size: 24px;
  }
  .ai-welcome-art {
    width: 86px;
    height: 78px;
    margin-bottom: 14px;
  }
  .ai-welcome-art .ai-img {
    width: 86px;
    height: 78px;
  }
  .ai-empty-copy {
    margin-bottom: 19px;
  }
  .ai-page-column {
    padding-left: 12px;
    padding-right: 12px;
  }
  .ai-setting-card,.ai-info-paper {
    padding: 13px;
  }
  .ai-scope-grid {
    gap: 6px;
  }
  .ai-scope {
    padding: 8px;
    font-size: 11px;
  }
  .ai-preview-source {
    padding: 8px;
  }
}
@media(min-width:700px) {
  .ai-header {
    padding-left: max(18px,calc((100% - 760px)/2));
    padding-right: max(18px,calc((100% - 760px)/2));
    min-height: 68px;
    gap: 9px;
  }
  .ai-brand-name {
    font-size: 18px;
  }
  .ai-brand-note {
    font-size: 11px;
  }
  .ai-brand-icon {
    width: 38px;
    height: 41px;
  }
  .ai-new-chat {
    padding: 0 16px;
    font-size: 13px;
  }
  .ai-menu {
    right: max(18px,calc((100% - 760px)/2));
  }
  .ai-message-column {
    padding-top: 28px;
    padding-left: 22px;
    padding-right: 22px;
  }
  .ai-welcome {
    margin-top: 37px;
    max-width: 480px;
  }
  .ai-empty-title {
    font-size: 30px;
  }
  .ai-empty-copy {
    font-size: 14px;
    max-width: 400px;
  }
  .ai-welcome-art {
    width: 110px;
    height: 100px;
  }
  .ai-welcome-art .ai-img {
    width: 110px;
    height: 100px;
  }
  .ai-message {
    margin-bottom: 28px;
  }
  .ai-bubble {
    padding: 19px 22px;
  }
  .ai-md,.ai-user-text {
    font-size: 15px;
  }
  .ai-composer {
    padding-top: 11px;
    padding-bottom: calc(15px + env(safe-area-inset-bottom));
  }
  .ai-page-column {
    padding-top: 24px;
  }
  .ai-setting-card {
    padding: 20px;
  }
  .ai-header .ai-close {
    margin-left: 0;
  }
}
@keyframes ai-breathe {
  0%,100% {
    opacity: .4;
  }
  50% {
    opacity: 1;
  }
}
@media(prefers-reduced-motion:reduce) {
  .ai-btn,.ai-ta {
    transition: none!important;
    animation: none!important;
  }
  .ai-stream-dot {
    animation: none;
    opacity: 1;
  }
  .ai-pressed {
    transform: none;
  }
  .ai-conversation .ai-latest.ai-pressed {
    transform: translateX(-50%);
  }
}
@media(hover:hover) {
  .ai-btn:not(.ai-disabled):hover {
    background-color: #f4e8ee;
  }
  .ai-send:not(.ai-disabled):hover {
    background-color: #b9dac5;
  }
}
