  border-radius: 16rpx;
  background: #fff0f3;
  font-size: 22rpx;
  line-height: 1.7;
}
.ai-notice {
  background: #fff2d7;
  border-color: #e8d8b7;
}
.ai-composer {
  flex-shrink: 0;
  padding: 0 24rpx calc(18rpx + env(safe-area-inset-bottom));
