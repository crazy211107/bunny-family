<button wx:if="{{!opened}}" class="ai-float {{collapsed ? 'ai-float-collapsed' : ''}} ai-btn" style="left:{{floatX}}px;top:{{floatY}}px;width:{{floatWidth}}px;height:{{floatSize}}px" bindtouchstart="dragStart" catchtouchmove="dragMove" bindtouchend="dragEnd" bindtouchcancel="dragEnd" bindtap="openChat" hover-class="ai-pressed" aria-label="打开豆伴 AI，可拖动贴边">
  <image class="ai-float-mini ai-img" src="/assets/ai-bunny.svg" mode="aspectFit" /><view class="ai-float-words ai-v"><text class="ai-t">豆伴</text><text class="ai-t" wx:if="{{!collapsed}}">聊聊小日子</text></view><view class="ai-float-dot ai-v"></view>
</button>

<view wx:if="{{opened}}" class="ai-overlay {{keyboardHeight ? 'ai-keyboard' : ''}} ai-v" style="height:{{panelHeight - keyboardHeight}}px;padding-top:{{safeTop}}px">
  <view class="ai-header ai-v" catchtouchmove="stopTap">
    <button class="ai-back ai-btn" bindtap="navigateBack" hover-class="ai-pressed" aria-label="返回"><image class="ai-img" src="/assets/ai-arrow-left.svg" mode="aspectFit" /></button>
    <view class="ai-brand ai-v"><view class="ai-brand-icon ai-v"><image class="ai-img" src="/assets/ai-bunny.svg" mode="aspectFit" /></view><view class="ai-brand-copy ai-v"><text class="ai-brand-name ai-t">{{screen === 'history' ? '我们的对话' : screen === 'settings' ? '连接与资料' : screen === 'context' ? '发送预览' : '豆伴'}}</text><text class="ai-brand-note ai-t">{{screen === 'chat' ? (messages.length ? title : '陪你理清生活里的小事') : screen === 'history' ? '返回小窝 · 对话留在本机' : screen === 'settings' ? '保存后生效 · 返回不保存' : '本页不发起请求'}}</text></view></view>
    <button wx:if="{{screen === 'chat' || screen === 'history'}}" id="ai-new-chat" class="ai-new-chat ai-btn" catchtap="newChat" hover-class="ai-pressed" aria-label="新对话"><text class="ai-plus ai-t" aria-hidden="true">＋</text><text class="ai-t">新对话</text></button>
    <button wx:if="{{screen === 'chat'}}" id="ai-more" class="ai-more ai-btn" catchtap="toggleMenu" hover-class="ai-pressed" aria-label="更多对话选项" aria-expanded="{{menuOpen}}">···</button>
    <button wx:else class="ai-close ai-btn" bindtap="closeChat" hover-class="ai-pressed" aria-label="收起豆伴">−</button>
    <view wx:if="{{screen === 'chat' && menuOpen}}" class="ai-menu ai-v" aria-label="对话选项">
      <text class="ai-menu-label ai-t">豆伴的小抽屉</text>
      <button class="ai-menu-item ai-btn" bindtap="openHistory" hover-class="ai-pressed"><image class="ai-img" src="/assets/ai-icons/history.svg" mode="aspectFit" /><text class="ai-t">我们的对话</text><text class="ai-chevron ai-t">›</text></button>
      <button class="ai-menu-item ai-btn" bindtap="previewContext" hover-class="ai-pressed"><image class="ai-img" src="/assets/ai-icons/notebook.svg" mode="aspectFit" /><text class="ai-t">本次资料与上下文</text><text class="ai-chevron ai-t">›</text></button>
      <button class="ai-menu-item ai-btn" bindtap="openSettings" hover-class="ai-pressed"><image class="ai-img" src="/assets/ai-icons/gear.svg" mode="aspectFit" /><text class="ai-t">连接与资料</text><text class="ai-chevron ai-t">›</text></button>
      <button class="ai-menu-item ai-menu-last ai-btn" bindtap="closeChat" hover-class="ai-pressed"><text class="ai-t">收起豆伴</text><text class="ai-chevron ai-t">−</text></button>
    </view>
  </view>
  <view wx:if="{{screen !== 'chat' && error}}" class="ai-feedback ai-v" aria-role="alert"><text class="ai-feedback-label ai-t">请检查一下</text><text class="ai-t">{{error}}</text></view>
  <view wx:if="{{screen !== 'chat' && notice && !error}}" class="ai-notice ai-v" aria-role="status">{{notice}}</view>

  <block wx:if="{{screen === 'chat'}}">
    <view class="ai-conversation ai-v">
      <scroll-view id="ai-message-scroll" class="ai-messages ai-scroll" scroll-y scroll-into-view="{{scrollTarget}}" scroll-with-animation="{{false}}" enhanced show-scrollbar="{{false}}" bindtap="closeMenu" bindtouchstart="messageTouch" bindtouchmove="messageMove" bindscroll="messageScroll" bindscrolltolower="resumeScroll">
        <view class="ai-message-column ai-v">
          <button wx:if="{{hiddenMessages}}" class="ai-earlier ai-btn" bindtap="loadEarlier" hover-class="ai-pressed">加载更早的消息 · {{hiddenMessages}} 条</button>
          <view wx:if="{{!messages.length}}" class="ai-welcome ai-welcome-simple ai-v">
            <view class="ai-welcome-art ai-v" aria-hidden="true"><view class="ai-art-paper ai-v"></view><image class="ai-img" src="/assets/ai-letter.svg" mode="aspectFit" /><text class="ai-art-flower ai-t">✿</text></view>
            <text class="ai-welcome-eyebrow ai-t">豆伴 · 你的小窝生活助手</text>
            <text class="ai-empty-title ai-t">把小日子，聊明白。</text>
            <text class="ai-empty-copy ai-t">照顾安排、成长回忆，或一句手账旁白。慢慢说，我在听。</text>
            <view class="ai-suggestions ai-v" wx:if="{{hasSecret}}">
              <button class="ai-prompt ai-btn" wx:for="{{prompts}}" wx:key="*this" data-text="{{item}}" bindtap="prompt" hover-class="ai-pressed"><view class="ai-prompt-icon ai-prompt-icon-{{index}} ai-v"><image class="ai-img" src="{{index === 0 ? '/assets/ai-icons/notebook.svg' : '/assets/ai-icons/chats.svg'}}" mode="aspectFit" /></view><view class="ai-prompt-copy ai-v"><text class="ai-t">{{index === 0 ? '理一理今日照顾' : '留一句家人交接'}}</text><text class="ai-t">{{item}}</text></view><text class="ai-prompt-arrow ai-t" aria-hidden="true">↗</text></button>
            </view>
            <view wx:else class="ai-connect-guide ai-v"><view class="ai-v"><text class="ai-connect-title ai-t">先和你的 AI 服务连上线</text><text class="ai-t">支持 DeepSeek 或兼容 API，填好后就能开始。</text></view><button class="ai-button ai-button-mint ai-btn" bindtap="openSettings" hover-class="ai-pressed">连接豆伴 <text class="ai-t" aria-hidden="true">↗</text></button></view>
          </view>
          <view wx:for="{{messages}}" wx:key="id" id="ai-message-{{item.id}}" class="ai-message ai-message-{{item.role}} ai-v">
            <view class="ai-message-meta ai-v"><view wx:if="{{item.role === 'assistant'}}" class="ai-answer-mark ai-v"><image class="ai-img" src="/assets/ai-bunny.svg" mode="aspectFit" /></view><text class="ai-message-author ai-t">{{item.role === 'user' ? '我' : '豆伴'}}</text><text class="ai-message-time ai-t">{{item.time}}</text><button wx:if="{{item.role === 'user'}}" class="ai-user-copy ai-btn" data-id="{{item.id}}" bindtap="copyMessage" hover-class="ai-pressed" aria-label="复制我的消息"><image class="ai-img" src="/assets/ai-copy.svg" mode="aspectFit" /></button></view>
            <view class="ai-bubble ai-v">
              <text wx:if="{{item.role === 'user'}}" class="ai-user-text ai-t" selectable>{{item.content}}</text>
              <block wx:else>
                <block wx:for="{{item.blocks}}" wx:for-item="block" wx:key="id">
                  <view wx:if="{{block.type === 'code'}}" class="ai-code-block ai-v"><view class="ai-code-heading ai-v"><text class="ai-t">{{block.language || '代码'}}</text><button class="ai-code-copy ai-btn" data-message="{{item.id}}" data-index="{{block.id}}" bindtap="copyCode" aria-label="复制代码"><image class="ai-img" src="/assets/ai-copy.svg" mode="aspectFit" /><text class="ai-t">复制</text></button></view><scroll-view scroll-x class="ai-code-scroll ai-scroll"><text class="ai-md-code ai-t" selectable>{{block.text}}</text></scroll-view></view>
                  <text wx:else class="ai-md ai-md-{{block.type}} ai-t" selectable><text wx:for="{{block.runs}}" wx:for-item="run" wx:key="id" class="ai-inline-{{run.kind}} ai-t">{{run.text}}</text></text>
                </block>
                <view wx:if="{{item.status === 'streaming'}}" class="ai-streaming ai-v" aria-role="status"><text class="ai-stream-dot ai-t"></text><text class="ai-t">{{item.hasContent ? '正在回复…' : '正在等待回答…'}}</text></view>
                <view wx:if="{{item.status === 'aborted'}}" class="ai-message-status ai-v">已停止 · {{item.hasContent ? '已收到的回答仍保留' : '尚未收到回答文字'}}</view>
                <view wx:if="{{item.status === 'error'}}" class="ai-message-status ai-message-error ai-v">回答未完成 · 可重试，已收到的文字仍保留</view>
              </block>
            </view>
            <view class="ai-message-actions ai-v" wx:if="{{item.role === 'assistant' && (item.hasContent || item.retryable || item.regeneratable || item.imageRetry)}}"><button wx:if="{{item.hasContent}}" class="ai-message-copy ai-btn" data-id="{{item.id}}" bindtap="copyMessage" hover-class="ai-pressed" aria-label="复制豆伴的回答"><image class="ai-img" src="/assets/ai-copy.svg" mode="aspectFit" /><text class="ai-t">复制</text></button><button wx:if="{{item.retryable || item.regeneratable}}" class="ai-message-copy ai-btn {{(running) ? 'ai-disabled' : ''}}" bindtap="retry" disabled="{{running}}" hover-class="ai-pressed" aria-label="{{item.regeneratable ? '重新生成这次回答' : '重试这次回答'}}"><text class="ai-retry-icon ai-t" aria-hidden="true">↻</text><text class="ai-t">{{item.regeneratable ? '重新回答' : '重试'}}</text></button><text wx:if="{{item.imageRetry}}" class="ai-image-retry ai-t">重试需重新附图。</text></view>
          </view>
          <button wx:if="{{newerMessages}}" class="ai-earlier ai-btn" bindtap="latest">还有 {{newerMessages}} 条较新消息 · 返回最新</button>
          <view id="ai-bottom-a" class="ai-scroll-end ai-v"></view><view id="ai-bottom-b" class="ai-scroll-end ai-v"></view>
        </view>
      </scroll-view>
      <button wx:if="{{showLatest}}" class="ai-latest ai-btn" bindtap="latest" hover-class="ai-pressed">↓ 回到最新</button>
    </view>
    <view wx:if="{{error}}" class="ai-feedback ai-v" aria-role="alert"><text class="ai-feedback-label ai-t">这次没能完成</text><text class="ai-t">{{error}}</text></view>
    <view wx:if="{{notice && !error}}" class="ai-notice ai-v" aria-role="status">{{notice}}</view>
    <view class="ai-composer ai-v" bindtap="closeMenu" catchtouchmove="stopTap">
      <view class="ai-composer-column ai-v">
        <view class="ai-compose-card ai-v">
          <view wx:if="{{attachment}}" class="ai-attachment ai-v"><image class="ai-img" src="{{attachment.preview}}" mode="aspectFill" /><view class="ai-v"><text class="ai-t">{{attachment.name}}</text><text class="ai-t">仅本次发送 · 不存入历史</text></view><button class="ai-icon-action ai-btn" bindtap="removeImage" aria-label="移除附图">×</button></view>
          <textarea class="ai-question ai-ta" value="{{question}}" bindinput="inputQuestion" bindconfirm="submit" bindblur="inputBlur" focus="{{inputFocused}}" maxlength="3000" auto-height adjust-position="{{false}}" show-confirm-bar="{{false}}" confirm-type="send" placeholder="和豆伴说说，今天想从哪件小事开始？" placeholder-class="ai-placeholder" aria-label="向豆伴 AI 提问，最多3000字" />
          <view class="ai-compose-row ai-v"><view class="ai-input-tools ai-v"><button wx:if="{{settings.visionEnabled}}" class="ai-attach-button ai-btn {{(running || testing || choosingImage) ? 'ai-disabled' : ''}}" bindtap="chooseImage" disabled="{{running || testing || choosingImage}}" hover-class="ai-pressed" aria-label="添加一张照片"><image class="ai-img" src="/assets/ai-icons/paperclip.svg" mode="aspectFit" /></button><text class="ai-composer-model ai-t">{{choosingImage ? '正在准备附图…' : running ? '豆伴正在整理回答' : hasSecret ? settings.model : '连接后即可发送'}}</text></view><button wx:if="{{running}}" class="ai-send ai-stop ai-btn" bindtap="stop" hover-class="ai-pressed" aria-label="停止回答"><view class="ai-stop-square ai-v"></view></button><button wx:else class="ai-send ai-btn {{(!canSend || testing || choosingImage) ? 'ai-disabled' : ''}}" bindtap="submit" disabled="{{!canSend || testing || choosingImage}}" hover-class="ai-pressed" aria-label="发送问题及选中的家庭资料"><image class="ai-img" src="/assets/ai-send.svg" mode="aspectFit" /></button></view>
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{screen === 'history'}}">
    <view class="ai-history-tools ai-v"><view class="ai-history-search ai-v"><image class="ai-img" src="/assets/ai-icons/history.svg" mode="aspectFit" /><input class="ai-in" value="{{historyQuery}}" bindinput="searchHistory" placeholder="找一段聊过的话…" aria-label="搜索会话标题和最近消息" confirm-type="search" maxlength="100" /><button class="ai-btn" wx:if="{{historyQuery}}" bindtap="clearHistorySearch" aria-label="清空会话搜索">×</button></view><text class="ai-list-count ai-t">{{visibleSessions.length}} 段对话{{historyQuery ? ' · 搜索结果' : ' · 当前会话已标记'}}</text></view>
    <scroll-view class="ai-subscroll ai-scroll" scroll-y>
      <view class="ai-page-column ai-v">
        <view wx:if="{{!visibleSessions.length}}" class="ai-empty ai-v"><view class="ai-empty-symbol ai-v"><image class="ai-img" src="/assets/ai-icons/chats.svg" mode="aspectFit" /></view><text class="ai-t">{{historyQuery ? '暂时没找到这段对话' : '信箱还空着'}}</text><text class="ai-t">{{historyQuery ? '试试标题或最近消息里的关键词。' : '开启保留本机历史后，对话就会收进这里。'}}</text><button wx:if="{{historyQuery}}" class="ai-text-action ai-btn" bindtap="clearHistorySearch">查看全部对话</button></view>
        <view wx:for="{{visibleSessions}}" wx:key="id" class="ai-history-row {{item.current ? 'ai-history-current' : ''}} ai-v"><button class="ai-history-open ai-btn" data-id="{{item.id}}" bindtap="openSession" hover-class="ai-pressed" aria-label="打开对话{{item.title}}"><view class="ai-history-title-line ai-v"><text class="ai-t">{{item.title}}</text><text wx:if="{{item.current}}" class="ai-current-tag ai-t">正在聊</text></view><text class="ai-history-snippet ai-t">{{item.snippet}}</text><text class="ai-history-when ai-t">{{item.when}} · {{item.messageCount}} 条消息</text></button><button class="ai-history-delete ai-btn" data-id="{{item.id}}" bindtap="deleteSession" aria-label="删除对话{{item.title}}">×</button></view>
      </view>
    </scroll-view>
  </block>

  <block wx:if="{{screen === 'context'}}">
    <scroll-view class="ai-subscroll ai-scroll" scroll-y>
      <view class="ai-page-column ai-context-page ai-v">
        <view class="ai-info-paper ai-preview-destination ai-v"><text class="ai-kicker ai-t">当前配置的服务</text><text class="ai-domain ai-t">{{previewDestination}}</text><text class="ai-help ai-t">这里按当前配置与输入构建，真正发送时会重新读取。{{previewVision ? '本次还包含你主动选择的一张图片。' : '照片仅提供元信息，不代表模型看过原图。'}}</text><view class="ai-preview-summary ai-v"><view class="ai-v"><text class="ai-t">{{previewChars}}</text><text class="ai-t">字符家庭资料</text></view><view class="ai-v"><text class="ai-t">{{previewHistory.length}}</text><text class="ai-t">条会话文字</text></view></view></view>
        <view class="ai-setting-card ai-v"><button class="ai-disclosure ai-btn" data-field="previewHistoryOpen" bindtap="togglePreview" aria-expanded="{{previewHistoryOpen}}"><view class="ai-v"><text class="ai-t">一起带上的会话文字</text><text class="ai-disclosure-note ai-t">{{previewHistoryNote}}</text></view><text class="ai-t">{{previewHistoryOpen ? '−' : '＋'}}</text></button><view wx:if="{{previewHistoryOpen}}" class="ai-expanded ai-v"><view wx:for="{{previewHistory}}" wx:key="id" class="ai-history-excerpt ai-v"><text class="ai-history-speaker ai-t">{{item.role === 'user' ? '我' : '豆伴'}}</text><text class="ai-t" selectable>{{item.content}}</text></view></view></view>
        <view class="ai-setting-card ai-v"><button class="ai-disclosure ai-btn" data-field="previewDataOpen" bindtap="togglePreview" aria-expanded="{{previewDataOpen}}"><view class="ai-v"><text class="ai-t">本轮家庭资料</text><text class="ai-disclosure-note ai-t">按所选范围与预算构建，展开核对实际内容。</text></view><text class="ai-t">{{previewDataOpen ? '−' : '＋'}}</text></button><view wx:if="{{previewDataOpen}}" class="ai-expanded ai-v"><view class="ai-preview-sources ai-v"><view wx:for="{{previewSources}}" wx:key="id" class="ai-preview-source {{item.included ? 'ai-preview-included' : ''}} ai-v"><text class="ai-t">{{item.included ? '✓' : '○'}} {{item.label}}</text><text class="ai-t">{{item.included}} / {{item.count}} 条纳入</text></view></view><view class="ai-warning ai-v" wx:if="{{previewTruncated}}">资料已按预算节选，下方就是本轮构建的实际文字。</view><text class="ai-context-text ai-t" selectable>{{previewText}}</text></view></view>
        <text class="ai-page-foot ai-t">本页不会连接 API。密钥不会出现在资料正文或对话历史中。</text>
      </view>
    </scroll-view>
  </block>

  <block wx:if="{{screen === 'settings'}}">
    <scroll-view class="ai-subscroll ai-scroll" scroll-y>
      <view class="ai-page-column ai-settings-page ai-v">
        <view class="ai-settings-intro ai-v"><view class="ai-settings-intro-icon ai-v"><image class="ai-img" src="/assets/ai-icons/gear.svg" mode="aspectFit" /></view><view class="ai-v"><text class="ai-t">让豆伴用你熟悉的模型</text><text class="ai-t">配置留在本机，家庭资料由你选择。</text></view></view>
        <view class="ai-setting-card ai-v">
          <view class="ai-section-row ai-v"><text class="ai-section-title ai-t">连接 AI 服务</text><text class="ai-status-tag ai-t">{{hasSecret ? '已配置密钥' : '待配置'}}</text></view>
          <view class="ai-modes ai-v"><button class="ai-mode {{form.mode === 'direct' ? 'ai-selected' : ''}} ai-btn" data-mode="direct" bindtap="changeMode" aria-pressed="{{form.mode === 'direct'}}">直连 / 兼容 API</button><button class="ai-mode {{form.mode === 'relay' ? 'ai-selected' : ''}} ai-btn" data-mode="relay" bindtap="changeMode" aria-pressed="{{form.mode === 'relay'}}">自有中转</button></view>
          <view class="ai-field ai-v"><text class="ai-t">服务地址</text><input class="ai-input ai-in" value="{{form.baseUrl}}" data-field="baseUrl" bindinput="formInput" maxlength="300" placeholder="https://api.deepseek.com" aria-label="API服务基础地址" /><text class="ai-help ai-t">{{form.mode === 'relay' ? '中转地址填写到 /v1；访问令牌只发给该域名。' : 'DeepSeek 默认地址如上，也支持其他兼容服务。'}}</text></view>
          <view class="ai-field ai-v"><text class="ai-t">模型名称</text><input class="ai-input ai-in" value="{{form.model}}" data-field="model" bindinput="formInput" maxlength="120" placeholder="按服务商文档填写模型 ID" aria-label="模型名称" /></view>
          <view class="ai-field ai-v"><text class="ai-t">{{form.mode === 'relay' ? '访问令牌' : 'API 密钥'}}<text class="ai-field-hint ai-t">{{hasSecret ? '留空沿用' : '尚未配置'}}</text></text><view class="ai-secret-row ai-v"><input class="ai-input ai-in" value="{{secretInput}}" password="{{!showSecret}}" bindinput="secretInput" maxlength="1000" placeholder="{{hasSecret ? '需要更新时再输入' : '输入你自己的密钥'}}" aria-label="{{form.mode === 'relay' ? '中转访问令牌' : 'API密钥'}}" /><button class="ai-secret-toggle ai-btn" bindtap="showSecret" aria-label="{{showSecret ? '隐藏密钥' : '显示密钥'}}">{{showSecret ? '隐藏' : '显示'}}</button></view></view>
          <view class="ai-switch-row ai-v"><view class="ai-v"><text class="ai-t">记住密钥</text><text class="ai-t">保存在当前设备，可被本机访问；默认仅本次运行有效。</text></view><switch class="ai-switch" checked="{{form.rememberKey}}" color="#98718a" data-field="rememberKey" bindchange="formSwitch" aria-label="记住密钥到本机存储" /></view>
          <view class="ai-key-actions ai-v"><button class="ai-text-action ai-danger-text ai-btn" bindtap="clearSecret">清除密钥</button><button class="ai-test-button ai-btn {{(testing) ? 'ai-disabled' : ''}}" bindtap="testConnection" disabled="{{testing}}">{{testing ? '正在测试…' : '测试连接'}}</button><button wx:if="{{testing}}" class="ai-text-action ai-btn" bindtap="stop">停止测试</button></view>
          <text class="ai-help ai-connection-note ai-t">测试与发送会请求 API，可能产生服务商费用。微信真机还需配置合法 request 域名。</text>
        </view>
        <view class="ai-setting-card ai-v"><button class="ai-disclosure ai-btn" bindtap="toggleScopes" aria-expanded="{{scopesOpen}}"><view class="ai-v"><text class="ai-t">可参考的家庭资料<text class="ai-count-tag ai-t">{{formScopeCount}} 类</text></text><text class="ai-disclosure-note ai-t">只发送勾选范围；草稿、电话默认不包含。</text></view><text class="ai-t">{{scopesOpen ? '−' : '＋'}}</text></button><view wx:if="{{scopesOpen}}" class="ai-expanded ai-v"><view class="ai-scope-grid ai-v"><button wx:for="{{scopeRows}}" wx:key="id" class="ai-scope {{item.selected ? 'ai-selected' : ''}} ai-btn" data-id="{{item.id}}" bindtap="toggleScope" aria-role="checkbox" aria-checked="{{item.selected}}" aria-label="{{item.label}}"><text class="ai-checkbox ai-t">{{item.selected ? '✓' : ''}}</text><text class="ai-t">{{item.label}}</text></button></view><view class="ai-switch-row ai-v"><view class="ai-v"><text class="ai-t">包含联系方式</text><text class="ai-t">默认排除家人和医院电话。</text></view><switch class="ai-switch" checked="{{form.includeContacts}}" color="#98718a" data-field="includeContacts" bindchange="formSwitch" aria-label="发送联系人电话号码" /></view><view class="ai-switch-row ai-v"><view class="ai-v"><text class="ai-t">启用主动附图</text><text class="ai-t">模型需支持图片输入；每次主动选图，不存入历史。</text></view><switch class="ai-switch" checked="{{form.visionEnabled}}" color="#98718a" data-field="visionEnabled" bindchange="formSwitch" aria-label="模型支持图片输入，允许手动附图" /></view></view><button class="ai-preview-link ai-btn" bindtap="previewContext">查看本次发送预览 <text class="ai-t">↗</text></button></view>
        <view class="ai-setting-card ai-v"><button class="ai-disclosure ai-btn" bindtap="toggleAdvanced" aria-expanded="{{advancedOpen}}"><view class="ai-v"><text class="ai-t">回答与历史偏好</text><text class="ai-disclosure-note ai-t">本机历史、输出长度与额外提示词。</text></view><text class="ai-t">{{advancedOpen ? '−' : '＋'}}</text></button><view wx:if="{{advancedOpen}}" class="ai-expanded ai-v"><view class="ai-switch-row ai-v"><view class="ai-v"><text class="ai-t">保留本机历史</text><text class="ai-t">关闭后不保存新聊天，已有历史可逐条删除。</text></view><switch class="ai-switch" checked="{{form.keepHistory}}" color="#98718a" data-field="keepHistory" bindchange="formSwitch" aria-label="保存对话到本机历史" /></view><view class="ai-form-grid ai-v"><view class="ai-field ai-v"><text class="ai-t">最大输出 tokens</text><input class="ai-input ai-in" type="number" value="{{form.maxTokens}}" data-field="maxTokens" bindinput="formInput" aria-label="模型最大输出token数量" /><text class="ai-help ai-t">{{form.mode === 'relay' ? '中转至少 512' : '直连至少 128'}}</text></view><view class="ai-field ai-v"><text class="ai-t">温度</text><input class="ai-input ai-in" type="digit" value="{{form.temperature}}" data-field="temperature" bindinput="formInput" aria-label="模型温度" /></view></view><view class="ai-field ai-v"><text class="ai-t">家庭资料预算（字符）</text><input class="ai-input ai-in" type="number" value="{{form.maxContextChars}}" data-field="maxContextChars" bindinput="formInput" placeholder="18000" aria-label="家庭资料字符预算，8000到28000" /><text class="ai-help ai-t">8000 精简 · 18000 均衡 · 28000 更全面。</text></view><view class="ai-field ai-v"><text class="ai-t">额外回答偏好（可选）</text><textarea class="ai-input ai-system-input ai-ta" value="{{form.systemPrompt}}" data-field="systemPrompt" bindinput="formInput" maxlength="4000" placeholder="例如：用简短中文回答，先列出需要我处理的事。" aria-label="额外系统提示偏好" /></view></view></view>
        <text class="ai-page-foot ai-t">尚未点发送或测试时，不会连接 API。</text>
      </view>
    </scroll-view>
    <view class="ai-settings-footer ai-v"><button class="ai-button ai-button-pink ai-save ai-btn {{(testing) ? 'ai-disabled' : ''}}" bindtap="saveSettings" disabled="{{testing}}">保存设置，回到对话 <text class="ai-t" aria-hidden="true">↗</text></button></view>
  </block>
</view>
