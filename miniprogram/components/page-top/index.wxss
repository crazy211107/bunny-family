.top-space{position:relative;display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:0 30rpx 0 34rpx}
.top-brand{display:flex;align-items:center;gap:16rpx;flex:1;min-width:0;padding:12rpx 0}
.top-brand bunny-mark{flex:0 0 auto;width:62rpx;height:74rpx;transform:scale(.78);transform-origin:left center}
.brand-text{min-width:0}
.brand-name{display:block;font-size:32rpx;font-weight:600;letter-spacing:2rpx;color:#6b5b73;line-height:1.35}
.brand-caption{display:block;font-size:17rpx;color:#a88f9f;letter-spacing:1rpx;margin-top:5rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.directory{flex:0 0 auto;display:flex;align-items:center;gap:8rpx;height:64rpx;padding:0 24rpx;background:#fffdf6;border:1rpx solid #dcc7d2;border-radius:31rpx 36rpx 29rpx 34rpx;box-shadow:0 3rpx 0 #6b5b7312}
.directory-hover{transform:scale(.95);background:#ffd9e8;border-color:#cf9db2}
.directory-icon{font-size:24rpx;color:#a18598;line-height:1}
.directory-label{font-size:23rpx;color:#7d6478;letter-spacing:1rpx}
.directory-spark{font-size:18rpx;color:#d7b965;line-height:1;margin-left:2rpx;margin-top:-10rpx}

.top-space{gap:10rpx;padding-left:26rpx;padding-right:26rpx;padding-bottom:12rpx}
.top-back{width:76rpx;min-height:88rpx;flex:0 0 auto;display:flex;align-items:center;justify-content:center;font-size:42rpx;color:#6b5b73;border-radius:22rpx}
.top-brand{gap:10rpx;min-height:96rpx}
.brand-caption{font-size:20rpx;color:#806c7b;letter-spacing:0}
.directory{min-height:88rpx;height:auto;padding:0 20rpx;border-radius:26rpx 32rpx 24rpx 30rpx}
@media(max-width:350px){.top-brand bunny-mark{display:none}.brand-name{font-size:30rpx}.brand-caption{font-size:20rpx}.top-back{width:60rpx}.directory{padding:0 16rpx}.directory-label{font-size:24rpx}}
