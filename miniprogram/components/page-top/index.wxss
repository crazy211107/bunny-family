
.native-safe-top{position:fixed;top:0;left:0;right:0;z-index:80;background:#fff9f0;pointer-events:none}
.top-space{position:relative;display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:0 30rpx 12rpx}
.top-back{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:44px;min-width:44px;height:44px;min-height:44px;margin:0 0 0 -12rpx;padding:0;background:transparent;border:0;color:#6b5b73;font-size:31px;line-height:1;border-radius:14rpx}
.top-back::after,.directory::after{border:0}.top-brand{display:flex;align-items:center;gap:9rpx;flex:1;min-width:0;min-height:44px;padding:8rpx 0}.top-brand bunny-mark{width:48rpx;height:66rpx;flex-shrink:0;transform:scale(.62);transform-origin:left center}.brand-text{min-width:0}.brand-name{display:block;font-family:var(--font-display,YouYuan,KaiTi,serif);font-size:16px;font-weight:600;line-height:1.4;letter-spacing:1px;color:#6b5b73}.brand-caption{display:block;font-size:10px;line-height:1.5;margin-top:3rpx;color:#806c7b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.directory{display:flex;align-items:center;justify-content:center;gap:7rpx;flex-shrink:0;min-height:44px;margin:0;padding:0 17rpx;border:1rpx solid #e2d1da;border-radius:16rpx 21rpx 16rpx 19rpx;background:#fffdf8;color:#875873;font-size:12px;line-height:1.4}.directory-spark{font-size:17px;color:#a87b38}.directory-hover{background:#ffe8f0}.directory-label{font-size:12px}.directory:focus,.top-back:focus{outline:2px solid #875873;outline-offset:3px}
@media(max-width:350px){.top-space{padding-left:24rpx;padding-right:24rpx;gap:7rpx}.brand-caption{display:none}.top-brand bunny-mark{width:43rpx}.directory{padding:0 14rpx}.directory-spark{display:none}}
@media(min-width:600px){.top-space{max-width:960px;margin:0 auto;padding-left:24px;padding-right:24px}.top-brand bunny-mark{width:32px;height:40px;transform:scale(.5)}.directory{padding:0 15px}}
