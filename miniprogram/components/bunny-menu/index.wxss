.dock{position:fixed;left:50%;bottom:calc(14rpx + env(safe-area-inset-bottom));transform:translateX(-50%);z-index:40;width:220rpx;text-align:center}.fab{position:relative;display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:104rpx;height:104rpx;border-radius:50%;border:5rpx solid #fff9f0;background:linear-gradient(145deg,#ffe4ed,#f3a9ca);box-shadow:0 0 0 2rpx #d49db3,0 8rpx 0 #d59daf33,0 12rpx 26rpx #6b5b731f;margin:0 auto;overflow:visible}
.fab-hover{transform:scale(.95)}.fab::after{content:'';position:absolute;inset:10rpx;border:1rpx solid #fff9f0cc;border-radius:50%;pointer-events:none}.fab-ear{position:absolute;top:-25rpx;width:25rpx;height:53rpx;background:#f7c2d8;border:4rpx solid #fff9f0;border-bottom:0;border-radius:50%;z-index:-1}.e-one{left:31rpx;transform:rotate(-17deg)}.e-two{right:31rpx;transform:rotate(17deg)}.fab bunny-mark{transform:scale(.84)}.cross{font-size:65rpx;color:#865e7c;line-height:90rpx}.dock-caption{display:inline-block;font-size:20rpx;background:#fff9f0ee;color:#a18598;padding:6rpx 14rpx;border-radius:16rpx;margin-top:12rpx}.fan-mask{position:fixed;inset:0;z-index:39;background:#fff9f0a8}.fan{position:absolute;left:50%;bottom:60rpx;width:0;height:0}.action{position:absolute;left:-62rpx;bottom:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:7rpx;width:124rpx;height:124rpx;font-size:40rpx;border:1rpx solid #b7a0af;border-radius:42rpx 51rpx 35rpx 47rpx;opacity:0;transform:scale(.1);pointer-events:none;transition:transform .35s cubic-bezier(.34,1.56,.64,1),opacity .2s;padding:10rpx;line-height:1.3;color:#6b5b73}.action::after{border:0}.action-icon{font-size:40rpx;line-height:1}
.action-label{font-size:21rpx;line-height:1.25;letter-spacing:1rpx}
.action-hover{opacity:.86}.a-photo{background:#c9e7d3}.a-video{background:#ffe9a8}.a-note{background:#ffd9e8}.a-summon{background:#e8ddee}.expanded .action{opacity:1;pointer-events:auto}.expanded .a-photo{transform:translate(-225rpx,-110rpx)}.expanded .a-video{transform:translate(-92rpx,-265rpx)}.expanded .a-note{transform:translate(92rpx,-265rpx)}.expanded .a-summon{transform:translate(225rpx,-110rpx)}.directory-mask{position:fixed;inset:0;z-index:100;background:#fff9f0}.directory-sheet{height:100%;padding:55rpx 35rpx 80rpx;box-sizing:border-box}.directory-top{display:flex;justify-content:space-between;gap:10rpx;align-items:center}.directory-caption{display:block;font-size:21rpx;color:#b398a8;margin-bottom:15rpx}.directory-title{display:block;font-size:39rpx;line-height:1.7;color:#6b5b73}.directory-close{display:flex;align-items:center;justify-content:center;background:#ffe6ef;width:68rpx;height:68rpx;border-radius:50%;margin:0;font-size:40rpx;line-height:1;color:#6b5b73;flex-shrink:0}.directory-close::after{border:0}.chapters{display:grid;grid-template-columns:1fr 1fr;gap:45rpx 29rpx;padding:60rpx 10rpx 50rpx}.chapter{position:relative;min-width:0;border:1rpx solid #d6c1cd;background:#fffbf3;padding:20rpx 17rpx 25rpx;border-radius:12rpx 20rpx 11rpx 17rpx;transform:rotate(-3deg);box-shadow:5rpx 9rpx 0 #6b5b730c}.chapter:nth-child(even){transform:rotate(3deg);margin-top:30rpx}.chapter-1{background:#eaf2e4}.chapter-2{background:#fff0d1}.chapter image{width:100%;height:215rpx;border-radius:5rpx;margin:17rpx 0 20rpx}.chapter-no{font-size:14rpx;letter-spacing:3rpx;color:#b28d9f}.chapter-title{display:block;font-size:34rpx;color:#6b5b73}.chapter-caption{display:block;font-size:19rpx;color:#a88a9d;line-height:1.9;margin-top:10rpx}.tape{position:absolute;top:-17rpx;left:33%;width:105rpx;height:31rpx;background:#f9c8d9af;transform:rotate(-5deg)}.directory-end{display:block;text-align:center;font-size:24rpx;color:#ad8f9e;padding-bottom:60rpx}.burst{position:fixed;inset:0;pointer-events:none;z-index:110}.burst>view,.burst>text{position:absolute;left:50%;bottom:10%;font-size:75rpx;color:#d78eaf;animation:fly 1.7s ease-out both}.burst-one{--dx:-240rpx;--rot:-35deg}.burst-two{--dx:230rpx;--rot:32deg;animation-delay:.08s!important}.burst-three{--dx:-50rpx;--rot:18deg;animation-delay:.17s!important}.burst-four{--dx:110rpx;--rot:-22deg;animation-delay:.25s!important}@keyframes fly{0%{opacity:0;transform:translate(0,0) scale(.4)}15%{opacity:1}100%{opacity:0;transform:translate(var(--dx),-900rpx) rotate(var(--rot))}}@media(prefers-reduced-motion:reduce){.action{transition:none}.burst{display:none}}

.dock-caption{font-size:19rpx;padding:5rpx 12rpx}

/* 扇形展开错峰：先出手臂，再出远端，收拢时不延迟 */
.expanded .a-photo{transition-delay:.02s}
.expanded .a-video{transition-delay:.06s}
.expanded .a-note{transition-delay:.1s}
.expanded .a-summon{transition-delay:.14s}
.fan-mask{animation:mask-in .24s ease both}
@keyframes mask-in{from{opacity:0}to{opacity:1}}

.sheet-grab{width:72rpx;height:8rpx;margin:0 auto 20rpx;border-radius:4rpx;background:rgba(180,154,134,.45)}
.directory-top{border-radius:20rpx}

.directory-close{width:88rpx;height:88rpx;min-height:88rpx}
.directory-title{font-size:35rpx;line-height:1.5}
.directory-caption{font-size:22rpx;color:#806c7b;margin-bottom:8rpx}
.chapters{gap:34rpx 22rpx;padding:38rpx 5rpx 28rpx}
.chapter{padding:16rpx 15rpx 20rpx;transform:rotate(-1.8deg)}
.chapter:nth-child(even){transform:rotate(1.8deg);margin-top:18rpx}
.chapter image{height:178rpx;margin:12rpx 0 14rpx}
.chapter-title{font-size:29rpx}
.chapter-caption{font-size:22rpx;color:#806c7b;line-height:1.6}
.chapter-no{font-size:19rpx;color:#87657d;letter-spacing:1rpx}
.chapter-current{border:2rpx solid #99718c;box-shadow:0 0 0 5rpx #ffd9e866}
.chapter-pressed{opacity:.8}
@media(max-width:350px){.directory-sheet{padding-left:24rpx;padding-right:24rpx}.directory-title{font-size:32rpx}.chapters{gap:30rpx 16rpx}.chapter-title{font-size:28rpx}.chapter image{height:160rpx}}
