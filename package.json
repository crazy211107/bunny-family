{
  "name": "bunny-family-cinema",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-ai-core.mjs && node ./node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5188 --strictPort",
    "build": "node scripts/build-ai-core.mjs && tsc --noEmit && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port 5188 --strictPort",
    "verify:miniprogram": "node scripts/verify-miniprogram-pages.mjs && node scripts/verify-miniprogram.mjs && node scripts/verify-family-features.mjs && node scripts/verify-ai.mjs && node scripts/verify-native-chat-ux.mjs && node scripts/verify-native-style.mjs",
    "verify:ai": "node scripts/verify-ai.mjs && node scripts/verify-native-chat-ux.mjs",
    "verify:chat-ux": "node scripts/verify-native-chat-ux.mjs",
    "verify:chat": "node scripts/build-ai-core.mjs && node scripts/verify-chat.mjs",
    "verify:product": "node scripts/verify-native-style.mjs",
    "verify:ai-relay": "node scripts/verify-ai-relay.mjs",
    "ai:relay": "node --env-file=server/.env server/ai-relay.mjs",
    "verify:native-compile": "node scripts/compile-native.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "0.451.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.25.12",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  }
}
